/-- all roles at global time `τ`. -/
def XNetH.Ffr (τ : ℕ) : BRoleT Γ T nb C nR → CMat α :=
  mkT (fun ρ d => N.LD (progT N.tm ρ τ) ρ τ d) (fun g b => N.Zb τ g b) (cOne Γ C α)

/-- all roles after the adapters of time `τ`. -/
def XNetH.Afr (τ : ℕ) : BRoleT Γ T nb C nR → CMat α :=
  mkT (fun ρ d => N.LDp (progT N.tm ρ τ) ρ τ d) (fun g b => N.Zp τ g b) (cOne Γ C α)

/-- all roles after the stage of call `(ρ, l)` (before its remaining climbs). -/
def XNetH.Bfr (ρ : Fin nR) (l : Fin 9) : BRoleT Γ T nb C nR → CMat α :=
  mkT (fun ρ' d => if ρ' = ρ then N.POST l.val ρ (N.tm ρ l + 1) d else N.LD (progT N.tm ρ' (N.tm ρ l)) ρ' (N.tm ρ l + 1) d)
    (fun g b => N.Zb (N.tm ρ l + 1) g b) (cOne Γ C α)

/-- the final frames (after the padding blocks). -/
def XNetH.Sfin : BRoleT Γ T nb C nR → CMat α := mkT (fun _ d => N.FinD d) (fun _ _ => kernel α) (cOne Γ C α)

/-! ## The global order -/

lemma XNetH.tm_le (ρ : Fin nR) {l l' : Fin 9} (h : l ≤ l') : N.tm ρ l ≤ N.tm ρ l' := by
  rcases h.lt_or_eq with h | h
  · exact (N.htm_mono ρ l l' h).le
  · rw [h]

lemma XNetH.prog_le9 (ρ : Fin nR) (τ : ℕ) : progT N.tm ρ τ ≤ 9 := by
  unfold progT
  exact (card_filter_le _ _).trans (by simp)

lemma XNetH.prog_at (ρ : Fin nR) (l : Fin 9) : progT N.tm ρ (N.tm ρ l) = l.val := by
  unfold progT
  have e : univ.filter (fun l' : Fin 9 => N.tm ρ l' < N.tm ρ l) = Finset.Iio l := by
    ext l'
    simp only [mem_filter, mem_univ, true_and, Finset.mem_Iio]
    constructor
    · intro h
      by_contra hc
      exact absurd (N.tm_le ρ (not_lt.mp hc)) (not_le.mpr h)
    · intro h
      exact N.htm_mono ρ l' l h
  rw [e, Fin.card_Iio]

lemma XNetH.prog_at_succ (ρ : Fin nR) (l : Fin 9) : progT N.tm ρ (N.tm ρ l + 1) = l.val + 1 := by
  unfold progT
  have e : univ.filter (fun l' : Fin 9 => N.tm ρ l' < N.tm ρ l + 1) = Finset.Iic l := by
    ext l'
    simp only [mem_filter, mem_univ, true_and, Finset.mem_Iic]
    constructor
    · intro h
      by_contra hc
      have := N.htm_mono ρ l l' (not_le.mp hc)
      omega
    · intro h
      have := N.tm_le ρ h
      omega
  rw [e, Fin.card_Iic]

lemma XNetH.prog_at' (ρ : Fin nR) (l : Fin 9) (k : ℕ) (hk : l.val = k) : progT N.tm ρ (N.tm ρ l) = k :=
  (N.prog_at ρ l).trans hk

lemma XNetH.prog_at_succ' (ρ : Fin nR) (l : Fin 9) (k : ℕ) (hk : l.val + 1 = k) :
    progT N.tm ρ (N.tm ρ l + 1) = k :=
  (N.prog_at_succ ρ l).trans hk

lemma XNetH.prog_other (ρ : Fin nR) (l : Fin 9) (ρ' : Fin nR) (h : ρ' ≠ ρ) :
    progT N.tm ρ' (N.tm ρ l + 1) = progT N.tm ρ' (N.tm ρ l) := by
  unfold progT
  congr 1
  ext l'
  simp only [mem_filter, mem_univ, true_and]
  have hne : N.tm ρ' l' ≠ N.tm ρ l := fun e => h (N.htm_inj ρ' ρ l' l e).1
  omega

lemma XNetH.prog_zero (ρ : Fin nR) : progT N.tm ρ 0 = 0 := by
  unfold progT
  simp

lemma XNetH.prog_end (ρ : Fin nR) : progT N.tm ρ (9 * nR) = 9 := by
  unfold progT
  have e : univ.filter (fun l' : Fin 9 => N.tm ρ l' < 9 * nR) = univ := by
    ext l'
    simp [N.htm_lt ρ l']
  rw [e]
  simp

/-- the call at the time of call `(ρ, l)` is `(ρ, l)`. -/
lemma XNetH.cl_tm (ρ : Fin nR) (l : Fin 9) : N.cl ⟨N.tm ρ l, N.htm_lt ρ l⟩ = (ρ, l) := by
  have e := N.hcl ⟨N.tm ρ l, N.htm_lt ρ l⟩
  obtain ⟨h1, h2⟩ := N.htm_inj _ _ _ _ e
  exact Prod.ext h1 h2

lemma XNetH.cl_bij : Function.Bijective N.cl := by
  have hinj : Function.Injective N.cl := by
    intro a b h
    apply Fin.ext
    rw [← N.hcl a, ← N.hcl b, h]
  refine (Fintype.bijective_iff_injective_and_card N.cl).mpr ⟨hinj, ?_⟩
  simp [mul_comm]

/-- the conditions of the role map of call `(ρ, l)` (TRoles' `HostOKT`), from the windows. -/
lemma XNetH.hokT (ρ : Fin nR) (l : Fin 9) : HostOKT ρ (pairL l.val) (N.hostAt ρ l) (N.bk ρ l) := by
  refine ⟨N.hinj ρ l, N.hostInj ρ l, fun q c j h => ?_, fun q q' ρh c c' j j' h h' e => ?_⟩
  · have hw := N.hostWin ρ l q ρ c j h
    rw [N.prog_at] at hw
    exact win_pair c l hw
  · have hw := N.hostWin ρ l q ρh c j h
    have hw' := N.hostWin ρ l q' ρh c' j' h'
    have hk : progT N.tm ρh (N.tm ρ l) < 9 := by
      rcases Nat.lt_or_ge (progT N.tm ρh (N.tm ρ l)) 9 with h9 | h9
      · exact h9
      · have : progT N.tm ρh (N.tm ρ l) = 9 := le_antisymm (N.prog_le9 _ _) h9
        rw [this] at hw
        exact absurd hw (by fin_cases c <;> decide)
    exact win_uniq c c' ⟨_, hk⟩ hw hw' e

