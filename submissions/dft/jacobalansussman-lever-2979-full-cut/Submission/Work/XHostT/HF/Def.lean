section Net
variable {H T Sl C α Γ : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C] [Fintype α] [DecidableEq α]
  [Fintype Γ] [DecidableEq Γ]
variable {nb nR : ℕ} (N : XNetH H T Sl C α Γ nb nR)

/-- the invocation of call `(ρ, l)` with the target vectors of `I` DEFINITIONALLY (lg-a2a4's `retagTv`). -/
def XNetH.Jc (ρ : Fin nR) (l : Fin 9) : GInvE H T Sl C := XHostD.retagTv (N.Ic ρ l) N.I.tv (N.hIc ρ l)

/-- price of the remaining climbs of the host chains of kind `c` of replica `ρ` (both sides, all classes). -/
def XNetH.hcost (ρ : Fin nR) (c : Fin 9) (φ : ℕ → ℝ) : ℝ :=
  ∑ t : T, (bcost φ (N.hrem ρ c (false, t)) + bcost φ (N.hrem ρ c (true, t)))

/-- price of the tail of call `(ρ, l)` per element of `Γ`: the remaining climbs ending there (and pair 4's final). -/
def XNetH.tailU (ρ : Fin nR) (l : Fin 9) (φ : ℕ → ℝ) : ℝ :=
  match l.val with
  | 1 => N.hcost ρ 0 φ
  | 2 => N.hcost ρ 1 φ
  | 3 => N.hcost ρ 2 φ
  | 4 => N.hcost ρ 3 φ
  | 5 => N.hcost ρ 4 φ
  | 6 => N.hcost ρ 5 φ
  | 8 => N.hcost ρ 6 φ + N.hcost ρ 7 φ + N.hcost ρ 8 φ + (Fintype.card T : ℝ) * (N.cX4 φ + N.cY4 φ)
  | _ => 0

lemma XNetH.tailU_eq0 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (0 : Fin 9) φ = 0 := rfl
lemma XNetH.tailU_eq1 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (1 : Fin 9) φ = N.hcost ρ 0 φ := rfl
lemma XNetH.tailU_eq2 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (2 : Fin 9) φ = N.hcost ρ 1 φ := rfl
lemma XNetH.tailU_eq3 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (3 : Fin 9) φ = N.hcost ρ 2 φ := rfl
lemma XNetH.tailU_eq4 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (4 : Fin 9) φ = N.hcost ρ 3 φ := rfl
lemma XNetH.tailU_eq5 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (5 : Fin 9) φ = N.hcost ρ 4 φ := rfl
lemma XNetH.tailU_eq6 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (6 : Fin 9) φ = N.hcost ρ 5 φ := rfl
lemma XNetH.tailU_eq7 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (7 : Fin 9) φ = 0 := rfl
lemma XNetH.tailU_eq8 (ρ : Fin nR) (φ : ℕ → ℝ) : N.tailU ρ (8 : Fin 9) φ = N.hcost ρ 6 φ + N.hcost ρ 7 φ + N.hcost ρ 8 φ + (Fintype.card T : ℝ) * (N.cX4 φ + N.cY4 φ) := rfl

/-- price of call `(ρ, l)` per element of `Γ`. -/
def XNetH.callU (ρ : Fin nR) (l : Fin 9) (φ : ℕ → ℝ) : ℝ := (N.Ic ρ l).cost φ + N.tailU ρ l φ

/-- price of one unit (one element of `Γ`): all calls of all replicas, and the padding blocks. -/
def XNetH.unit (φ : ℕ → ℝ) : ℝ := (∑ ρ : Fin nR, ∑ l : Fin 9, N.callU ρ l φ) + ∑ b, bcost φ (N.pad b)

