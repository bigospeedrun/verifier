/-- a data role in an idle window is on its host chain (`LD`). -/
lemma XNetH.LD_win (ρ : Fin nR) (τ k : ℕ) (c : Fin 9) (hw : inWin c.val k = true) (s : Bool) (g : Γ) (t : T) :
    N.LD k ρ τ (dD (pairOf c) s (g, t)) = N.Hb ρ c τ g (s, t) := by
  have hk : k < 9 := inWin_lt c k hw
  interval_cases k <;> fin_cases c <;> cases s <;> first | rfl | exact absurd hw (by decide)

lemma XNetH.LDp_win (ρ : Fin nR) (τ k : ℕ) (c : Fin 9) (hw : inWin c.val k = true) (s : Bool) (g : Γ) (t : T) :
    N.LDp k ρ τ (dD (pairOf c) s (g, t)) = N.Hp ρ c τ g (s, t) := by
  have hk : k < 9 := inWin_lt c k hw
  interval_cases k <;> fin_cases c <;> cases s <;> first | rfl | exact absurd hw (by decide)

lemma XNetH.POST_win (ρ : Fin nR) (τ k : ℕ) (c : Fin 9) (hw : inWin c.val k = true) (s : Bool) (g : Γ) (t : T) :
    N.POST k ρ τ (dD (pairOf c) s (g, t)) = N.Hb ρ c τ g (s, t) := by
  have hk : k < 9 := inWin_lt c k hw
  interval_cases k <;> fin_cases c <;> cases s <;> first | rfl | exact absurd hw (by decide)

