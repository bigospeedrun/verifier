/-- **the free adapters of time `τ`** on all roles: every host chain `Hb → Hp`, every bank `Zb → Zp`. -/
lemma XNet.adaptT (τ : ℕ) : GRoute (N.Ffr τ) (N.Afr τ) id (fun _ => 0) := by
  have H1 := GRoute.reach_all (N.Ffr τ) (N.Afr τ) (fun _ _ => 0) (by
    rintro ((⟨ρ', d⟩|⟨g,b⟩)|⟨g,c⟩)
    · show GReach (N.LD (progT N.tm ρ' τ) ρ' τ d) (N.LDp (progT N.tm ρ' τ) ρ' τ d) (fun _ => 0)
      rcases N.kindL ρ' _ (N.prog_le9 ρ' τ) d with hf | ⟨c, s, g, t, hw, hd, h1, h2⟩
      · rw [(hf τ τ).1]
        exact GReach.refl _
      · rw [h1, h2]
        exact N.hHP ρ' c τ g (s, t)
    · exact N.hP τ g b
    · exact GReach.refl _)
  exact H1.cast (fun φ => by simp)

/-- stage 0 of replica `ρ` (pair 1), its slots on banks or on idle data roles of ANY replica. -/
lemma XNet.stage0 (ρ : Fin nR) :
    GRoute (N.Afr (N.tm ρ (0 : Fin 9))) (N.Bfr ρ (0 : Fin 9)) (scF ρ 1)
      (fun φ => (Fintype.card Γ : ℝ) * (N.Ic ρ (0 : Fin 9)).cost φ) := by
