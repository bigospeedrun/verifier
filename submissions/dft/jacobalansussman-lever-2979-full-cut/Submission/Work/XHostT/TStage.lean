/-- the run-local scalar map of a call at stage `l` (stage, then gate layers): Shea's `chainQ`, bank-free, cut at the
calls. -/
def runMap {Γ T C : Type} {nb : ℕ} (l : Fin 9) : (BRun4 Γ T nb C → ℂ) → (BRun4 Γ T nb C → ℂ) :=
  match l.val with
  | 0 => id ∘ sfR 1
  | 1 => (gscQ pABQ_2 kAQ_2 ∘ id) ∘ sbR 1
  | 2 => (gscQ pABQ_2 kBQ_2 ∘ id) ∘ sfR 1
  | 3 => (gscQ pABQ_3 kAQ_3 ∘ id) ∘ sbR 2
  | 4 => (gscQ pABQ_3 kBQ_3 ∘ id) ∘ sfR 2
  | 5 => (gscQ pABQ_4 kAQ_4 ∘ id) ∘ sbR 3
  | 6 => (gscQ pABQ_4 kBQ_4 ∘ id) ∘ sfR 3
  | 7 => id ∘ sbR 4
  | _ => (gscQ pCQ_2 kCQ_2 ∘ (gscQ pCQ_3 kCQ_3 ∘ (gscQ pCQ_4 kCQ_4 ∘ id))) ∘ sfR 4

