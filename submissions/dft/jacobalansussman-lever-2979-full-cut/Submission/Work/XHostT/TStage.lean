        = mkS N.xi1 N.yi1 (fun g q => N.Bfr ρ (0 : Fin 9) (slotT (N.hostAt ρ (0 : Fin 9)) (N.bk ρ (0 : Fin 9)) g q)) (cOne Γ C α) := by
