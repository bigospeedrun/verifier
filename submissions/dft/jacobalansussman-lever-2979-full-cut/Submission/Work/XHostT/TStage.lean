/-- **the route of every call** `(ρ, l)`: `Ffr (tm ρ l) → Ffr (tm ρ l + 1)`. -/
theorem XNet.call (ρ : Fin nR) (l : Fin 9) :
    GRoute (N.Ffr (N.tm ρ l)) (N.Ffr (N.tm ρ l + 1)) (liftRunT ρ (runMap l))
      (fun φ => (Fintype.card Γ : ℝ) * N.callU ρ l φ) := by
  fin_cases l
  · exact N.call0 ρ
  · exact N.call1 ρ
  · exact N.call2 ρ
  · exact N.call3 ρ
  · exact N.call4 ρ
  · exact N.call5 ρ
  · exact N.call6 ρ
  · exact N.call7 ρ
  · exact N.call8 ρ

end Net
end
