    intro g q
    rcases slotT_cases (C := C) (N.hostAt ρ (0 : Fin 9)) (N.bk ρ (0 : Fin 9)) g q with ⟨hq, e⟩ | ⟨ρh, c, s, t, hq, e⟩
    · rw [e]
      exact N.hZ0 ρ g q hq
    · rw [e]
      have hw := N.hostWin ρ (0 : Fin 9) q ρh c (s, t) hq
      show N.Wn0 ρ g q * N.LDp (progT N.tm ρh (N.tm ρ (0 : Fin 9))) ρh (N.tm ρ (0 : Fin 9)) (dD (pairOf c) s (g, t)) =
        (if ρh = ρ then N.POST 0 ρ (N.tm ρ (0 : Fin 9) + 1) (dD (pairOf c) s (g, t))
         else N.LD (progT N.tm ρh (N.tm ρ (0 : Fin 9))) ρh (N.tm ρ (0 : Fin 9) + 1) (dD (pairOf c) s (g, t)))
      rw [N.LDp_win ρh _ _ c hw]
      by_cases hρ : ρh = ρ
      · rw [if_pos hρ]
        rw [hρ] at hq hw ⊢
        rw [hpr] at hw
        rw [N.POST_win ρ _ 0 c hw]
        exact N.hHZ0 ρ g q ρ c (s, t) hq
      · rw [if_neg hρ, N.LD_win ρh _ _ c hw]
        exact N.hHZ0 ρ g q ρh c (s, t) hq
  have h := gistageE_fwd (N.Jc ρ (0 : Fin 9)) (bid Γ T) N.G0 (N.N0 ρ) (N.Wn0 ρ) (N.hN0 ρ) (N.hW0 ρ)
    (fun g q => N.Afr (N.tm ρ (0 : Fin 9)) (slotT (N.hostAt ρ (0 : Fin 9)) (N.bk ρ (0 : Fin 9)) g q)) (cOne Γ C α) (cOne Γ C α)
