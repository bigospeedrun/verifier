    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL2979Fc (k i)) :=
  SeamL2979Fc.engine_L2979Fc cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL2979Fc`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL2979Fc (z : ℝ) (hz : alphaL2979Fc ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
