namespace WeftL2979Fc
variable {j : ι→ℕ}

lemma transfer {n l : κ→ℕ} {f : κ→ℕ→Shard} {x : κ→Line}
    (h : q.WeftL2979Fc cl n l f x) {p} (g : b.Instant q p) :
    b.WeftL2979Fc cl (fun i => n (p i)) (fun i => l (p i)) (fun i => f (p i)) (fun i => x (p i)) :=
