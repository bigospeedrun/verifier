namespace MattingL2979Fc
variable {j : ι→ℕ}

lemma transfer {n l : κ→ℕ} {f : κ→ℕ→Shard} (h : q.MattingL2979Fc n l f) {p}
    (g : b.Instant q p) :
    b.MattingL2979Fc (fun i => n (p i)) (fun i => l (p i)) (fun i => f (p i)) :=
  ⟨h.length.transfer g,fun _ => h.shape _,h.cover.transfer g⟩

lemma kitOf (h : b.MattingL2979Fc n l f) (hj : b.Nick j) (hg : ∀ i,j i<n i) :
    b.Kit fun i => f i (j i) :=
  Kit.grab h.length.small (fun i => (h.shape i).mark _ (hg i))
    (Moves.pick (n:=n) (t:=chipTy) _ h.cover hj.close hg)

/-- pack via linear scatter, along with all sector tags -/
lemma packT (h : b.MattingL2979Fc n l f)
    (hx : b.Moves (fun _ => 0) (a (c cl)) fun i => Tape.tab (n i) (x i)) :
    b.Moves n (a (ragTyL2979Fc cl)) fun i => Tape.tab (n i) (ragL2979Fc (n i) (f i) (x i)) := by
  let Tchip (i : ι) (j : ℕ) : T (ragTyL2979Fc cl) := (chip (f i j),x i j) -- τ?
  have F := Instant.scan b n
  have hh := chop h.length
  have hp := (h.transfer F).kitOf hh During.hj
  have hs : (b.scan n).Moves (fun _ => 0) (c cl) fun i => x i.i i.j :=
    Moves.pick (n:=fun i => n i.i) (t:=c cl) _ (hx.transfer F) hh.close During.hj
  have ht := scatterNow (t:=ragTyL2979Fc cl) h.length
    (fun i j => ((f i j).addr,Tchip i j)) (hp.addr.close.pair (hp.lend.pair hs))
  exact ht.congr (fun i => (h.shape i).reloc.sow (Tchip i) _)

end MattingL2979Fc

variable (cl) in
structure WeftL2979Fc (b : Bench m ι) (n l : ι→ℕ) (f : ι → ℕ→Shard) (x : ι → Line) : Prop where
  mat : b.MattingL2979Fc n l f
