  have hm := Nat.le_mul_of_pos_right (n i) (hillsL2979Fc_pos (l i))
  omega

lemma woven (h : b.WeftL2979Fc cl n l f x) :
    b.Moves (fun i => n i*hillsL2979Fc (l i)) (a (c cl))
      fun i => Tape.tab (n i) fun j =>
        glimpse (n i) (f i) (x i) (f i j).start (f i j).seat := by
