/-- **Kernel program at `alphaL2979Fc = 1 - 1788704501/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L2979Fc (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL2979Fc (k i)) :=
  MX.L2979Fc.EngineStmt.lift MX.L2979Fc.engine cl m k v

