-- rollsL2979Fc at a sector start.
lemma shine (h : b.WeftL2979Fc cl n l f x) (hj : b.Nick j) (hg : ∀ i,j i<n i)
    (hz : ∀ i,(patch (n i) (f i) (j i)).seat=0) :
    b.Moves (fun i => seatfare (n i) (f i) (j i) * hillsL2979Fc (l i)) (a (c cl))
      fun i => rollsL2979Fc (n i) (f i) (x i) (j i) := by
  let B i := patch (n i) (f i) (j i)
  let Q i := (B i).width
