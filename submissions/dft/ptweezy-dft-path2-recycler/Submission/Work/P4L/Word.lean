/-! ### every segment on the view of a port -/

theorem sgV0 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f) (g : (Orth (LC (Fin 8) H l))) (t : T) :
    view f g t ((sg0 (T := T) (Sl := Sl) (C := C) l) f y) = adaptIn (view f g t y) := by
  show view f g t (point f (actPoint (linMat AinM)) y) = _
  rw [view_linMat, lin8_AinM]

theorem sgV1 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f) (g : (Orth (LC (Fin 8) H l))) (t : T) :
    view f g t ((sg1 I base l hH) f y) = callF .x0 .y0 (dF base l f g t 0) (qiF base l f g t) (view f g t y) := by
  exact view_callSeg0 (Sl := Sl) (C := C) (I := I) (base := base) (l := l) (hH := hH) f y g t

theorem sgV2 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f) (g : (Orth (LC (Fin 8) H l))) (t : T) :
    view f g t ((sg2 I base l hH) f y) = callB .x0 .y0 (dF base l f g t 1) (qF base l f g t) (view f g t y) := by
  exact view_callSeg1 (Sl := Sl) (C := C) (I := I) (base := base) (l := l) (hH := hH) f y g t

theorem sgV3 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f) (g : (Orth (LC (Fin 8) H l))) (t : T) :
    view f g t ((sg3 (Sl := Sl) (C := C) base l) f y) = win .x1 .y1 (dF base l f g t 0 * dF base l f g t 1) (view f g t y) := by
  have h := view_winSeg0 (Sl := Sl) (C := C) (base := base) (l := l) f y g t
  rw [prodF_incr l f (BBC (base t) l g) 0 1 (by norm_num), Finset.prod_range_succ, Finset.prod_range_one] at h
  exact h

