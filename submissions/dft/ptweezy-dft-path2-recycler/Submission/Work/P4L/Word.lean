  apply normal_qi f (basisA base l g t) (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4 ∪ incr l 5 ∪ incr l 6 ∪ incr l 7 ∪ incr l 8) (Sum.inl l)
