lemma prodF_S6 (f : ℕ) (A : OBase (LC (Fin 8) H l)) :
    prodF f (fr A (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)) = prodF f (fr A {Sum.inl l}) * prodF f (fr A (incr l 6)) * prodF f (fr A (incr l 7)) * prodF f (fr A (incr l 8)) := by
  have d0 : Disjoint (({Sum.inl l} : Finset (LC (Fin 8) H l))) (incr l 6) :=
    disj_incr l _ 6 (by norm_num) (pivot_sub_setX l 6 (by norm_num))
  have d1 : Disjoint (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6) (incr l 7) :=
    disj_incr l _ 7 (by norm_num) (Finset.union_subset (pivot_sub_setX l 7 (by norm_num)) (incr_sub_setX l 6 7 (by norm_num) (by norm_num)))
  have d2 : Disjoint (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7) (incr l 8) :=
    disj_incr l _ 8 (by norm_num) (Finset.union_subset (Finset.union_subset (pivot_sub_setX l 8 (by norm_num)) (incr_sub_setX l 6 8 (by norm_num) (by norm_num))) (incr_sub_setX l 7 8 (by norm_num) (by norm_num)))
