/-! ### the main roles end at their targets -/

theorem final_x0 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f) (g : (Orth (LC (Fin 8) H l))) (t : T) :
    matAct f (Binary.shift (cvec base l g t .x0)) (opMain I base l hH f y (mainR g .x0 t))
      = matAct f (blockMat ((basisA base l g t).fam (tgtS l .x0))) (y (mainR g .x0 t)) := by
  have hq : qF base l f g t * qiF base l f g t = 1 := q_mul_qi f (basisA base l g t) (Sum.inl l)
  have h := congrArg P4Ctrl.S8.x0
    ((opMain_view (I := I) (base := base) (l := l) (hH := hH) f y g t).trans (ctrl_diag _ _ _ hq _))
  change walsh f (opMain I base l hH f y (mainR g .x0 t)) = (prodF f (fun x => (fr (basisA base l g t) {Sum.inl l} x)⁻¹) * prodF f (fr (basisA base l g t) (incr l 6)) * prodF f (fr (basisA base l g t) (incr l 7)) * prodF f (fr (basisA base l g t) (incr l 8))) * walsh f (y (mainR g .x0 t)) at h
  apply normal_qi f (basisA base l g t) (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7 ∪ incr l 8) (Sum.inl l)
  rw [h, qi_split, prodF_S6]
  ring

