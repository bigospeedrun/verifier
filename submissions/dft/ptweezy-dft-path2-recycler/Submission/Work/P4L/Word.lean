  apply normal_qi f (basisA base l g t) (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4) (Sum.inl l)
  rw [h, qi_split, prodF_S04]
  ring

