/-!
# P4-L, part 14: the RAW P4-L-fresh word of one unit and its live certificate

Generated by p3-port/py/gen_word.py; do not edit.  One unit = one gauge copy per `g : Orth (LC (Fin 8) H l)` of the
p4 keep303 controller on the leader's K = 4 geometry, every port `t` in parallel:

    adapters A (`AinM`) ; 9 native calls (`callSeg k`, every slot a FRESH helper) ; 6 retained windows (ONE block
    of rank 8 m per owner, `winSeg w`) ; 18 bridges (`gateM`) ; 4 signed exchanges (`swapM`) ; adapters B (`AoutM`)

in the event order of `P4L.ctrlW`; before it the free adapters of the helpers, after it their free end steps and
ONE free shift per main role.  `opMain_view`: on the view of every port the main path is
`adaptOut (ctrl d q qi (adaptIn _))`, so by `P4Ctrl.ctrl_diag` every main role ends at ONE monomial of its own
input, which the shift turns into `blockMat` of the lines `tgtS i` of `BBC (base t) l g` (`final_main`);
`opMain_fresh`: the helper `(g, k, q)` sees its call's residual only.  **`rawCert`** (RAW: no pad, no split):

    targets   main (g, i, t) : (BBC (base t) l g).fam (tgtS l i), ranks 25 25 41 73 25 25 41 73 (x0 y0 .. x3 y3)
              fresh (g, k, q) : FH.targ (D q), rank |D q| = card H - dim (I.ent q)
    price     rawCost I l = 9 |Γ| I.cost + |Γ| |T| (6 bcost 8 + 4 bcost 16 + 2 bcost 32)

No `sorry`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 4000000

namespace OAI
namespace PowerSaving
namespace P4L
open Binary Matrix Finset RAM SS CB RF BC GX GF XHostTW P4Ctrl

noncomputable section

section Word
variable {H T Sl C : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T] [Fintype Sl] [DecidableEq Sl]
  [Fintype C] [DecidableEq C] {Ok : ∀ {β : Type} [Fintype β] [DecidableEq β], GWin H β → Prop}
  (I : GInvW H T Sl C Ok) (base : T → OBase H) (l : H) (hbase : ∀ t, I.tv t = (base t).v l)
  (hH : Fintype.card H = 9) (hOk : ∀ (n : ℕ) (d : Orth (LC (Fin 8) H l)), Ok (win401N l hH n d))

/-! ### the port scalars, targets and shifts -/

/-- the stage transforms of port `(g, t)` in Walsh coordinates. -/
def dF (f : ℕ) (g : (Orth (LC (Fin 8) H l))) (t : T) : Fin 9 → (Sky (LC (Fin 8) H l) f → ℂ) :=
  fun k => prodF f (fr (basisA base l g t) (incr l k))

/-- the port translation `q`. -/
def qF (f : ℕ) (g : (Orth (LC (Fin 8) H l))) (t : T) : Sky (LC (Fin 8) H l) f → ℂ := prodF f (fr (basisA base l g t) {Sum.inl l})

/-- the inverse port translation `qi`. -/
def qiF (f : ℕ) (g : (Orth (LC (Fin 8) H l))) (t : T) : Sky (LC (Fin 8) H l) f → ℂ :=
  prodF f (fun x => (fr (basisA base l g t) {Sum.inl l} x)⁻¹)

/-- the target lines of an adapted main role (`P4Ctrl.ctrl_diag`: the pivot and the increments of its stages). -/
def tgtS (i : R8) : Finset (LC (Fin 8) H l) :=
  match i with
  | .x0 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)
  | .y0 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2)
  | .x1 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4)
  | .y1 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4 ∪ incr l 5 ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)
  | .x2 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)
  | .y2 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2)
  | .x3 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4)
  | .y3 => (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4 ∪ incr l 5 ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)

/-- the free shift that ends a main role (`normal_qi`, `normal_q`). -/
def cvec (g : (Orth (LC (Fin 8) H l))) (t : T) (i : R8) : Space (LC (Fin 8) H l) :=
  match i with
  | .x0 => (basisA base l g t).v (Sum.inl l) + (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)
  | .y0 => (basisA base l g t).v (Sum.inl l) + (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2)
  | .x1 => (basisA base l g t).v (Sum.inl l) + (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4)
  | .y1 => (basisA base l g t).v (Sum.inl l) + (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4 ∪ incr l 5 ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)
  | .x2 => (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)
  | .y2 => (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2)
  | .x3 => (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4)
  | .y3 => (basisA base l g t).corr (({Sum.inl l} : Finset (LC (Fin 8) H l)) ∪ incr l 0 ∪ incr l 1 ∪ incr l 2 ∪ incr l 3 ∪ incr l 4 ∪ incr l 5 ∪ incr l 6 ∪ incr l 7 ∪ incr l 8)

/-- the shift of every role (`0` off the main roles). -/
def cvecR : (PRole (Orth (LC (Fin 8) H l)) T Sl C) → Space (LC (Fin 8) H l)
  | .inl (.inl (g, (i, t))) => cvec base l g t i
  | _ => 0

/-- **the targets of the raw word**: main roles the lines `tgtS i` of their basis, helpers `FH.targ (D q)`. -/
def rawTz (D : Sl → Finset (LC (Fin 8) H l)) : PLive (Orth (LC (Fin 8) H l)) T Sl → Σ r : ℕ, (Fin r → Space (LC (Fin 8) H l))
  | .inl (g, (i, t)) => ⟨(tgtS l i).card, (basisA base l g t).fam (tgtS l i)⟩
  | .inr (_, (_, q)) => ⟨(D q).card, FH.targ (D q)⟩

/-- the targets are linearly independent. -/
lemma rawTz_indep (D : Sl → Finset (LC (Fin 8) H l)) (l' : PLive (Orth (LC (Fin 8) H l)) T Sl) : LinearIndependent F (rawTz base l D l').2 := by
  rcases l' with ⟨g, i, t⟩ | ⟨g, k, q⟩
  · exact OBase.fam_indep (basisA base l g t) (tgtS l i)
  · exact FH.targ_indep (D q)

/-- the target rank of a helper. -/
lemma rawTz_fresh (D : Sl → Finset (LC (Fin 8) H l)) (g : (Orth (LC (Fin 8) H l))) (k : Fin 9) (q : Sl) :
    (rawTz base l D (Sum.inr (g, (k, q)))).1 = (D q).card := rfl

/-- **the price of the raw word**: nine calls on every gauge, the window blocks of every port. -/
def rawCost (φ : ℕ → ℝ) : ℝ :=
  9 * ((Fintype.card (Orth (LC (Fin 8) H l)) : ℝ) * I.cost φ)
    + (Fintype.card (Orth (LC (Fin 8) H l)) : ℝ) * (Fintype.card T : ℝ) * (6 * bcost φ 8 + 4 * bcost φ 16 + 2 * bcost φ 32)

