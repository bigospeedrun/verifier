-- changed for the tensor-power extension (30103/10000000); see Submission.lean

/-!
# P4-L, part 11: the retained idle windows of P4-L-fresh (generated by p3-port/py/gen_windows.py; do not edit)

Keep set 303 of the #401 geometry: windows A2 (pair 1, stages 0-1), B2 (pair 1, stage 2), A3 (pair 2, stages 0-3),
B3 (pair 2, stage 4), B4 (pair 3, stage 6), F3 (pair 2, stages 7-8); A4, F1, F2 are omitted.  In P4-L-fresh (raw) a
window hosts no helper: every owner role climbs the whole window with ONE block of rank `8 m` (`m` stages) inside
the basis `BBC (base t) l g` (`BC.reach_of_pos`, `BC.reach_of_lt`); the separated form splits it afterwards
(`MX.splitWord`).  The window is one operator route (`ORoute.steps_inv`) and moves the view of every port by
`win x y m`, `m` the product of its stage transforms `prodF (fr A (incr s))`.  No `sorry`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 2000000

namespace OAI
namespace PowerSaving
namespace P4L
open Binary Matrix Finset RAM SS CB RF BC GX GF

noncomputable section

section Win
variable {H T Sl C : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T] [Fintype Sl] [DecidableEq Sl]
  [Fintype C] [DecidableEq C] (base : T → OBase H) (l : H) (hH : Fintype.card H = 9)

/-- the two owner roles of a pair at every port. -/
def ownerSet (x y : R8) : Finset (PRole (Orth (LC (Fin 8) H l)) T Sl C) :=
  (Finset.univ : Finset (Orth (LC (Fin 8) H l) × T)).image (fun p => mainR p.1 x p.2) ∪
    (Finset.univ : Finset (Orth (LC (Fin 8) H l) × T)).image (fun p => mainR p.1 y p.2)

lemma mem_ownerSet (x y : R8) (g : Orth (LC (Fin 8) H l)) (i : R8) (t : T) :
    mainR (Sl := Sl) (C := C) g i t ∈ ownerSet (H := H) (T := T) (Sl := Sl) (C := C) l x y ↔ (i = x ∨ i = y) := by
  unfold ownerSet
  rw [Finset.mem_union, Finset.mem_image, Finset.mem_image]
  constructor
  · rintro (⟨⟨g', t'⟩, -, h⟩ | ⟨⟨g', t'⟩, -, h⟩)
    · simp only [mainR, Sum.inl.injEq, Prod.mk.injEq] at h; exact Or.inl h.2.1.symm
    · simp only [mainR, Sum.inl.injEq, Prod.mk.injEq] at h; exact Or.inr h.2.1.symm
  · rintro (rfl | rfl)
    · exact Or.inl ⟨(g, t), Finset.mem_univ _, rfl⟩
    · exact Or.inr ⟨(g, t), Finset.mem_univ _, rfl⟩

lemma ownerSet_main (x y : R8) (r : PRole (Orth (LC (Fin 8) H l)) T Sl C)
    (hr : r ∈ ownerSet (H := H) (T := T) (Sl := Sl) (C := C) l x y) : ∃ g i t, r = mainR g i t := by
  unfold ownerSet at hr
  rw [Finset.mem_union, Finset.mem_image, Finset.mem_image] at hr
  rcases hr with (⟨⟨g, t⟩, -, rfl⟩ | ⟨⟨g, t⟩, -, rfl⟩)
  · exact ⟨g, x, t, rfl⟩
  · exact ⟨g, y, t, rfl⟩

/-- start / end frames of a window's owners (`a`, `b + 1` the stage indices). -/
def winF (x : R8) (a : ℕ) : PRole (Orth (LC (Fin 8) H l)) T Sl C → CMat (LC (Fin 8) H l)
  | .inl (.inl (g, (i, t))) => if i = x then frame (BBC (base t) l g) (setX l a) else frame (BBC (base t) l g) (setY l a)
  | _ => 1

def winF' (x : R8) (a : ℕ) : PRole (Orth (LC (Fin 8) H l)) T Sl C → CMat (LC (Fin 8) H l)
  | .inl (.inl (g, (i, t))) =>
      if i = x then unframe (BBC (base t) l g) (setX l a) else unframe (BBC (base t) l g) (setY l a)
  | _ => 1

lemma winF_inv (x : R8) (a : ℕ) (r : PRole (Orth (LC (Fin 8) H l)) T Sl C) :
    winF (Sl := Sl) (C := C) base l x a r * winF' (Sl := Sl) (C := C) base l x a r = 1 := by
  rcases r with ((⟨g, i, t⟩ | h) | c)
  · simp only [winF, winF']; split_ifs <;> exact unframe_right _ _
  · simp [winF, winF']
  · simp [winF, winF']

lemma setX_mono (a : ℕ) : ∀ b, a ≤ b → b ≤ 9 → setX l a ⊆ setX l b
  | 0, hab, _ => by
    have e : a = 0 := by omega
    subst e; exact Finset.Subset.refl _
  | b + 1, hab, hb => by
    rcases Nat.lt_or_ge a (b + 1) with h | h
    · rw [(setX_succ l b (by omega)).1]
      exact (setX_mono a b (by omega) (by omega)).trans Finset.subset_union_left
    · have e : a = b + 1 := by omega
      subst e; exact Finset.Subset.refl _

lemma setY_mono (a : ℕ) : ∀ b, a ≤ b → b ≤ 9 → setY l a ⊆ setY l b
  | 0, hab, _ => by
    have e : a = 0 := by omega
    subst e; exact Finset.Subset.refl _
  | b + 1, hab, hb => by
    rcases Nat.lt_or_ge a (b + 1) with h | h
    · rw [(setY_succ l b (by omega)).1]
      exact (setY_mono a b (by omega) (by omega)).trans Finset.subset_union_left
    · have e : a = b + 1 := by omega
      subst e; exact Finset.Subset.refl _

include hH in
lemma card_incr (k : ℕ) (hk : k < 9) : (incr l k).card = 8 := by
  interval_cases k <;> simp [incr, card_JC, card_qC, card_compl_single, hH]

include hH in
lemma card_LC73 : Fintype.card (LC (Fin 8) H l) = 73 := by
  rw [card_LC, Fintype.card_fin, hH]

include hH in
lemma card_setX : ∀ k, k ≤ 9 → (setX l k).card = 1 + 8 * k
  | 0, _ => by
    show (JC {l} (∅ : Finset (Fin 8 × Hp H l))).card = 1 + 8 * 0
    rw [card_JC, Finset.card_singleton, Finset.card_empty]
  | k + 1, hk => by
    obtain ⟨e, d⟩ := setX_succ l k (by omega)
    rw [e, Finset.card_union_of_disjoint d, card_setX k (by omega), card_incr l hH k (by omega)]
    ring

include hH in
lemma card_setY : ∀ k, k ≤ 9 → (setY l k).card = 8 * k
  | 0, _ => by
    show (JC (∅ : Finset H) (∅ : Finset (Fin 8 × Hp H l))).card = 8 * 0
    rw [card_JC, Finset.card_empty, Finset.card_empty]
  | k + 1, hk => by
    obtain ⟨e, d⟩ := setY_succ l k (by omega)
    rw [e, Finset.card_union_of_disjoint d, card_setY k (by omega), card_incr l hH k (by omega)]
    ring

