/-! ### the windows on the view -/

lemma setX_add (a n : ℕ) (h : a + n < 9) :
    setX l (a + n + 1) = setX l a ∪ ((Finset.range (n + 1)).biUnion fun j => incr l (a + j)) ∧
      Disjoint (setX l a) ((Finset.range (n + 1)).biUnion fun j => incr l (a + j)) := by
  induction n with
  | zero =>
    simp only [Nat.add_zero, zero_add, Finset.range_one, Finset.singleton_biUnion]
    exact setX_succ l a (by omega)
  | succ n ih =>
    obtain ⟨e, d⟩ := ih (by omega)
    obtain ⟨e2, d2⟩ := setX_succ l (a + n + 1) (by omega)
    have hb : (Finset.range (n + 1 + 1)).biUnion (fun j => incr l (a + j))
        = incr l (a + n + 1) ∪ (Finset.range (n + 1)).biUnion (fun j => incr l (a + j)) := by
      rw [Finset.range_add_one, Finset.biUnion_insert, show a + (n + 1) = a + n + 1 by omega]
    have hs : setX l (a + (n + 1) + 1) = setX l (a + n + 1 + 1) := rfl
    refine ⟨?_, ?_⟩
    · rw [hs, e2, e, hb, Finset.union_assoc, Finset.union_comm (incr l (a + n + 1))]
    · rw [hb, Finset.disjoint_union_right]
      exact ⟨Finset.disjoint_of_subset_left (by rw [e]; exact Finset.subset_union_left) d2, d⟩

lemma setY_add (a n : ℕ) (h : a + n < 9) :
    setY l (a + n + 1) = setY l a ∪ ((Finset.range (n + 1)).biUnion fun j => incr l (a + j)) ∧
      Disjoint (setY l a) ((Finset.range (n + 1)).biUnion fun j => incr l (a + j)) := by
  induction n with
  | zero =>
    simp only [Nat.add_zero, zero_add, Finset.range_one, Finset.singleton_biUnion]
    exact setY_succ l a (by omega)
  | succ n ih =>
    obtain ⟨e, d⟩ := ih (by omega)
    obtain ⟨e2, d2⟩ := setY_succ l (a + n + 1) (by omega)
    have hb : (Finset.range (n + 1 + 1)).biUnion (fun j => incr l (a + j))
        = incr l (a + n + 1) ∪ (Finset.range (n + 1)).biUnion (fun j => incr l (a + j)) := by
      rw [Finset.range_add_one, Finset.biUnion_insert, show a + (n + 1) = a + n + 1 by omega]
    have hs : setY l (a + (n + 1) + 1) = setY l (a + n + 1 + 1) := rfl
    refine ⟨?_, ?_⟩
    · rw [hs, e2, e, hb, Finset.union_assoc, Finset.union_comm (incr l (a + n + 1))]
    · rw [hb, Finset.disjoint_union_right]
      exact ⟨Finset.disjoint_of_subset_left (by rw [e]; exact Finset.subset_union_left) d2, d⟩

/-- window 0 moves the view of every port by `win` with the product of its stage transforms. -/
theorem view_winSeg0 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f)
    (g : Orth (LC (Fin 8) H l)) (t : T) :
    view f g t (fun r => if r ∈ ownerSet (H := H) (T := T) (Sl := Sl) (C := C) l .x1 .y1
      then matAct f (winF (Sl := Sl) (C := C) base l .x1 2 r * winF' (Sl := Sl) (C := C) base l .x1 0 r) (y r)
      else y r)
      = win .x1 .y1 (prodF f (fr (BBC (base t) l g) ((Finset.range 2).biUnion fun j => incr l (0 + j)))) (view f g t y) := by
  obtain ⟨eX, dX⟩ := setX_add l 0 1 (by norm_num)
  obtain ⟨eY, dY⟩ := setY_add l 0 1 (by norm_num)
  apply view_steps_win _ _ f y g t .x1 .y1 (by decide) _ (fun i => mem_ownerSet l .x1 .y1 g i t)
  rintro i (rfl | rfl) v
  · simp only [winF, winF', mainR, if_pos rfl]
    rw [← matAct_mul]
    have e : setX l 2 = setX l 0 ∪ ((Finset.range 2).biUnion fun j => incr l (0 + j)) := eX
    rw [e]
    exact walsh_ratio f _ _ _ dX v
  · simp only [winF, winF', mainR, if_neg (by decide : R8.y1 ≠ R8.x1)]
    rw [← matAct_mul]
    have e : setY l 2 = setY l 0 ∪ ((Finset.range 2).biUnion fun j => incr l (0 + j)) := eY
    rw [e]
    exact walsh_ratio f _ _ _ dY v

