/-- window 0: the `X` owners climb over stages 0..1 with ONE block of rank 16. -/
lemma win0X (t : T) (g : Orth (LC (Fin 8) H l)) :
    GReach (frame (BBC (base t) l g) (setX l 0)) (frame (BBC (base t) l g) (setX l 2))
      (fun φ => bcost φ 16) := by
  have h1 := card_setX l hH 0 (by norm_num)
  have h2 := card_setX l hH 2 (by norm_num)
  have h3 := card_LC73 l hH
  exact GReach.ofX (reach_of_pos (by omega) (BBC (base t) l g) (setX_mono l 0 2 (by norm_num) (by norm_num))
    16 (by omega) (by omega))

