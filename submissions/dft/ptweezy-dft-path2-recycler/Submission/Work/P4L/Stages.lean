import Submission.Work.P4L.View
-- changed for the tensor-power extension (30103/10000000); see Submission.lean

/-!
# P4-L, part 12: the nine native calls of a unit (generated by p3-port/py/gen_stages.py; do not edit)

Stage `k` (pairs 0, 0, 0, 1, 1, 2, 2, 3, 3; forward for even `k`) runs the provider `I` at the windows
`win401N l hH k d` with the gauges `gaugeE base l k`; at port `(g, t)` its frames are coordinate frames of
`BBC (base t) l g` (`stage*_Xin` .. `stage*_Yout`), so `call_fwd` / `call_bwd` apply with
`sX = setY k ∪ {pivot}`, `sX' = sX ∪ incr k`, `sY = setY k`, `sY' = setY k ∪ incr k`, and the call moves the view
of every port by `callF` / `callB` with `d = prodF (fr A (incr k))` and `q = prodF (fr A {pivot})`.  No `sorry`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 2000000

namespace OAI
namespace PowerSaving
namespace P4L
open Binary Matrix Finset RAM SS CB RF BC GX GF XHostTW

noncomputable section

section Stages
variable {H T Sl C : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T] [Fintype Sl] [DecidableEq Sl]
  [Fintype C] [DecidableEq C] {Ok : ∀ {β : Type} [Fintype β] [DecidableEq β], GWin H β → Prop}
  (I : GInvW H T Sl C Ok) (base : T → OBase H) (l : H) (hbase : ∀ t, I.tv t = (base t).v l)
  (hH : Fintype.card H = 9) (hOk : ∀ (n : ℕ) (d : Orth (LC (Fin 8) H l)), Ok (win401N l hH n d))

/-- the common basis of port `(g, t)`. -/
abbrev basisA (g : Orth (LC (Fin 8) H l)) (t : T) : OBase (LC (Fin 8) H l) := BBC (base t) l g

/-- the residual matrix of slot `q` at stage `k`, gauge `d`. -/
def wnK (k : ℕ) (d : Orth (LC (Fin 8) H l)) (q : Sl) : CMat (LC (Fin 8) H l) := entW (win401N l hH k d).X (I.ent q)

lemma setX_eq (k : ℕ) (hk : k ≤ 9) : setX l k = setY l k ∪ {Sum.inl l} := (setX_pivot l k hk).1

include hbase hOk in
/-- **stage 0** (forward) as an operator route on the network. -/
theorem callSeg0 : ORoute (fun f y => multiAct f (stT (Sl := Sl) (C := C) (0 : Fin 9) (basisA base l)
      (setY l 0 ∪ {Sum.inl l} ∪ incr l 0) (setY l 0 ∪ incr l 0) (wnK I l hH 0))
      (point f (gFk (0 : Fin 9)) (multiAct f (stS' (0 : Fin 9) (basisA base l) (setY l 0 ∪ {Sum.inl l}) (setY l 0)) y)))
      (fun φ => (Fintype.card (Orth (LC (Fin 8) H l)) : ℝ) * I.cost φ) := by
  have eX1 := (setX_succ l 0 (by norm_num)).1
  have eY1 := (setY_succ l 0 (by norm_num)).1
  have eP := setX_eq l 0 (by norm_num)
  refine call_fwd I (0 : Fin 9) (gaugeE base l 0) (fun d => win401N l hH 0 d) (hOk 0) (basisA base l)
    (setY l 0 ∪ {Sum.inl l}) (setY l 0 ∪ {Sum.inl l} ∪ incr l 0) (setY l 0) (setY l 0 ∪ incr l 0)
    (fun g t => ?_) (fun g t => ?_) (fun g t => ?_) (fun g t => ?_)
  · rw [hbase t, ← eP]; exact stage0_Xin base l t g
  · rw [← eP, ← eX1]; exact stage0_Xout base l t g
  · exact stage0_Yin base l t g
  · rw [hbase t, ← eY1]; exact stage0_Yout base l t g

/-- stage 0 moves the view of every port by `callF`. -/
theorem view_callSeg0 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f)
    (g : Orth (LC (Fin 8) H l)) (t : T) :
    view f g t (multiAct f (stT (Sl := Sl) (C := C) (0 : Fin 9) (basisA base l)
      (setY l 0 ∪ {Sum.inl l} ∪ incr l 0) (setY l 0 ∪ incr l 0) (wnK I l hH 0))
      (point f (gFk (0 : Fin 9)) (multiAct f (stS' (0 : Fin 9) (basisA base l) (setY l 0 ∪ {Sum.inl l}) (setY l 0)) y)))
      = callF (xOf 0) (yOf 0) (prodF f (fr (basisA base l g t) (incr l 0))) (prodF f (fun x => (fr (basisA base l g t) {Sum.inl l} x)⁻¹)) (view f g t y) := by
  have dX := (setX_succ l 0 (by norm_num)).2
  have dY := (setY_succ l 0 (by norm_num)).2
  have dP := (setX_pivot l 0 (by norm_num)).2
  have eP := setX_eq l 0 (by norm_num)
  rw [eP] at dX
  exact view_call_fwd (0 : Fin 9) (basisA base l) (setY l 0) (incr l 0) (Sum.inl l) dX dY dP (wnK I l hH 0) f y g t

