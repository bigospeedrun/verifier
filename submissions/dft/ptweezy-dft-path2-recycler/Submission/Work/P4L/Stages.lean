      (point f (gBk (7 : Fin 9)) (multiAct f (stS' (7 : Fin 9) (basisA base l) (setY l 7 ∪ {Sum.inl l}) (setY l 7)) y)))
      = callB (xOf 7) (yOf 7) (prodF f (fr (basisA base l g t) (incr l 7))) (prodF f (fr (basisA base l g t) {Sum.inl l})) (view f g t y) := by
  have dX := (setX_succ l 7 (by norm_num)).2
  have dY := (setY_succ l 7 (by norm_num)).2
  have dP := (setX_pivot l 7 (by norm_num)).2
  have eP := setX_eq l 7 (by norm_num)
  rw [eP] at dX
  exact view_call_bwd (7 : Fin 9) (basisA base l) (setY l 7) (incr l 7) (Sum.inl l) dX dY dP (wnK I l hH 7) f y g t

include hbase hOk in
/-- **stage 8** (forward) as an operator route on the network. -/
theorem callSeg8 : ORoute (fun f y => multiAct f (stT (Sl := Sl) (C := C) (8 : Fin 9) (basisA base l)
      (setY l 8 ∪ {Sum.inl l} ∪ incr l 8) (setY l 8 ∪ incr l 8) (wnK I l hH 8))
      (point f (gFk (8 : Fin 9)) (multiAct f (stS' (8 : Fin 9) (basisA base l) (setY l 8 ∪ {Sum.inl l}) (setY l 8)) y)))
      (fun φ => (Fintype.card (Orth (LC (Fin 8) H l)) : ℝ) * I.cost φ) := by
  have eX1 := (setX_succ l 8 (by norm_num)).1
  have eY1 := (setY_succ l 8 (by norm_num)).1
  have eP := setX_eq l 8 (by norm_num)
  refine call_fwd I (8 : Fin 9) (gaugeE base l 8) (fun d => win401N l hH 8 d) (hOk 8) (basisA base l)
    (setY l 8 ∪ {Sum.inl l}) (setY l 8 ∪ {Sum.inl l} ∪ incr l 8) (setY l 8) (setY l 8 ∪ incr l 8)
    (fun g t => ?_) (fun g t => ?_) (fun g t => ?_) (fun g t => ?_)
  · rw [hbase t, ← eP]; exact stage8_Xin base l t g
  · rw [← eP, ← eX1]; exact stage8_Xout base l t g
  · exact stage8_Yin base l t g
  · rw [hbase t, ← eY1]; exact stage8_Yout base l t g

/-- stage 8 moves the view of every port by `callF`. -/
theorem view_callSeg8 (f : ℕ) (y : Data (LC (Fin 8) H l) (PRole (Orth (LC (Fin 8) H l)) T Sl C) f)
    (g : Orth (LC (Fin 8) H l)) (t : T) :
    view f g t (multiAct f (stT (Sl := Sl) (C := C) (8 : Fin 9) (basisA base l)
      (setY l 8 ∪ {Sum.inl l} ∪ incr l 8) (setY l 8 ∪ incr l 8) (wnK I l hH 8))
      (point f (gFk (8 : Fin 9)) (multiAct f (stS' (8 : Fin 9) (basisA base l) (setY l 8 ∪ {Sum.inl l}) (setY l 8)) y)))
      = callF (xOf 8) (yOf 8) (prodF f (fr (basisA base l g t) (incr l 8))) (prodF f (fun x => (fr (basisA base l g t) {Sum.inl l} x)⁻¹)) (view f g t y) := by
  have dX := (setX_succ l 8 (by norm_num)).2
  have dY := (setY_succ l 8 (by norm_num)).2
  have dP := (setX_pivot l 8 (by norm_num)).2
  have eP := setX_eq l 8 (by norm_num)
  rw [eP] at dX
  exact view_call_fwd (8 : Fin 9) (basisA base l) (setY l 8) (incr l 8) (Sum.inl l) dX dY dP (wnK I l hH 8) f y g t

end Stages

