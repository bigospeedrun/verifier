import Submission.Work.XHost.Frames

/-!
# XHostD.FramesK: hosting with PER-SUB-STAGE residuals (two-provider dispatch)

h-L3-design's `XHost.slot_frames` / `XHost.host_frames` with the residual of slot `q` allowed to depend on the
sub-stage `k`: `r : ℕ → Sl → ℕ` instead of `r : Sl → ℕ`.  With two provider words per call (the hub's T74 dispatch:
`extra` and `gauge44`, which differ in the entrance labels of four slots, residual 5 against 4), the residual of slot
`q` in sub-stage `k` is `9 - dim((I (disp k)).ent q)`.  The proofs are h-L3-design's, word for word (sections Sched
and Host of Work/XHost/Frames.lean, renamed with a `K` suffix); `LHK_const` recovers the old load for a constant
residual.  Generated by lg-a2a4/tools/mk_framesk.py (wht43, 14 Oct 2026) by checked text substitution; prepared with
assistance from Claude.  No `sorry`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace OAI
namespace PowerSaving
namespace XHostD
open Binary Matrix Finset GF CB B401 XHost
noncomputable section

section Sched
variable {α Γ Sl J : Type} [Fintype α] [DecidableEq α] [Fintype Sl] [DecidableEq Sl] [DecidableEq J]
variable (use : ℕ → Sl → Option J) (r : ℕ → Sl → ℕ)

/-- the residual the slot role `j` takes in sub-stage `k`. -/
def rrHK (k : ℕ) (j : J) : ℕ := ∑ q ∈ univ.filter (fun q => use k q = some j), r k q

/-- the load of the slot role `j` after `k` sub-stages. -/
def LHK (k : ℕ) (j : J) : ℕ := ∑ i ∈ range k, rrHK use r i j

lemma LH_zeroK (j : J) : LHK use r 0 j = 0 := by simp [LHK]

lemma LH_succK (k : ℕ) (j : J) : LHK use r (k + 1) j = LHK use r k j + rrHK use r k j := by
  simp [LHK, Finset.sum_range_succ]

lemma LH_monoK {k k' : ℕ} (h : k ≤ k') (j : J) : LHK use r k j ≤ LHK use r k' j :=
  Finset.sum_le_sum_of_subset (Finset.range_subset_range.mpr h)

/-- at most ONE slot of an invocation on a slot role per sub-stage. -/
def OneUseK (k : ℕ) : Prop := ∀ q q' j, use k q = some j → use k q' = some j → q = q'

lemma rrH_of_useK {k : ℕ} (hinj : OneUseK use k) {q : Sl} {j : J} (hq : use k q = some j) :
    rrHK use r k j = r k q := by
  unfold rrHK
  rw [Finset.sum_eq_single q]
  · intro q' hq' hne
    exact absurd (hinj q' q j (Finset.mem_filter.mp hq').2 hq) hne
  · intro h
    exact absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ q, hq⟩) h

lemma rrH_of_notK {k : ℕ} {j : J} (h : ∀ q, use k q ≠ some j) : rrHK use r k j = 0 := by
  unfold rrHK
  exact Finset.sum_eq_zero (fun q hq => absurd (Finset.mem_filter.mp hq).2 (h q))

variable (Wn : ℕ → Γ → Sl → CMat α) (B : Γ → J → CMat α) (D : Γ → J → Finset α)

/-- one step of one slot role (`t = (P, A2, U2)`), frames `A * pk U * B d j`. -/
def StepOkHK (k : ℕ) (d : Γ) (j : J) (A : CMat α) (U : Finset α) (t : CMat α × CMat α × Finset α) : Prop :=
  Free t.1 ∧ Free t.2.1 ∧ t.2.2 ⊆ D d j ∧ t.2.2.card = LHK use r (k + 1) j ∧
    (∀ q, use k q = some j → Wn k d q * (t.1 * (A * pk U * B d j)) = t.2.1 * pk t.2.2 * B d j) ∧
    ((∀ q, use k q ≠ some j) → t.1 = 1 ∧ t.2.1 * pk t.2.2 = A * pk U)

lemma stepH_exK {k : ℕ} (d : Γ) (j : J) {A : CMat α} {U : Finset α} (hA : Free A) (hUD : U ⊆ D d j)
    (hU : U.card = LHK use r k j) (hb : LHK use r (k + 1) j ≤ (D d j).card) (hinj : OneUseK use k)
    (hWn : ∀ q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧ Wn k d q = C * pk R * C') :
    ∃ t, StepOkHK use r Wn B D k d j A U t := by
  by_cases h : ∃ q, use k q = some j
  · obtain ⟨q0, hq0⟩ := h
    obtain ⟨C, C', R, hC, hC', hR, hW⟩ := hWn q0
    have hL : LHK use r (k + 1) j = U.card + R.card := by
      rw [LH_succK, rrH_of_useK use r hinj hq0, hU, hR]
    obtain ⟨P, hP, A2, U2, hA2, hU2D, hc, he⟩ :=
      host_adapt (B := B d j) hA hC hC' (D d j) U R hUD (by rw [← hL]; exact hb)
    refine ⟨(P, A2, U2), hP, hA2, hU2D, by rw [hL]; exact hc, fun q hq => ?_, fun hn => absurd hq0 (hn q0)⟩
    have e : q = q0 := hinj q q0 j hq hq0
    subst e
    show Wn k d q * (P * (A * pk U * B d j)) = A2 * pk U2 * B d j
    rw [hW]
    exact he
  · push_neg at h
    refine ⟨(1, A, U), Free.one, hA, hUD, ?_, fun q hq => absurd hq (h q), fun _ => ⟨rfl, rfl⟩⟩
    show U.card = LHK use r (k + 1) j
    rw [LH_succK, rrH_of_notK use r h, hU, Nat.add_zero]

variable (K : ℕ)

/-- the state invariant of a slot role after `k` sub-stages. -/
def InvHK (d : Γ) (j : J) (k : ℕ) (p : CMat α × Finset α) : Prop :=
  Free p.1 ∧ p.2 ⊆ D d j ∧ (k ≤ K → LHK use r k j ≤ (D d j).card → p.2.card = LHK use r k j)

lemma stepH_exK' (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (k : ℕ) (d : Γ) (j : J) (s : {p : CMat α × Finset α // InvHK use r D K d j k p}) :
    ∃ t : CMat α × CMat α × Finset α, Free t.2.1 ∧ t.2.2 ⊆ D d j ∧
      (k + 1 ≤ K → LHK use r (k + 1) j ≤ (D d j).card → t.2.2.card = LHK use r (k + 1) j) ∧
      (k < K → LHK use r (k + 1) j ≤ (D d j).card → StepOkHK use r Wn B D k d j s.1.1 s.1.2 t) := by
  by_cases hk : k < K
  · by_cases hb : LHK use r (k + 1) j ≤ (D d j).card
    · have hU := s.2.2.2 hk.le (le_trans (LH_monoK use r (Nat.le_succ k) j) hb)
      obtain ⟨t, ht⟩ := stepH_exK use r Wn B D d j s.2.1 s.2.2.1 hU hb (hinj k hk) (hWn k hk d)
      exact ⟨t, ht.2.1, ht.2.2.1, fun _ _ => ht.2.2.2.1, fun _ _ => ht⟩
    · exact ⟨(1, s.1.1, s.1.2), s.2.1, s.2.2.1, fun _ h => absurd h hb, fun _ h => absurd h hb⟩
  · exact ⟨(1, s.1.1, s.1.2), s.2.1, s.2.2.1, fun h => absurd (Nat.lt_of_succ_le h) hk,
      fun h => absurd h hk⟩

/-- the state `(A, U)` of every slot role after `k` sub-stages (start `A0 d j`, `U = ∅`). -/
def stSHK (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (A0 : Γ → J → CMat α) (hA0 : ∀ d j, Free (A0 d j)) (d : Γ) (j : J) :
    (k : ℕ) → {p : CMat α × Finset α // InvHK use r D K d j k p}
  | 0 => ⟨(A0 d j, ∅), hA0 d j, Finset.empty_subset _, fun _ _ => by rw [LH_zeroK]; rfl⟩
  | k + 1 =>
    let t := Classical.choose (stepH_exK' use r Wn B D K hinj hWn k d j (stSHK hinj hWn A0 hA0 d j k))
    have ht := Classical.choose_spec (stepH_exK' use r Wn B D K hinj hWn k d j (stSHK hinj hWn A0 hA0 d j k))
    ⟨(t.2.1, t.2.2), ht.1, ht.2.1, ht.2.2.1⟩

/-- the step of sub-stage `k`. -/
def stTHK (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (A0 : Γ → J → CMat α) (hA0 : ∀ d j, Free (A0 d j)) (d : Γ) (j : J) (k : ℕ) : CMat α × CMat α × Finset α :=
  Classical.choose (stepH_exK' use r Wn B D K hinj hWn k d j (stSHK use r Wn B D K hinj hWn A0 hA0 d j k))

lemma stTH_specK (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (A0 : Γ → J → CMat α) (hA0 : ∀ d j, Free (A0 d j)) (d : Γ) (j : J) (k : ℕ) (hk : k < K)
    (hb : LHK use r (k + 1) j ≤ (D d j).card) :
    StepOkHK use r Wn B D k d j (stSHK use r Wn B D K hinj hWn A0 hA0 d j k).1.1
      (stSHK use r Wn B D K hinj hWn A0 hA0 d j k).1.2 (stTHK use r Wn B D K hinj hWn A0 hA0 d j k) :=
  (Classical.choose_spec (stepH_exK' use r Wn B D K hinj hWn k d j
    (stSHK use r Wn B D K hinj hWn A0 hA0 d j k))).2.2.2 hk hb

lemma stSH_succK (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (A0 : Γ → J → CMat α) (hA0 : ∀ d j, Free (A0 d j)) (d : Γ) (j : J) (k : ℕ) :
    (stSHK use r Wn B D K hinj hWn A0 hA0 d j (k + 1)).1 =
      ((stTHK use r Wn B D K hinj hWn A0 hA0 d j k).2.1, (stTHK use r Wn B D K hinj hWn A0 hA0 d j k).2.2) := rfl

/-- **The frames of a family of slot roles (banks and hosts) over a partial schedule.**  Slot role `j` of class
`d` starts at `X0 d j = A0 d j * B d j` (`A0` free) and ends at `X1 d j = Q d j * pk (D d j) * B d j`; every use
adds the residual of the slot inside `D d j`; the end is ONE block of rank `|D d j| - load`. -/
theorem slot_framesK (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (A0 Q : Γ → J → CMat α) (hA0 : ∀ d j, Free (A0 d j)) (hQ : ∀ d j, Free (Q d j))
    (hload : ∀ d j, LHK use r K j ≤ (D d j).card)
    (hrk : ∀ d j, (D d j).card - LHK use r K j < Fintype.card α) :
    ∃ (Zb Zp : ℕ → Γ → J → CMat α),
      (∀ d j, Zb 0 d j = A0 d j * B d j) ∧
      (∀ k < K, ∀ d j, GReach (Zb k d j) (Zp k d j) (fun _ => 0)) ∧
      (∀ k < K, ∀ d q j, use k q = some j → Wn k d q * Zp k d j = Zb (k + 1) d j) ∧
      (∀ k < K, ∀ d j, (∀ q, use k q ≠ some j) → Zb (k + 1) d j = Zp k d j) ∧
      (∀ d j, GReach (Zb K d j) (Q d j * pk (D d j) * B d j)
        (fun φ => bcost φ ((D d j).card - LHK use r K j))) := by
  let S := stSHK use r Wn B D K hinj hWn A0 hA0
  let T := stTHK use r Wn B D K hinj hWn A0 hA0
  have hb' : ∀ k < K, ∀ d j, LHK use r (k + 1) j ≤ (D d j).card := fun k hk d j =>
    le_trans (LH_monoK use r (Nat.succ_le_of_lt hk) j) (hload d j)
  refine ⟨fun k d j => (S d j k).1.1 * pk (S d j k).1.2 * B d j,
    fun k d j => (T d j k).1 * ((S d j k).1.1 * pk (S d j k).1.2 * B d j), ?_, ?_, ?_, ?_, ?_⟩
  · intro d j
    show A0 d j * pk ∅ * B d j = A0 d j * B d j
    rw [pk_empty, Matrix.mul_one]
  · intro k hk d j
    have h := (stTH_specK use r Wn B D K hinj hWn A0 hA0 d j k hk (hb' k hk d j)).1
    exact fun ρ _ _ l => gstep_free h l _
  · intro k hk d q j hq
    have h := (stTH_specK use r Wn B D K hinj hWn A0 hA0 d j k hk (hb' k hk d j)).2.2.2.2.1 q hq
    show Wn k d q * ((T d j k).1 * ((S d j k).1.1 * pk (S d j k).1.2 * B d j))
      = (S d j (k + 1)).1.1 * pk (S d j (k + 1)).1.2 * B d j
    rw [h, stSH_succK]
  · intro k hk d j hn
    have h := (stTH_specK use r Wn B D K hinj hWn A0 hA0 d j k hk (hb' k hk d j)).2.2.2.2.2 hn
    show (S d j (k + 1)).1.1 * pk (S d j (k + 1)).1.2 * B d j
      = (T d j k).1 * ((S d j k).1.1 * pk (S d j k).1.2 * B d j)
    rw [stSH_succK, h.1, Matrix.one_mul, ← h.2]
  · intro d j
    have hA := (S d j K).2.1
    have hUD := (S d j K).2.2.1
    have hU : (S d j K).1.2.card = LHK use r K j := (S d j K).2.2.2 le_rfl (hload d j)
    have h := host_pad hA (hQ d j) (B d j) (D d j) (S d j K).1.2 hUD (by rw [hU]; exact hrk d j)
    rw [hU] at h
    exact h

end Sched

section Host
variable {α Γ Sl J : Type} [Fintype α] [DecidableEq α] [Fintype Sl] [DecidableEq Sl] [DecidableEq J]

/-- **Hosting, end to end.**  If every slot role's idle climb has host form `X1 = Q * pk D * Q' * X0` (rank
`rk j`) and its load fits, the slot roles have frames from `X0` to `X1`: free adapters, the hosted residuals, and ONE
remaining block of rank `rk j - load` each. -/
theorem host_framesK (use : ℕ → Sl → Option J) (r : ℕ → Sl → ℕ) (Wn : ℕ → Γ → Sl → CMat α) (K : ℕ)
    (hinj : ∀ k < K, OneUseK use k)
    (hWn : ∀ k < K, ∀ d q, ∃ (C C' : CMat α) (R : Finset α), Free C ∧ Free C' ∧ R.card = r k q ∧
      Wn k d q = C * pk R * C')
    (X0 X1 : Γ → J → CMat α) (rk : J → ℕ) (hform : ∀ d j, HostForm (X0 d j) (X1 d j) (rk j))
    (hload : ∀ j, LHK use r K j ≤ rk j) (hrk : ∀ j, rk j - LHK use r K j < Fintype.card α) :
    ∃ (Zb Zp : ℕ → Γ → J → CMat α),
      (∀ d j, Zb 0 d j = X0 d j) ∧
      (∀ k < K, ∀ d j, GReach (Zb k d j) (Zp k d j) (fun _ => 0)) ∧
      (∀ k < K, ∀ d q j, use k q = some j → Wn k d q * Zp k d j = Zb (k + 1) d j) ∧
      (∀ k < K, ∀ d j, (∀ q, use k q ≠ some j) → Zb (k + 1) d j = Zp k d j) ∧
      (∀ d j, GReach (Zb K d j) (X1 d j) (fun φ => bcost φ (rk j - LHK use r K j))) := by
  simp only [HostForm] at hform
  choose Q Q' D hQ hQ' hD hX using hform
  have hQ'i : ∀ d j, ∃ Ai : CMat α, Free Ai ∧ Ai * Q' d j = 1 := fun d j => by
    obtain ⟨Ai, hAi, h1, -⟩ := free_inv (hQ' d j)
    exact ⟨Ai, hAi, h1⟩
  choose A0 hA0 hA0Q using hQ'i
  obtain ⟨Zb, Zp, h0, hP, hU, hN, hE⟩ := slot_framesK use r Wn (fun d j => Q' d j * X0 d j) D K hinj hWn A0 Q hA0 hQ
    (fun d j => by rw [hD]; exact hload j) (fun d j => by rw [hD]; exact hrk j)
  refine ⟨Zb, Zp, fun d j => ?_, hP, hU, hN, fun d j => ?_⟩
  · rw [h0, ← Matrix.mul_assoc, hA0Q, Matrix.one_mul]
  · have h := hE d j
    have e : Q d j * pk (D d j) * (Q' d j * X0 d j) = X1 d j := by
      rw [hX]; simp only [Matrix.mul_assoc]
    rw [e, hD] at h
    exact h

end Host

section Const
variable {Sl J : Type} [Fintype Sl] [DecidableEq Sl] [DecidableEq J]

/-- a constant residual gives h-L3-design's load. -/
lemma LHK_const (use : ℕ → Sl → Option J) (r : Sl → ℕ) (k : ℕ) (j : J) :
    LHK use (fun _ => r) k j = XHost.LH use r k j := rfl

lemma OneUseK_iff (use : ℕ → Sl → Option J) (k : ℕ) : OneUseK use k ↔ XHost.OneUse use k := Iff.rfl

end Const
