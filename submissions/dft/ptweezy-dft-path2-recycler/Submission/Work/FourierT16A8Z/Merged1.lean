lemma hillsT16A8Z_le (k : ℕ) : hillsT16A8Z k ≤ k+1 := envelope_le alphaT16A8Z alphaT16A8Z_lt.le k

lemma hillsT16A8Z_real (k : ℕ) : (hillsT16A8Z k:ℝ) ≤ 2*((k:ℝ)+1)^alphaT16A8Z := envelope_real alphaT16A8Z alphaT16A8Z_pos.le k

