/-- **Kernel program at `alphaT16A8Z = 1 - 3020159999999/10^15`**: every colour, both modes, every batch of inputs. -/
theorem engine_T16A8Z (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaT16A8Z (k i)) :=
  MX.T16A8Z.EngineStmt.lift MX.T16A8Z.engine cl m k v

