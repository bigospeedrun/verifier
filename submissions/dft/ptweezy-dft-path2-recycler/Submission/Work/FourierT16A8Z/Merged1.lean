  intro d
  rw [Tape.look_tab, hw,ite_eq_left (show (bits (k i)).loc d < 2^k i from (bits _).bd d)]
  exact gleam_loc _ _ d

structure MattingT16A8Z (b : Bench m ι) (n l : ι→ℕ) (f : ι → ℕ→Shard) : Prop where
