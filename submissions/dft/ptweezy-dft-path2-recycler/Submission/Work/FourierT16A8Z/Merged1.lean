/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaT16A8Z : ℝ := 1 - 82010 / (500000 : ℝ)

theorem alphaT16A8Z_pos : 0 < alphaT16A8Z := by norm_num [alphaT16A8Z]
theorem alphaT16A8Z_lt : alphaT16A8Z < 1 := by norm_num [alphaT16A8Z]

lemma envelope_monoT16A8Z (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expT16A8Z {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsT16A8Z (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaT16A8Z)

