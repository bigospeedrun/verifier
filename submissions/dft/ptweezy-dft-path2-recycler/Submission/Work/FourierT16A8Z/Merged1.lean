      (fun i => 2^k i*hillsT16A8Z (k i)) :=
  SeamT16A8Z.engine_T16A8Z cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaT16A8Z`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geT16A8Z (z : ℝ) (hz : alphaT16A8Z ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsT16A8Z_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expT16A8Z hz (k i))

end RAM

