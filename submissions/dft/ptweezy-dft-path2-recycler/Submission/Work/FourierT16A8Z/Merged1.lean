/-- pack via linear scatter, along with all sector tags -/
lemma packT (h : b.MattingT16A8Z n l f)
    (hx : b.Moves (fun _ => 0) (a (c cl)) fun i => Tape.tab (n i) (x i)) :
    b.Moves n (a (ragTyT16A8Z cl)) fun i => Tape.tab (n i) (ragT16A8Z (n i) (f i) (x i)) := by
