namespace OAI

namespace PowerSaving
noncomputable section
open RAM RAM.Ty Filter Asymptotics

def decimalExponentT16A8Z : ℝ := 1 - 82009/(500000:ℝ)

def decimalTimeT16A8Z (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentT16A8Z

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsT16A8Z (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeT16A8Z ∧ W' =o[atTop] nlogn

def DFTGoalT16A8Z : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsT16A8Z W

def ConvGoalT16A8Z : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsT16A8Z W

end
