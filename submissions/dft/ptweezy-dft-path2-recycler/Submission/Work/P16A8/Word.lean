/-- **every main role ends at its target** after its free shift. -/
theorem final_main (f : ℕ) (y : Data (LC (Fin 17) H l) (PRole (Orth (LC (Fin 17) H l)) T Sl C) f) (g : Orth (LC (Fin 17) H l)) (i : R32) (t : T) :
    matAct f (Binary.shift (cvec base l g t i)) (opMain I base l hH f y (mainR g i t))
      = matAct f (blockMat ((G18.basisA base l g t).fam (tgtS l i))) (y (mainR g i t)) := by
  cases i
  · exact final_x0 I base l hH f y g t
  · exact final_y0 I base l hH f y g t
  · exact final_x1 I base l hH f y g t
  · exact final_y1 I base l hH f y g t
  · exact final_x2 I base l hH f y g t
  · exact final_y2 I base l hH f y g t
  · exact final_x3 I base l hH f y g t
  · exact final_y3 I base l hH f y g t
  · exact final_x4 I base l hH f y g t
  · exact final_y4 I base l hH f y g t
  · exact final_x5 I base l hH f y g t
  · exact final_y5 I base l hH f y g t
  · exact final_x6 I base l hH f y g t
  · exact final_y6 I base l hH f y g t
  · exact final_x7 I base l hH f y g t
  · exact final_y7 I base l hH f y g t
  · exact final_x8 I base l hH f y g t
  · exact final_y8 I base l hH f y g t
  · exact final_x9 I base l hH f y g t
  · exact final_y9 I base l hH f y g t
  · exact final_x10 I base l hH f y g t
  · exact final_y10 I base l hH f y g t
  · exact final_x11 I base l hH f y g t
  · exact final_y11 I base l hH f y g t
  · exact final_x12 I base l hH f y g t
  · exact final_y12 I base l hH f y g t
  · exact final_x13 I base l hH f y g t
  · exact final_y13 I base l hH f y g t
  · exact final_x14 I base l hH f y g t
  · exact final_y14 I base l hH f y g t
  · exact final_x15 I base l hH f y g t
  · exact final_y15 I base l hH f y g t

/-! ### the certificate -/

include hbase hH hOk in
/-- **The word with helper end sets `D q`** (`|D q|` at least the residual rank of slot `q`): the mixed certificate
with block targets `rawTz base l D`; price `rawCost` plus the helpers' end blocks. -/
theorem wordCert (D : Sl → Finset (LC (Fin 17) H l)) (hload : ∀ q, Fintype.card H - (I.ent q).dim ≤ (D q).card)
    (hrk : ∀ q, (D q).card - (Fintype.card H - (I.ent q).dim) < Fintype.card (LC (Fin 17) H l)) :
    ∃ w : GWord (LC (Fin 17) H l) (PRole (Orth (LC (Fin 17) H l)) T Sl C), w.Proper (Fintype.card (LC (Fin 17) H l)) ∧
      (∀ φ, w.costR φ = rawCost I l φ
        + (Fintype.card (Orth (LC (Fin 17) H l)) : ℝ) * 18 * ∑ q, bcost φ ((D q).card - (Fintype.card H - (I.ent q).dim))) ∧
      MX.GLiveKernelM (fun l' : PLive (Orth (LC (Fin 17) H l)) T Sl => (Sum.inl l' : (PRole (Orth (LC (Fin 17) H l)) T Sl C)))
        (fun l' => blockMat (rawTz base l D l').2) w := by
  have hfc : ∀ k : Fin 18, ∃ Zp : (Orth (LC (Fin 17) H l)) → Sl → CMat (LC (Fin 17) H l),
      (∀ d q, GReach 1 (Zp d q) (fun _ => 0)) ∧
      (∀ d q, GReach (G18.wnK I l hH k d q * Zp d q) (pk (D q))
        (fun φ => bcost φ ((D q).card - (Fintype.card H - (I.ent q).dim)))) :=
    fun k => P4L.fresh_call (G18.wnK I l hH k) (fun q => Fintype.card H - (I.ent q).dim)
      (fun d q => entW_form _ (I.ent q)) D hload hrk
  choose Zp hZ1 hZ2 using hfc
  obtain ⟨U, hU, Rpre⟩ := P4L.ORoute.steps (freshAll (Γ := (Orth (LC (Fin 17) H l))) (T := T) (Sl := Sl) (C := C))
    (fun _ => 1) (freshMat Zp) (fun _ _ => 0) (fun r hr => by
      obtain ⟨g, k, q, rfl⟩ := of_mem_freshAll hr
      exact hZ1 k g q _ (freshR g k q))
  obtain ⟨V, hV, Rpost⟩ := P4L.ORoute.steps (freshAll (Γ := (Orth (LC (Fin 17) H l))) (T := T) (Sl := Sl) (C := C))
    (fun r => freshMat (fun k => G18.wnK I l hH k) r * freshMat Zp r) (freshTgt D)
    (freshCost (fun q φ => bcost φ ((D q).card - (Fintype.card H - (I.ent q).dim)))) (fun r hr => by
      obtain ⟨g, k, q, rfl⟩ := of_mem_freshAll hr
      exact hZ2 k g q _ (freshR g k q))
  have Rsh := P4L.ORoute.steps_inv (mainAll (Γ := (Orth (LC (Fin 17) H l))) (T := T) (Sl := Sl) (C := C))
    (fun _ => 1) (fun _ => 1) (fun r => Binary.shift (cvecR (Sl := Sl) (C := C) base l r))
    (fun r _ => Matrix.mul_one 1) (fun _ _ => 0) (fun r _ => P4L.gstep_shift r _)
  have Rm := opMain_route (I := I) (base := base) (l := l) (hbase := hbase) (hH := hH) (hOk := hOk)
  obtain ⟨w, hw, hc, hwalk⟩ := ((Rpre.trans Rm).trans Rpost).trans Rsh
  refine ⟨w, hw, fun φ => (hc φ).trans ?_, ?_⟩
  · simp only [Finset.sum_const_zero, zero_add, add_zero, sum_freshAll]
  · intro f v hv l'
    rcases l' with ⟨g, i, t⟩ | ⟨g, k, q⟩
    · change gwalk f w v (mainR g i t) = matAct f (blockMat ((G18.basisA base l g t).fam (tgtS l i))) (v (mainR g i t))
      rw [hwalk f v]
      try dsimp only
      rw [if_pos (main_mem_mainAll (Sl := Sl) (C := C) g i t), if_neg (main_not_freshAll (Sl := Sl) (C := C) g i t),
        Matrix.mul_one]
      have ec : cvecR (Sl := Sl) (C := C) base l (mainR g i t) = cvec base l g t i := rfl
      rw [ec, final_main I base l hH f _ g i t]
      try dsimp only
      rw [if_neg (main_not_freshAll (Sl := Sl) (C := C) g i t)]
    · change gwalk f w v (freshR g k q) = matAct f (blockMat (FH.targ (D q))) (v (freshR g k q))
      rw [hwalk f v]
      try dsimp only
      rw [if_neg (fresh_not_mainAll (T := T) (C := C) g k q), if_pos (fresh_mem_freshAll (T := T) (C := C) g k q),
        opMain_fresh I base l hH f _ g k q]
      try dsimp only
      rw [if_pos (fresh_mem_freshAll (T := T) (C := C) g k q)]
      have eU : U (freshR g k q) = Zp k g q := by
        have h1 : U (freshR g k q) * 1 = Zp k g q := hU _ (fresh_mem_freshAll (T := T) (C := C) g k q)
        rw [Matrix.mul_one] at h1
        exact h1
      have eV : V (freshR g k q) * (G18.wnK I l hH k g q * Zp k g q) = pk (D q) :=
        hV _ (fresh_mem_freshAll (T := T) (C := C) g k q)
      rw [eU]
      simp only [matAct_mul, Matrix.mul_assoc]
      rw [eV, FH.pk_eq_targ]

include hbase hH hOk in
/-- **RAW** (no pad, no split): helpers end at their residual rank; price `rawCost`. -/
theorem rawCert (D : Sl → Finset (LC (Fin 17) H l)) (hD : ∀ q, (D q).card = Fintype.card H - (I.ent q).dim) :
    ∃ w : GWord (LC (Fin 17) H l) (PRole (Orth (LC (Fin 17) H l)) T Sl C), w.Proper (Fintype.card (LC (Fin 17) H l)) ∧ (∀ φ, w.costR φ = rawCost I l φ) ∧
      MX.GLiveKernelM (fun l' : PLive (Orth (LC (Fin 17) H l)) T Sl => (Sum.inl l' : (PRole (Orth (LC (Fin 17) H l)) T Sl C)))
        (fun l' => blockMat (rawTz base l D l').2) w := by
  obtain ⟨w, hw, hc, hk⟩ := wordCert (I := I) (base := base) (l := l) (hbase := hbase) (hH := hH) (hOk := hOk) D
    (fun q => (hD q).ge) (fun q => by rw [hD q, Nat.sub_self, G18.card_LC145 l hH]; norm_num)
  refine ⟨w, hw, fun φ => ?_, hk⟩
  rw [hc φ]
  have h0 : ∀ q, bcost φ ((D q).card - (Fintype.card H - (I.ent q).dim)) = 0 := fun q => by
    rw [hD q, Nat.sub_self, bcost_zero]
  simp only [h0, Finset.sum_const_zero, mul_zero, add_zero]

end Word

