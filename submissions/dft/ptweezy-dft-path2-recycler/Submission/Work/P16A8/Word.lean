  | _ => 0

def rawTz (D : Sl → Finset (LC (Fin 17) H l)) : PLive (Orth (LC (Fin 17) H l)) T Sl → Σ r : ℕ, (Fin r → Space (LC (Fin 17) H l))
  | .inl (g, (i, t)) => ⟨(tgtS l i).card, (G18.basisA base l g t).fam (tgtS l i)⟩
  | .inr (_, (_, q)) => ⟨(D q).card, FH.targ (D q)⟩

lemma rawTz_indep (D : Sl → Finset (LC (Fin 17) H l)) (l' : PLive (Orth (LC (Fin 17) H l)) T Sl) : LinearIndependent F (rawTz base l D l').2 := by
  rcases l' with ⟨g, i, t⟩ | ⟨g, k, q⟩
  · exact OBase.fam_indep (G18.basisA base l g t) (tgtS l i)
  · exact FH.targ_indep (D q)

lemma rawTz_fresh (D : Sl → Finset (LC (Fin 17) H l)) (g : Orth (LC (Fin 17) H l)) (k : Fin 18) (q : Sl) :
    (rawTz base l D (Sum.inr (g, (k, q)))).1 = (D q).card := rfl

/-- the paid blocks of ONE port (one gauge copy): the window blocks of the owners and the thin queries. -/
def portCost (φ : ℕ → ℝ) : ℝ := 2 * bcost φ 16 + 2 * bcost φ 24 + 2 * bcost φ 32 + 2 * bcost φ 40 + 2 * bcost φ 48 + 2 * bcost φ 56 + 2 * bcost φ 64 + 2 * bcost φ 72 + 2 * bcost φ 64 + 2 * bcost φ 56 + 2 * bcost φ 48 + 2 * bcost φ 40 + 2 * bcost φ 32 + 2 * bcost φ 24 + 2 * bcost φ 16 + 15 * bcost φ 1

/-- **the price of the raw word**. -/
def rawCost (φ : ℕ → ℝ) : ℝ :=
  18 * ((Fintype.card (Orth (LC (Fin 17) H l)) : ℝ) * I.cost φ)
    + (Fintype.card (Orth (LC (Fin 17) H l)) : ℝ) * (Fintype.card T : ℝ) * portCost φ

lemma prodF_S16_17 (f : ℕ) (A : OBase (LC (Fin 17) H l)) :
