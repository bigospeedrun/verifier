/-! ### the main roles end at their targets -/

theorem final_x0 (f : ℕ) (y : Data (LC (Fin 17) H l) (PRole (Orth (LC (Fin 17) H l)) T Sl C) f) (g : Orth (LC (Fin 17) H l)) (t : T) :
    matAct f (Binary.shift (cvec base l g t .x0)) (opMain I base l hH f y (mainR g .x0 t))
      = matAct f (blockMat ((G18.basisA base l g t).fam (tgtS l .x0))) (y (mainR g .x0 t)) := by
  have hq : qF base l f g t * qiF base l f g t = 1 := P4L.q_mul_qi f (G18.basisA base l g t) (Sum.inl l)
  have h := congrArg S32.x0
    ((opMain_view (I := I) (base := base) (l := l) (hH := hH) f y g t).trans (ctrl_diag _ _ _ hq _))
  change P4L.walsh f (opMain I base l hH f y (mainR g .x0 t)) = (P4L.prodF f (fun x => (P4L.fr (G18.basisA base l g t) {Sum.inl l} x)⁻¹) * P4L.prodF f (P4L.fr (G18.basisA base l g t) (G18.incr l 16)) * P4L.prodF f (P4L.fr (G18.basisA base l g t) (G18.incr l 17))) * P4L.walsh f (y (mainR g .x0 t)) at h
  apply P4L.normal_qi f (G18.basisA base l g t) (({Sum.inl l} : Finset (LC (Fin 17) H l)) ∪ G18.incr l 16 ∪ G18.incr l 17) (Sum.inl l)
  rw [h, P4L.qi_split, prodF_S16_17]
  ring

