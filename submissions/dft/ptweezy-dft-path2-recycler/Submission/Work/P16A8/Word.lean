def sg1 (f : ℕ) (y : Data (LC (Fin 17) H l) (PRole (Orth (LC (Fin 17) H l)) T Sl C) f) : Data (LC (Fin 17) H l) (PRole (Orth (LC (Fin 17) H l)) T Sl C) f :=
  multiAct f (stT (Sl := Sl) (C := C) (0 : Fin 18) (G18.basisA base l) (G18.setY l 0 ∪ {Sum.inl l} ∪ G18.incr l 0)
      (G18.setY l 0 ∪ G18.incr l 0) (G18.wnK I l hH 0))
    (point f (gFk (0 : Fin 18)) (multiAct f (stS' (0 : Fin 18) (G18.basisA base l) (G18.setY l 0 ∪ {Sum.inl l})
      (G18.setY l 0)) y))

