namespace SeamL2979Nb1
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL2979Nb1 = 1 - 1788704901/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L2979Nb1 (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL2979Nb1 (k i)) :=
  MX.L2979Nb1.EngineStmt.lift MX.L2979Nb1.engine cl m k v

