    have hu : Small b.size (fun i => 2^k i) := hn.small.mono fun i => (hw i).ge
    have hj : ∀ i, 2^k i*hillsL2979Nb1 (k i) ≤ W i := fun i => Nat.mul_le_mul (by rw [hw])
      (hillsL2979Nb1_mono (hg i))
