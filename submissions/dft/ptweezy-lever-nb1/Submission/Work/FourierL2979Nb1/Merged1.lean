theorem gleamTL2979Nb1 (hw : ∀ i,n i=2^k i) (hg : ∀ i,k i≤l i) (hn : b.Nick n) (hk : b.Nick k)
    (hI : b.Moves (fun _ => 0) sc fun _ => Complex.I)
    (hx : b.Moves n (a (c cl)) fun i => Tape.tab (n i) (x i)) :
    b.Moves (fun i => n i*hillsL2979Nb1 (l i)) (a (c cl)) fun i =>
      Tape.tab (n i) (gleam (k i) (x i)) := by
