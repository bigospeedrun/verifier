      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL2979Nb1_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL2979Nb1 hz (k i))

