      (fun i => 2^k i*hillsL2979Nb1 (k i)) :=
  SeamL2979Nb1.engine_L2979Nb1 cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL2979Nb1`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL2979Nb1 (z : ℝ) (hz : alphaL2979Nb1 ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
