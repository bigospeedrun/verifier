/-!
# (key: bridge-host-cross) The kernel checker of a cross-replica host table, split into pieces (core Lean only)

No Mathlib here: a piece module imports only this file and the data, so many pieces run in parallel at small memory.

Data of an instance (generated by p-a3/tools/mk_kdata.py from a host table in lg-a2a4's format v1):
* `CT`: a search tree of the `9 nR` calls `k = 9 ρ + l`; the leaf of call `k` carries `(row, tm, dp)`: the host
  indices of its `R` slots packed 20 bits each (`h = 2016 ρh + 224 c + 112 s + t`), its time in the global order and
  its provider word;
* `resT`: the residual of slot `q` under provider `p`, packed 4 bits each at `4 (1024 p + q)`;
* `rt`: a search tree of the host KINDS `κ = 9 ρh + c` (224 host bins each); the leaf of `κ` packs the remainders of
  its bins, 6 bits each;
* per piece (a range of host kinds): two streams of fixed-width fields packed into chunks: per bin its record count
  (4 bits) and the bin's records `(k, q)` (12 + 10 bits) sorted by `k`.
`chkPiece` checks, for every bin `i` of the piece: each record `(k, q)` has `row k` at `q` equal to `i`, `q < R`,
`k < 9 nR`, the calls of the bin strictly increase (one slot per call and host), the call's time lies in the host
kind's window (`lo = tm (9 ρh + kz c - 1) + 1` or `0`, `hi = tm (9 ρh + kz c + kK c - 1)`), and the residuals of the
records plus `rem` equal the rank of the kind; it returns the number of records read (`chkPieceCount`).
The decoders need no proof: the soundness lemma (TSchedK.lean) is about whatever records they produce.
Written by p-a3 (wht45/lever, 19 Oct 2026); prepared with assistance from Claude.  No `sorry`.
-/

namespace OAI.PowerSaving.XHostT.K

/-- a search tree of calls. -/
inductive CT where
  | leaf (row tm dp : Nat)
  | node (m : Nat) (l r : CT)

/-- the leaf of call `k`. -/
def CT.get : CT → Nat → Nat × Nat × Nat
  | .leaf a b c, _ => (a, b, c)
  | .node m l r, k => bif Nat.blt k m then l.get k else r.get k

/-- the host index of slot `q` in a packed row. -/
def rowAt (row q : Nat) : Nat := (row >>> (20 * q)) &&& 1048575

/-- the residual of slot `q` under provider `p`. -/
def resAt (resT p q : Nat) : Nat := (resT >>> (4 * (1024 * p + q))) &&& 15

/-- the first stage of the window of kind `c` (XHost.kz) and its length (XHost.kK), and the rank (XHost.rankOf). -/
def kzN (c : Nat) : Nat :=
  match c with
  | 0 => 0 | 1 => 2 | 2 => 0 | 3 => 4 | 4 => 0 | 5 => 6 | 6 => 3 | 7 => 5 | _ => 7
def kKN (c : Nat) : Nat :=
  match c with
  | 0 => 2 | 1 => 1 | 2 => 4 | 3 => 1 | 4 => 6 | 5 => 1 | 6 => 6 | 7 => 4 | _ => 2
def rkN (c : Nat) : Nat :=
  match c with
  | 0 => 16 | 1 => 8 | 2 => 32 | 3 => 8 | 4 => 48 | 5 => 8 | 6 => 48 | 7 => 32 | _ => 16

/-- a reader of fixed-width fields packed into chunks (`per` fields of `w` bits per chunk). -/
structure Rd where
  cs : List Nat
  cur : Nat
  left : Nat

def Rd.next (w per : Nat) : Rd → Nat × Rd
  | ⟨cs, cur, left + 1⟩ => (cur &&& (2 ^ w - 1), ⟨cs, cur >>> w, left⟩)
  | ⟨c :: cs, _, 0⟩ => (c &&& (2 ^ w - 1), ⟨cs, c >>> w, per - 1⟩)
  | ⟨[], _, 0⟩ => (0, ⟨[], 0, 0⟩)

def rdOf (cs : List Nat) : Rd := ⟨cs, 0, 0⟩

/-- the records of ONE bin `i` (window `[lo, hi]` of its kind): `n` records, calls from `kmin` on, residual `load` so
far; returns the final load (or `none` on a failure) and the reader. -/
def chkRecs (ct : CT) (resT NC R i lo hi : Nat) : (n : Nat) → (kmin load : Nat) → Rd → Option (Nat × Rd)
  | 0, _, load, rd => some (load, rd)
  | n + 1, kmin, load, rd =>
    let r := rd.next 22 128
    let k := r.1 &&& 4095
    let q := r.1 >>> 12
    let e := ct.get k
    bif Nat.ble kmin k && Nat.blt k NC && Nat.blt q R && Nat.beq (rowAt e.1 q) i && Nat.ble lo e.2.1 && Nat.ble e.2.1 hi
    then chkRecs ct resT NC R i lo hi n (k + 1) (load + resAt resT e.2.2 q) r.2
    else none

/-- the `n` bins `i, i + 1, ...` of ONE host kind (window `[lo, hi]`, rank `rk`, remainders packed in `rp`, 6 bits
each, bin `b` of the kind at `6 b`); `cnt` counts the records.  Every accumulator is compared at every bin, so the
kernel evaluates it at once (no long unevaluated chains). -/
def chkBins (ct : CT) (resT NC R lo hi rk rp : Nat) : (n : Nat) → (b i cnt : Nat) → Rd → Rd → Option (Nat × Rd × Rd)
  | 0, _, _, cnt, bs, rs => some (cnt, bs, rs)
  | n + 1, b, i, cnt, bs, rs =>
    let x := bs.next 4 512
    let m := x.1
    let rem := (rp >>> (6 * b)) &&& 63
    match chkRecs ct resT NC R i lo hi m 0 0 rs with
    | some (load, rs') =>
      bif Nat.beq (load + rem) rk && Nat.blt cnt 1099511627776 && Nat.blt i 1099511627776
      then chkBins ct resT NC R lo hi rk rp n (b + 1) (i + 1) (cnt + m) x.2 rs' else none
    | none => none

/-- the window of host kind `κ = 9 ρh + c`: `(lo, hi)`. -/
def winOf (ct : CT) (κ : Nat) : Nat × Nat :=
  let ρh := κ / 9
  let c := κ % 9
  let lo := bif Nat.beq (kzN c) 0 then 0 else (ct.get (9 * ρh + kzN c - 1)).2.1 + 1
  let hi := (ct.get (9 * ρh + kzN c + kKN c - 1)).2.1
  (lo, hi)

/-- the `n` host kinds `κ, κ + 1, ...` (224 bins each; remainders of kind `κ` in the leaf `rt.get κ`). -/
def chkKinds (ct rt : CT) (resT NC R : Nat) : (n : Nat) → (κ cnt : Nat) → Rd → Rd → Option Nat
  | 0, _, cnt, _, _ => some cnt
  | n + 1, κ, cnt, bs, rs =>
    let w := winOf ct κ
    match chkBins ct resT NC R w.1 w.2 (rkN (κ % 9)) (rt.get κ).1 224 0 (224 * κ) cnt bs rs with
    | some (cnt', bs', rs') => bif Nat.blt cnt' 1099511627776 then chkKinds ct rt resT NC R n (κ + 1) cnt' bs' rs' else none
    | none => none

/-- **one piece**: host kinds `κ0 .. κ0 + n - 1`; `some (number of records)` when every check passes. -/
def chkPieceCount (ct rt : CT) (resT NC R κ0 n : Nat) (binS recS : List Nat) : Option Nat :=
  chkKinds ct rt resT NC R n κ0 0 (rdOf binS) (rdOf recS)

/-- the global order: every call's time is below `NC`, the times are pairwise distinct (a bitset of `NC` bits), and
increase along the nine stages of every replica. -/
def chkOrder (ct : CT) (NC : Nat) : (n : Nat) → (k seen : Nat) → Bool
  | 0, _, _ => true
  | n + 1, k, seen =>
    let t := (ct.get k).2.1
    bif Nat.blt t NC && Nat.beq ((seen >>> t) &&& 1) 0 &&
        (Nat.beq (k % 9) 8 || Nat.blt t (ct.get (k + 1)).2.1)
    then chkOrder ct NC n (k + 1) (seen ||| (1 <<< t)) else false

end OAI.PowerSaving.XHostT.K
