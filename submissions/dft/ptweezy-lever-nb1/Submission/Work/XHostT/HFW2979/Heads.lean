set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 4000000
namespace OAI
namespace PowerSaving
namespace XHostTW
open Binary Matrix Finset RAM SS CB RF BR GF GX XHost XHostT
noncomputable section

section Heads
variable {H T Sl C α Γ : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C] [Fintype α] [DecidableEq α]
  [Fintype Γ] [DecidableEq Γ]
variable {nb nR : ℕ} {Ok : ∀ {β : Type} [Fintype β] [DecidableEq β], GWin H β → Prop}

/-- the head prefix acts on every role by its role product, which is the body network's pre-factor `hdT`. -/
lemma roleProd_heads_hdT (N : XNetHW H T Sl C α Γ nb nR Ok) (hb : Finset (Fin nR × Bool × T))
    (z : BLiveT Γ T nb nR → Fin 48 → Space α) (ind : ∀ l, LinearIndependent F (z l))
    (hhd : ∀ ρ g j, N.hd ρ g j = hdHF hb z ρ g j) (r : BRoleT Γ T nb C nR) :
    MX.roleProd (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR) (headsL hb) (fun _ => 48) z ind) r
      = N.hdT r := by
  rcases r with (l | ⟨g, c⟩)
  · rw [MX.roleProd_headWord_e Sum.inl_injective (headsL hb) (headsL_nodup hb)]
    rcases l with (⟨ρ, d⟩ | ⟨g, b⟩)
    · rcases d with ((((⟨g,t⟩|⟨g,t⟩)|(⟨g,t⟩|⟨g,t⟩))|(⟨g,t⟩|⟨g,t⟩))|(⟨g,t⟩|⟨g,t⟩))
      · split_ifs with h
        · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
          exact absurd e.symm (hroleT_ne_pair (p := 1) ⟨le_refl _, by norm_num⟩ false (g, t) g' p.2)
        · rfl
      · split_ifs with h
        · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
          exact absurd e.symm (hroleT_ne_pair (p := 1) ⟨le_refl _, by norm_num⟩ true (g, t) g' p.2)
        · rfl
      · split_ifs with h
        · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
          exact absurd e.symm (hroleT_ne_pair (p := 2) ⟨by norm_num, by norm_num⟩ false (g, t) g' p.2)
        · rfl
      · split_ifs with h
        · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
          exact absurd e.symm (hroleT_ne_pair (p := 2) ⟨by norm_num, by norm_num⟩ true (g, t) g' p.2)
        · rfl
      · split_ifs with h
        · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
          exact absurd e.symm (hroleT_ne_pair (p := 3) ⟨by norm_num, le_refl _⟩ false (g, t) g' p.2)
        · rfl
      · split_ifs with h
        · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
          exact absurd e.symm (hroleT_ne_pair (p := 3) ⟨by norm_num, le_refl _⟩ true (g, t) g' p.2)
        · rfl
      · show _ = N.hd ρ g (false, t)
        rw [hhd, hdHF]
        by_cases h : (ρ, (false, t)) ∈ hb
        · have h' := (mem_headsL_iff (Γ := Γ) (nb := nb) hb ρ g (false, t)).2 h
          exact (if_pos h').trans (if_pos h).symm
        · have h' : ¬ ((hroleT ρ g (false, t) : BLiveT Γ T nb nR) ∈ headsL hb) :=
            fun hh => h ((mem_headsL_iff hb ρ g (false, t)).1 hh)
          exact (if_neg h').trans (if_neg h).symm
      · show _ = N.hd ρ g (true, t)
        rw [hhd, hdHF]
        by_cases h : (ρ, (true, t)) ∈ hb
        · have h' := (mem_headsL_iff (Γ := Γ) (nb := nb) hb ρ g (true, t)).2 h
          exact (if_pos h').trans (if_pos h).symm
        · have h' : ¬ ((hroleT ρ g (true, t) : BLiveT Γ T nb nR) ∈ headsL hb) :=
            fun hh => h ((mem_headsL_iff hb ρ g (true, t)).1 hh)
          exact (if_neg h').trans (if_neg h).symm
    · split_ifs with h
      · obtain ⟨p, -, g', e⟩ := (mem_headsL hb _).1 h
        exact absurd e.symm (hroleT_ne_bank (g, b) p.1 g' p.2)
      · rfl
  · rw [MX.roleProd_headWord_off (e := (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)) (headsL hb) (fun _ => 48) z ind
      (Sum.inr (g, c)) (fun l h => by cases h)]
    rfl

/-- **The heads-first certificate of a network with head pre-factor**: if `hd` is the head block on the head bins
and `1` elsewhere, the head word followed by some proper `body` of price `card Γ * N.unit` is a certificate. -/
theorem XNetHW.heads_first (N : XNetHW H T Sl C α Γ nb nR Ok) (hb : Finset (Fin nR × Bool × T))
    (z : BLiveT Γ T nb nR → Fin 48 → Space α) (ind : ∀ l, LinearIndependent F (z l))
    (hhd : ∀ ρ g j, N.hd ρ g j = hdHF hb z ρ g j) :
    ∃ body : GWord α (BRoleT Γ T nb C nR), body.Proper (Fintype.card α) ∧
      (∀ φ, body.costR φ = (Fintype.card Γ : ℝ) * N.unit φ) ∧
      GLiveKernel (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (MX.headWord Sum.inl (headsL hb) (fun _ => 48) z ind ++ body) := by
  refine N.cert_pre _ (fun f x => ?_)
  funext r
  rw [MX.gwalk_local f _ (MX.roleLocal_headWord _ _ _ _ _)]
  show matAct f _ (matAct f (N.S0 r) (x r)) = matAct f (N.Ffr 0 r) (x r)
  rw [matAct_mul, N.Ffr0_eq r, roleProd_heads_hdT N hb z ind hhd r]



/-- **THE HEADS-FIRST CERTIFICATE (B1).**  p-a3's cross-replica network `N`, a set `hb` of A4 host bins that are
never hosted (`hunh`) and whose remaining climb is 48 (`h48`), and head directions `z` with which ONE block takes
each head's A4 start frame to its end frame up to a free step (`hz`): the head word (one rank-48 block per head role
and gauge, all first) followed by a proper `body` is a scratch certificate on the live roles, and the body costs
the network's price less the heads, for every price list. -/
theorem XNetW.heads_first (N : XNetW H T Sl C α Γ nb nR Ok) (hb : Finset (Fin nR × Bool × T))
    (hunh : ∀ ρ l q ρh j, (ρh, j) ∈ hb → N.hostAt ρ l q ≠ some (ρh, 4, j))
    (h48 : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ 4 j = 48)
    (z : BLiveT Γ T nb nR → Fin 48 → Space α) (ind : ∀ l, LinearIndependent F (z l))
    (hz : ∀ ρ j, (ρ, j) ∈ hb → ∀ g, GReach (blockMat (z (hroleT ρ g j)) * N.x0A4 g j) (N.x1A4 g j) (fun _ => 0)) :
    ∃ body : GWord α (BRoleT Γ T nb C nR), body.Proper (Fintype.card α) ∧
      (∀ φ, body.costR φ = (Fintype.card Γ : ℝ) * N.unit φ - ((headsL (Γ := Γ) (nb := nb) hb).length : ℝ) * φ 48) ∧
      GLiveKernel (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (MX.headWord Sum.inl (headsL hb) (fun _ => 48) z ind ++ body) := by
  obtain ⟨body, hP, hc, hk⟩ := (N.toHF hb z hunh hz).heads_first hb z ind (fun ρ g j => rfl)
  refine ⟨body, hP, fun φ => ?_, hk⟩
  rw [hc φ, N.unit_toHF hb z hunh hz h48, headsL_length]
  push_cast
  ring

/-- the same, with the whole word: `heads ++ body` is proper, and its price is the network's (the heads are the
network's own rank-48 climbs, moved to the front). -/
theorem XNetW.heads_first_full (N : XNetW H T Sl C α Γ nb nR Ok) (hb : Finset (Fin nR × Bool × T))
    (hunh : ∀ ρ l q ρh j, (ρh, j) ∈ hb → N.hostAt ρ l q ≠ some (ρh, 4, j))
    (h48 : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ 4 j = 48)
    (z : BLiveT Γ T nb nR → Fin 48 → Space α) (ind : ∀ l, LinearIndependent F (z l))
    (hz : ∀ ρ j, (ρ, j) ∈ hb → ∀ g, GReach (blockMat (z (hroleT ρ g j)) * N.x0A4 g j) (N.x1A4 g j) (fun _ => 0))
    (hα : 48 < Fintype.card α) :
    ∃ body : GWord α (BRoleT Γ T nb C nR), body.Proper (Fintype.card α) ∧
      (∀ φ, body.costR φ = (Fintype.card Γ : ℝ) * N.unit φ - ((headsL (Γ := Γ) (nb := nb) hb).length : ℝ) * φ 48) ∧
      GWord.Proper (Fintype.card α) (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (headsL hb) (fun _ => 48) z ind ++ body) ∧
      (∀ φ, GWord.costR φ (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (headsL hb) (fun _ => 48) z ind ++ body) = (Fintype.card Γ : ℝ) * N.unit φ) ∧
      GLiveKernel (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (MX.headWord Sum.inl (headsL hb) (fun _ => 48) z ind ++ body) := by
  obtain ⟨body, hP, hc, hk⟩ := N.heads_first hb hunh h48 z ind hz
  refine ⟨body, hP, hc, (headWord_proper _ z ind hα).append hP, fun φ => ?_, hk⟩
  rw [GWord.costR_append, headWord_costR, hc φ]
  ring

end Heads
