    have h' : dpChk n = true ∧ Nat.beq (ct.get n).2.2 ((D2979.dispKB >>> n) &&& 1) = true := by
      simpa [dpChk] using h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | rfl
    · exact ih h'.1 k hk
    · exact Nat.eq_of_beq_eq_true h'.2

/-- **the provider of call `(ρ, l)` in the host table is `D2979.disp (ρ, l)`**. -/
theorem dp_disp (ρ : Fin 74) (l : Fin 9) : (ct.get (9 * ρ.val + l.val)).2.2 = (D2979.disp (ρ, l)).val := by
