open OAI.PowerSaving.XHostT

/-- the provider of every call `k < n` of the tree is bit `k` of the dispatch table. -/
noncomputable def dpChk : Nat → Bool
  | 0 => true
  | n + 1 => dpChk n && Nat.beq (ct.get n).2.2 ((D2979.dispKB >>> n) &&& 1)

theorem dpChk_ok : dpChk 666 = true := by decide +kernel

theorem dpChk_sound : ∀ n, dpChk n = true → ∀ k < n, (ct.get k).2.2 = (D2979.dispKB >>> k) &&& 1 := by
  intro n
  induction n with
  | zero => intro _ k hk; exact absurd hk (Nat.not_lt_zero k)
