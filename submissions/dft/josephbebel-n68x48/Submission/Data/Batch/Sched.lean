def vCall (r j : Nat) : Nat := ((vis.getD r []).getD j (0, 0)).1
def vPort (r j : Nat) : Nat := ((vis.getD r []).getD j (0, 0)).2

def sig (r j : Nat) : Nat := vCall r j % 16
def slotOf (r c : Nat) : Nat := (sinv.getD r []).getD c 0
/-- cell `x = r*16+j` of `vis`, encoded as `τ*104+p`. -/
def gx (x : Nat) : Nat := vCall (x / 16) (x % 16) * 104 + vPort (x / 16) (x % 16)
/-- the inverse of `vis`: the cell visiting code `c = τ*104+p` (`gx` is a bijection on `[0, 4992)`,
see `gx_inj`/`gx_surj`; no `occ` table is stored). -/
def inv (c : Nat) : Nat := open Classical in if h : ∃ x, x < 4992 ∧ gx x = c then Classical.choose h else 0
def oRoot (τ p : Nat) : Nat := inv (τ * 104 + p) / 16
def oSlot (τ p : Nat) : Nat := inv (τ * 104 + p) % 16

/-! ### Kernel-cheap traversals
`List.getD` unfolds through `brecOn` in the kernel, and the original checks did
`(xs.getD r []).getD j _` inside `List.range` loops (quadratic in the 312 rows).
The checks below walk the outer lists once with explicit `List.rec` (carrying the
row index), and only do short in-row lookups via `lg` (explicit `List.rec`/`Nat.rec`,
cheap iota steps on literals).
Comparisons are `Nat.blt`/`Nat.beq`/`Nat.ble` (GMP-accelerated), not `decide` on `Prop`s;
`List.length`, `List.all`, `List.range` and list membership are avoided (all `brecOn`-heavy).
The bridging lemmas `lg_eq`, `allI_getD`, `all2_getD` turn them back into `getD`. -/

def lg {α : Type} (l : List α) (d : α) : Nat → α :=
  List.rec (motive := fun _ => Nat → α) (fun _ => d)
    (fun x _ ih n => Nat.rec (motive := fun _ => α) x (fun m _ => ih m) n) l

theorem lg_eq {α : Type} (d : α) : ∀ (l : List α) n, l.getD n d = lg l d n
  | [], _ => rfl
  | _ :: _, 0 => rfl
  | _ :: xs, n + 1 => by rw [List.getD_cons_succ, lg_eq d xs n]; rfl

/-- `allI f l n`: `f (n+i) l[i]` holds for every position `i`. -/
def allI {α : Type} (f : Nat → α → Bool) (l : List α) : Nat → Bool :=
  List.rec (motive := fun _ => Nat → Bool) (fun _ => true) (fun x _ ih n => f n x && ih (n + 1)) l

/-- `all2 f xs ys n`: walks `xs` and `ys` in lockstep (false if `ys` runs out first). -/
def all2 {α β : Type} (f : Nat → α → β → Bool) (xs : List α) : List β → Nat → Bool :=
  List.rec (motive := fun _ => List β → Nat → Bool) (fun _ _ => true)
    (fun x _ ih ys n => List.rec (motive := fun _ => Bool) false (fun y ys' _ => f n x y && ih ys' (n + 1)) ys) xs

theorem allI_getD' {α : Type} (f : Nat → α → Bool) (d : α) :
    ∀ (l : List α) (n : Nat), allI f l n = true → ∀ i < l.length, f (n + i) (l.getD i d) = true
  | [], _, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | x :: xs, n, h, i, hi => by
    have h' : (f n x && allI f xs (n + 1)) = true := h
    rw [Bool.and_eq_true] at h'
    cases i with
    | zero => exact h'.1
    | succ k =>
      have := allI_getD' f d xs (n + 1) h'.2 k (Nat.lt_of_succ_lt_succ hi)
      rw [List.getD_cons_succ, show n + (k + 1) = n + 1 + k by omega]; exact this

theorem allI_getD {α : Type} {f : Nat → α → Bool} (d : α) {l : List α} (h : allI f l 0 = true)
    {i : Nat} (hi : i < l.length) : f i (l.getD i d) = true := by
  have := allI_getD' f d l 0 h i hi; rwa [Nat.zero_add] at this

theorem all2_getD' {α β : Type} (f : Nat → α → β → Bool) (a : α) (b : β) :
    ∀ (xs : List α) (ys : List β) (n : Nat), all2 f xs ys n = true →
      ∀ i < xs.length, f (n + i) (xs.getD i a) (ys.getD i b) = true
  | [], _, _, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | _ :: _, [], _, h, _, _ => Bool.noConfusion h
  | x :: xs, y :: ys, n, h, i, hi => by
    have h' : (f n x y && all2 f xs ys (n + 1)) = true := h
    rw [Bool.and_eq_true] at h'
    cases i with
    | zero => exact h'.1
    | succ k =>
      have := all2_getD' f a b xs ys (n + 1) h'.2 k (Nat.lt_of_succ_lt_succ hi)
      rw [List.getD_cons_succ, List.getD_cons_succ, show n + (k + 1) = n + 1 + k by omega]; exact this

theorem all2_getD {α β : Type} {f : Nat → α → β → Bool} (a : α) (b : β) {xs : List α} {ys : List β}
    (h : all2 f xs ys 0 = true) {i : Nat} (hi : i < xs.length) : f i (xs.getD i a) (ys.getD i b) = true := by
  have := all2_getD' f a b xs ys 0 h i hi; rwa [Nat.zero_add] at this

/-- length by explicit `List.rec` (core `List.length` goes through `brecOn`). -/
def len {α : Type} (l : List α) : Nat := List.rec (motive := fun _ => Nat) 0 (fun _ _ ih => ih + 1) l
theorem len_eq {α : Type} : ∀ l : List α, len l = l.length
  | [] => rfl
  | _ :: xs => by rw [List.length_cons, ← len_eq xs]; rfl

/-- membership by explicit `List.rec` and `Nat.beq` (the `Decidable (· ∈ ·)` instance is slow in the kernel). -/
def memB (x : Nat) (l : List Nat) : Bool := List.rec (motive := fun _ => Bool) false (fun y _ ih => Nat.beq x y || ih) l
theorem memB_iff (x : Nat) : ∀ l : List Nat, memB x l = true ↔ x ∈ l
  | [] => by simp [memB]
  | y :: ys => by
    have e : memB x (y :: ys) = (Nat.beq x y || memB x ys) := rfl
    rw [e, Bool.or_eq_true, memB_iff x ys, Nat.beq_eq, List.mem_cons]

/-- `beqB a b = true ↔ (a = true ↔ b = true)`, written with `&&`/`||`/`!` only. -/
def beqB (a b : Bool) : Bool := (a && b) || (!a && !b)
theorem beqB_iff {a b : Bool} (h : beqB a b = true) : (a = true ↔ b = true) := by
  cases a <;> cases b <;> simp_all [beqB]

theorem getD_tail {α : Type} (d : α) : ∀ (l : List α) (i : Nat), l.tail.getD i d = l.getD (i + 1) d
  | [], _ => rfl
  | _ :: _, _ => rfl

theorem shape_ok : (Nat.beq (len vis) 312 && Nat.beq (len sinv) 312 &&
    allI (fun _ row => Nat.beq (len row) 16) vis 0 && allI (fun _ row => Nat.beq (len row) 16) sinv 0) = true := by
  decide +kernel

theorem shape : vis.length = 312 ∧ sinv.length = 312 ∧
    (∀ r < 312, (vis.getD r []).length = 16) ∧ (∀ r < 312, (sinv.getD r []).length = 16) := by
  have h := shape_ok
  simp only [Bool.and_eq_true, Nat.beq_eq, len_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h4⟩, h5⟩ := h
  refine ⟨h1, h2, fun r hr => ?_, fun r hr => ?_⟩
  · have := allI_getD [] h4 (by rw [h1]; exact hr); simpa only [Nat.beq_eq, len_eq] using this
  · have := allI_getD [] h5 (by rw [h2]; exact hr); simpa only [Nat.beq_eq, len_eq] using this

theorem vis_len : vis.length = 312 := shape.1
theorem vis_row_len (r : Nat) (hr : r < 312) : (vis.getD r []).length = 16 := shape.2.2.1 r hr
theorem sinv_row_len (r : Nat) (hr : r < 312) : (sinv.getD r []).length = 16 := shape.2.2.2 r hr

/-! Each check walks `vis` once, row by row and entry by entry, using only
`Nat.blt`/`Nat.beq`/`Nat.ble` and `&&`/`||` (all reduced natively by the kernel). -/

theorem range_ok : allI (fun _ row => allI (fun _ v => Nat.blt v.1 48 && Nat.blt v.2 104) row 0) vis 0 = true := by
  decide +kernel

/-- consecutive entries: walk `row.tail` against `row`. -/
theorem chrono_ok : allI (fun _ row => all2 (fun _ b a => Nat.blt a.1 b.1) row.tail row 0) vis 0 = true := by
  decide +kernel

theorem slot_ok : all2 (fun _ vrow srow => allI (fun c s => Nat.blt s 16 && Nat.beq ((lg vrow (0, 0) s).1 % 16) c) srow 0)
    vis sinv 0 = true := by decide +kernel

theorem slot_inv_ok : all2 (fun _ vrow srow => allI (fun j v => Nat.beq (lg srow 0 (v.1 % 16)) j) vrow 0)
    vis sinv 0 = true := by decide +kernel

theorem kind_ok : allI (fun r row => allI (fun j v =>
    beqB (memB v.2 bposS) (Nat.ble 120 r && (Nat.beq j 0 || Nat.beq j 15))) row 0) vis 0 = true := by decide +kernel

theorem range_P (r j : Nat) (hr : r < 312) (hj : j < 16) : vCall r j < 48 ∧ vPort r j < 104 := by
  have h := allI_getD (0, 0) (allI_getD [] range_ok (by rw [vis_len]; exact hr)) (by rw [vis_row_len r hr]; exact hj)
  simp only [Bool.and_eq_true, Nat.blt_eq] at h; exact h

theorem chrono_P (r j : Nat) (hr : r < 312) (hj : j < 15) : vCall r j < vCall r (j + 1) := by
  have h := all2_getD (0, 0) (0, 0) (allI_getD [] chrono_ok (by rw [vis_len]; exact hr))
    (by rw [List.length_tail, vis_row_len r hr]; omega)
  simp only [Nat.blt_eq, getD_tail] at h; exact h

theorem slot_P (r c : Nat) (hr : r < 312) (hc : c < 16) : slotOf r c < 16 ∧ sig r (slotOf r c) = c := by
  have h := allI_getD 0 (all2_getD [] [] slot_ok (by rw [vis_len]; exact hr)) (by rw [sinv_row_len r hr]; exact hc)
  simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq, ← lg_eq] at h; exact h

theorem slot_inv_P (r j : Nat) (hr : r < 312) (hj : j < 16) : slotOf r (sig r j) = j := by
  have h := allI_getD (0, 0) (all2_getD [] [] slot_inv_ok (by rw [vis_len]; exact hr)) (by rw [vis_row_len r hr]; exact hj)
  simp only [Nat.beq_eq, ← lg_eq] at h; exact h

/-! #### `vis` is a bijection onto the 4992 codes `τ*104+p`
`codes vis` lists `code` of every cell in order `r*16+j`; `distB` checks it has no repeats by
threading a bitmap `m` (one `Nat`, bit `c` set once code `c` was seen; GMP `lor`/`div`/`mod`/`pow`).
Then `gx` is injective on `[0, 4992)`, hence onto (pigeonhole), so `inv` is its inverse. -/

def code (v : Nat × Nat) : Nat := v.1 * 104 + v.2
def rowc (row : List (Nat × Nat)) (rest : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) rest (fun v _ ih => code v :: ih) row
def codes (rows : List (List (Nat × Nat))) : List Nat :=
  List.rec (motive := fun _ => List Nat) [] (fun row _ ih => rowc row ih) rows
def distB (cs : List Nat) : Nat → Bool :=
  List.rec (motive := fun _ => Nat → Bool) (fun _ => true)
    (fun c _ ih m => Nat.beq (m / Nat.pow 2 c % 2) 0 && ih (Nat.lor m (Nat.pow 2 c))) cs

theorem distinct_ok : (Nat.beq (len (codes vis)) 4992 && distB (codes vis) 0) = true := by decide +kernel

theorem distB_nodup : ∀ (cs : List Nat) (m : Nat), distB cs m = true → (∀ c ∈ cs, m.testBit c = false) ∧ cs.Nodup
  | [], _, _ => ⟨fun _ h => absurd h List.not_mem_nil, List.nodup_nil⟩
  | c :: cs, m, h => by
    have h' : (Nat.beq (m / Nat.pow 2 c % 2) 0 && distB cs (Nat.lor m (Nat.pow 2 c))) = true := h
    rw [Bool.and_eq_true, Nat.beq_eq] at h'
    obtain ⟨H, hn⟩ := distB_nodup cs _ h'.2
    have hb : ∀ d, (Nat.lor m (Nat.pow 2 c)).testBit d = (m.testBit d || (2 ^ c).testBit d) :=
      fun d => Nat.testBit_or m (2 ^ c) d
    refine ⟨fun d hd => ?_, List.nodup_cons.2 ⟨fun hc => ?_, hn⟩⟩
    · rcases List.mem_cons.1 hd with rfl | hd
      · rw [Nat.testBit_eq_decide_div_mod_eq]; have : m / 2 ^ d % 2 = 0 := h'.1; simp [this]
      · have := H d hd; rw [hb] at this; simp only [Bool.or_eq_false_iff] at this; exact this.1
    · have := H c hc; rw [hb, Nat.testBit_two_pow_self, Bool.or_true] at this; exact Bool.noConfusion this

theorem rowc_getD : ∀ (row : List (Nat × Nat)) (rest : List Nat) (i : Nat),
    (rowc row rest).getD i 0 = if i < row.length then code (row.getD i (0, 0)) else rest.getD (i - row.length) 0
  | [], _, _ => by simp [rowc]
  | v :: row, rest, 0 => by simp [rowc]
  | v :: row, rest, i + 1 => by
    have e : rowc (v :: row) rest = code v :: rowc row rest := rfl
    rw [e, List.getD_cons_succ, rowc_getD row rest i]
    simp only [List.length_cons, Nat.add_lt_add_iff_right, List.getD_cons_succ, Nat.add_sub_add_right]

theorem codes_getD : ∀ (rows : List (List (Nat × Nat))), (∀ r < rows.length, (rows.getD r []).length = 16) →
    ∀ r < rows.length, ∀ j < 16, (codes rows).getD (r * 16 + j) 0 = code ((rows.getD r []).getD j (0, 0))
  | [], _, r, hr, _, _ => absurd hr (Nat.not_lt_zero r)
  | row :: rows, hl, r, hr, j, hj => by
    have e : codes (row :: rows) = rowc row (codes rows) := rfl
    have h0 : row.length = 16 := hl 0 (by simp)
    rw [e, rowc_getD, h0]
    cases r with
    | zero => simp [hj]
    | succ k =>
      rw [ite_eq_right (by omega), show (k + 1) * 16 + j - 16 = k * 16 + j by omega, List.getD_cons_succ]
      exact codes_getD rows (fun r hr => hl (r + 1) (by simp; omega)) k (by simp at hr; omega) j hj

theorem gx_eq (x : Nat) (hx : x < 4992) : gx x = (codes vis).getD x 0 := by
  have := codes_getD vis (fun r hr => vis_row_len r (vis_len ▸ hr)) (x / 16) (by rw [vis_len]; omega) (x % 16)
    (Nat.mod_lt _ (by decide))
  rw [Nat.div_add_mod'] at this; rw [this]; rfl

theorem gx_inj {x y : Nat} (hx : x < 4992) (hy : y < 4992) (h : gx x = gx y) : x = y := by
  have hd := distinct_ok; rw [Bool.and_eq_true, Nat.beq_eq, len_eq] at hd
  have hn := (distB_nodup _ 0 hd.2).2
  rw [gx_eq x hx, gx_eq y hy, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
    List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)] at h
  exact (hn.getElem_inj_iff).1 (by simpa using h)

theorem gx_lt (x : Nat) (hx : x < 4992) : gx x < 4992 := by
  have := range_P (x / 16) (x % 16) (by omega) (Nat.mod_lt _ (by decide)); unfold gx; omega

theorem gx_surj (c : Nat) (hc : c < 4992) : ∃ x, x < 4992 ∧ gx x = c := by
  have hs : Function.Surjective (fun x : Fin 4992 => (⟨gx x, gx_lt x x.2⟩ : Fin 4992)) :=
    Finite.surjective_of_injective fun x y h => Fin.ext (gx_inj x.2 y.2 (congrArg Fin.val h))
  obtain ⟨x, hx⟩ := hs ⟨c, hc⟩
  exact ⟨x, x.2, congrArg Fin.val hx⟩

theorem inv_spec {c : Nat} (h : ∃ x, x < 4992 ∧ gx x = c) : inv c < 4992 ∧ gx (inv c) = c := by
  unfold inv; rw [dite_eq_left h]; exact Classical.choose_spec h

theorem occ_P (τ p : Nat) (hτ : τ < 48) (hp : p < 104) :
    oRoot τ p < 312 ∧ oSlot τ p < 16 ∧ vCall (oRoot τ p) (oSlot τ p) = τ ∧ vPort (oRoot τ p) (oSlot τ p) = p := by
  obtain ⟨h1, h2⟩ := inv_spec (gx_surj (τ * 104 + p) (by omega))
  have := range_P (inv (τ * 104 + p) / 16) (inv (τ * 104 + p) % 16) (by omega) (Nat.mod_lt _ (by decide))
  unfold gx at h2; unfold oRoot oSlot; omega

theorem vis_P (r j : Nat) (hr : r < 312) (hj : j < 16) :
    oRoot (vCall r j) (vPort r j) = r ∧ oSlot (vCall r j) (vPort r j) = j := by
  have e : gx (r * 16 + j) = vCall r j * 104 + vPort r j := by
    unfold gx; rw [show (r * 16 + j) / 16 = r by omega, show (r * 16 + j) % 16 = j by omega]
  obtain ⟨h1, h2⟩ := inv_spec ⟨r * 16 + j, by omega, e⟩
  have := gx_inj h1 (by omega) (h2.trans e.symm)
  unfold oRoot oSlot; rw [this]; omega

theorem kind_P (r j : Nat) (hr : r < 312) (hj : j < 16) : vPort r j ∈ bposS ↔ 120 ≤ r ∧ (j = 0 ∨ j = 15) := by
  have h := beqB_iff (allI_getD (0, 0) (allI_getD [] kind_ok (by rw [vis_len]; exact hr)) (by rw [vis_row_len r hr]; exact hj))
  rw [memB_iff] at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, Nat.ble_eq, Nat.beq_eq] at h; exact h

def call (r : Fin 312) (j : Fin 16) : Fin 48 := ⟨vCall r j, (range_P r j r.2 j.2).1⟩
def port (r : Fin 312) (j : Fin 16) : Fin 104 := ⟨vPort r j, (range_P r j r.2 j.2).2⟩
def colour (r : Fin 312) (j : Fin 16) : Fin 16 := ⟨sig r j, Nat.mod_lt _ (by decide)⟩
def slot (r : Fin 312) (c : Fin 16) : Fin 16 := ⟨slotOf r c, (slot_P r c r.2 c.2).1⟩
def owner (τ : Fin 48) (p : Fin 104) : Fin 312 × Fin 16 :=
  (⟨oRoot τ p, (occ_P τ p τ.2 p.2).1⟩, ⟨oSlot τ p, (occ_P τ p τ.2 p.2).2.1⟩)

theorem owner_visit (r : Fin 312) (j : Fin 16) : owner (call r j) (port r j) = (r, j) :=
  Prod.ext (Fin.ext (vis_P r j r.2 j.2).1) (Fin.ext (vis_P r j r.2 j.2).2)

theorem slot_colour (r : Fin 312) (j : Fin 16) : slot r (colour r j) = j := Fin.ext (slot_inv_P r j r.2 j.2)

end

