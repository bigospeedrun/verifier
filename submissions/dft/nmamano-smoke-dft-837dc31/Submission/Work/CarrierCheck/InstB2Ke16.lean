/-- **Per-rank from the tally of the certificate alone**: `c (r ↦ r) = G * (W m - D)`; no price formula. -/
theorem wht_perRank_of_tally {α ρ σ : Type} [Fintype α] [DecidableEq α] [Fintype ρ]
    [DecidableEq ρ] [Fintype σ] [DecidableEq σ]
    (hα : Fintype.card α = 80) (e : σ → ρ) (he : Function.Injective e)
    (G : ℕ) (hG : 1 ≤ G) (hσ : Fintype.card σ = G * (4 * cert.v + cert.R))
    (c : (ℕ → ℝ) → ℝ) (h : BCert α e c)
    (hT : c (fun r => (r:ℝ)) = (G:ℝ) * (((9362:ℕ):ℝ) * ((80:ℕ):ℝ) - ((1035:ℕ):ℝ))) :
    ∃ solve W, WHT.WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 31553/(10:ℝ)^8) W := by
  have hG0 : (G:ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  refine wht_perRank_of_price hα e he G hG hσ c h (fun φ => c φ / (G:ℝ)) (fun φ => ?_) ?_
  · field_simp
  · show c (fun r => (r:ℝ)) / (G:ℝ) = _
    rw [hT]
    field_simp

