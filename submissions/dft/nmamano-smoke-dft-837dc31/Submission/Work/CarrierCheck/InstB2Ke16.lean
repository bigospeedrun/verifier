theorem wht_perRank_of_price {α ρ σ : Type} [Fintype α] [DecidableEq α] [Fintype ρ]
    [DecidableEq ρ] [Fintype σ] [DecidableEq σ]
    (hα : Fintype.card α = 80) (e : σ → ρ) (he : Function.Injective e)
