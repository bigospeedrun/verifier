open Finset Binary Matrix RAM RAM.Ty CB FoldRate
noncomputable section
universe U

/-- the kernel-checked carrier certificate -/
abbrev cert : SSC.CCert := CarrierCr2h16.cert

theorem unit_live : 4 * cert.v + cert.R = 9362 := rfl

/-- price of ONE unit of the bridged word B_2, for a price list `φ` (idle climbs of the twins MERGED: per class 2 blocks each of rank `h-1`, `2h-2`, `2h+2`, `4`) -/
def unitPrice (φ : ℕ → ℝ) : ℝ :=
    5 * rcost φ cert.invRanks + (cert.v : ℝ) * BG.bankPrice cert.p.h φ

/-- **The unit price is the price of the unit block list** (per-invocation ranks counted by the kernel). -/
theorem unit_cost (φ : ℕ → ℝ) : unitPrice φ = listCost φ BlockAccounting.blocksB2Ke16 := by
  unfold unitPrice
  rw [CarrierCr2h16.ranks_cost φ]
  have hh : cert.p.h = 16 := rfl
  have hv : cert.v = 560 := rfl
  rw [hh, hv]
  simp only [BG.bankPrice, listCost, BlockAccounting.blocksB2Ke16, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil]
  norm_num [bcost]
  try ring

/-- one unit stands for `W * m - D` unit moves -/
theorem unit_tally : unitPrice (fun r => (r:ℝ)) = ((9362:ℕ):ℝ) * ((80:ℕ):ℝ) - ((1035:ℕ):ℝ) := by
  rw [unit_cost]
  exact BlockAccounting.blocksB2Ke16_tally

/-- **Whole-block engine at `1 - 53992/10^8` from a certificate of `G` units** (idle climbs of the twins MERGED: per class 2 blocks each of rank `h-1`, `2h-2`, `2h+2`, `4`; fill parameter `s = 13`). -/
theorem hills_of_bcert {α ρ σ : Type} [Fintype α] [DecidableEq α] [Fintype ρ]
    [DecidableEq ρ] [Fintype σ] [DecidableEq σ]
    (hα : Fintype.card α = 80) (e : σ → ρ) (he : Function.Injective e)
    (G : ℕ) (hG : 1 ≤ G) (hσ : Fintype.card σ = G * (4 * cert.v + cert.R))
    (c : (ℕ → ℝ) → ℝ) (h : BCert α e c)
    (hc : ∀ φ : ℕ → ℝ, c φ = (G:ℝ) * unitPrice φ)
    (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope (1 - 53992/(10:ℝ)^8) (k i)) :=
  engine_program_group_list 80 hα (by norm_num) e he G 9362 hG (by norm_num)
    (hσ.trans (by rw [unit_live])) c h
    BlockAccounting.blocksB2Ke16 (fun φ => by rw [hc, unit_cost]) 13 (1 - 53992/(10:ℝ)^8)
    (by norm_num) (by norm_num) BlockAccounting.fold_B2Ke16 cl m k v

/-- **Walsh-Hadamard transform at `1 - 53992/10^8` from a certificate of `G` units** (idle climbs of the twins MERGED: per class 2 blocks each of rank `h-1`, `2h-2`, `2h+2`, `4`). -/
theorem wht_of_bcert {α ρ σ : Type} [Fintype α] [DecidableEq α] [Fintype ρ]
    [DecidableEq ρ] [Fintype σ] [DecidableEq σ]
    (hα : Fintype.card α = 80) (e : σ → ρ) (he : Function.Injective e)
    (G : ℕ) (hG : 1 ≤ G) (hσ : Fintype.card σ = G * (4 * cert.v + cert.R))
    (c : (ℕ → ℝ) → ℝ) (h : BCert α e c)
    (hc : ∀ φ : ℕ → ℝ, c φ = (G:ℝ) * unitPrice φ) :
    ∃ solve W, WHT.WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 53992/(10:ℝ)^8) W :=
  BlockWHT.wht_main_of_engine (1 - 53992/(10:ℝ)^8) (by norm_num) (by norm_num)
    (fun k v => hills_of_bcert hα e he G hG hσ c h hc Paint.left false k v)

/-- **Sharpness, whole-block** (idle climbs of the twins MERGED: per class 2 blocks each of rank `h-1`, `2h-2`, `2h+2`, `4`): at exponent `1 - 53993/10^8` EVERY table of `K` copies of `G`
units and `p` idle roles has moment at least its number of live roles, so the moment criterion of the
block engine cannot give that exponent for this unit. -/
theorem table_sharp (K G p : ℕ) :
    (K:ℝ) * ((G:ℝ) * ((9362:ℕ):ℝ)) + (p:ℝ)
      ≤ (K:ℝ) * ((G:ℝ) * BlockAccounting.moment 80 (1 - 53993/(10:ℝ)^8) BlockAccounting.blocksB2Ke16)
        + (p:ℝ) * (BlockAccounting.T 80 (1 - 53993/(10:ℝ)^8) (80 - 1) 1
          + BlockAccounting.T 80 (1 - 53993/(10:ℝ)^8) 1 1) :=
  table_block_fails 80 9362 (by norm_num) (1 - 53993/(10:ℝ)^8) (by norm_num) _
    BlockAccounting.fold_B2Ke16_sharp K G p

/-- **Per-rank engine at `1 - 31553/10^8` from a certificate of `G` units, for ANY unit price `P`**: only the
tally `P (r ↦ r) = W m - D = 9362 * 80 - 1035` of the price is used (fill parameter `s = 13`). -/
