lemma fairwind_smallY (N : ι→ℕ) (hn : ∀ i,0<N i) (d : ℕ) :
    Small N fun i => fairwindY d (N i) := by
  have H := Small.self N
  have hX i := barge_spec (N i) (hn i)
  have h4 := (Small.const _ 4).mul H
  have hu := h4.mono (fun (i : ι) => stack_le (N i) (hn i))
  have hk : Small N fun i => harvestN (N i) :=
    (((Small.const _ 16).mul (hu.add (Small.const _ 4))).pow 2)
  have hh := ((Small.const _ 8).mul hk).mono
    (fun i => Nat.lt_two_pow_self.le.trans (orderE_small (N i)))
  have hi := ((((Small.const _ 20000000).mul ((hh.add (Small.const _ 1)).pow 2)).add
    (Small.const _ 7))).mono (fun i => score_le (orderE (N i)))
  have hp : Small N fun i => hillsY (barge (N i)).l :=
    (hu.add (Small.const _ 1)).mono fun i => (hillsY_le _).trans
      (Nat.add_le_add_right (hX i).count _)
  have hj := (hi.add (Small.const _ 1)).mul
    ((h4.mono fun i => (hX i).upper.le).mul hp)
  have hl := H.add hj |>.add ((hu.add (Small.const _ 2)).pow d)
  exact hl.add (((H.add (Small.const _ 2)).pow d).mono fun i => by split <;> omega)

-- package extracted charges
abbrev SizesY := {n : ℕ // 0<n}
abbrev entryY : SizesY→ℕ := Subtype.val

structure RationY where
  d : ℕ
  c : ℕ
  p : ℕ
def calorieY (a : RationY) (n : ℕ) := a.c*(fairwindY a.d n+1)

lemma BreezyY.ration {x : ι→T t} (h : b.BreezyY n t x) :
    ∃ (s : Prog m b.tray t) (a : RationY), ∀ i,
      (run s (b.env i)).OK (x i) (calorieY a (n i)) ((b.size i+2)^a.p) := by
  obtain ⟨d,hd⟩ := h
  obtain ⟨s,c,p,hc⟩ := Can.unfold_bound hd
  exact ⟨s,⟨d,c,p⟩,hc⟩

def lunchY (a b : RationY) (N : ℕ→ℕ) (n : ℕ) :=
  calorieY a (N n)+1+calorieY b (N n)

lemma storehouseY (N : ℕ→ℕ) (h : ∀ n,0<n → 0<N n) (g : Small entryY (fun i => N (entryY i)))
    (a b : RationY) : ∃ c : ℕ, ∀ n : ℕ, 0<n →
    let cap := (n+2)^c
    lunchY a b N n + 10*(n+2) ≤ cap ∧ (n+2)^a.p ≤ cap ∧ (n+2)^b.p ≤ cap ∧
    receipt (N n) ≤ cap := by
  let M i := N (entryY i)
  have H (a : RationY) : Small entryY (fun i => calorieY a (M i)) :=
    (Small.const _ a.c).mul (((fairwind_smallY M (fun i => h _ i.property) a.d).trans g).add
      (Small.const _ 1))
  have hu := (Small.self entryY).add (Small.const _ 2)
  have hh := (Small.const _ 10).mul hu
  have hp := ((Small.const _ 8).mul (g.pow 3)).mono
    (fun i => (receipt_bound _ (h _ i.property)).2.le)
  have ht := ((((H a).add (Small.const _ 1)).add (H b)).add hh)
  obtain ⟨c,hc⟩ := (((ht.max (hu.pow a.p)).max (hu.pow b.p)).max hp)
  refine ⟨c,fun n hn => ?_⟩
  specialize hc (⟨n,hn⟩:SizesY)
  have hx :
      max (max (max (lunchY a b N n + 10*(n+2)) ((n+2)^a.p)) ((n+2)^b.p)) (receipt (N n)) ≤
        (n+2)^c := hc
  have h1 := max_le_iff.mp hx
  have h2 := max_le_iff.mp h1.1
  have h3 := max_le_iff.mp h2.1
  exact ⟨h3.1,h3.2,h2.2,h1.2⟩

-- order environments
def onlyLengthY : Bench false SizesY := ⟨entryY,w,entryY⟩
lemma onlyLength_numY : onlyLengthY.Nick entryY := ⟨Can.id,Small.self _⟩

lemma orders1Y : ∃ (s : Prog false w w) (a : RationY), ∀ n,0<n →
    (run s n).OK (receipt n) (calorieY a n) ((n+2)^a.p) := by
  obtain ⟨s,a,ha⟩ := (onlyLength_numY.landOrderY (fun i => i.property)).ration
  exact ⟨s,a,fun i hi => ha ⟨i,hi⟩⟩
lemma orders2Y : ∃ (s : Prog false w w) (a : RationY), ∀ n,0<n →
    (run s n).OK (receipt (stretchY n)) (calorieY a (stretchY n)) ((n+2)^a.p) := by
  have H : onlyLengthY.Nick fun i => stretchY (entryY i) :=
    ((Nick.wc 2).mul onlyLength_numY).sub (Nick.wc 1)
  obtain ⟨s,a,ha⟩ := (H.landOrderY (fun i => stretch_posY i.property)).ration
  exact ⟨s,a,fun i hi => ha ⟨i,hi⟩⟩

def towerOneY : Bench false (SizesY×Line) :=
  ⟨fun i => entryY i.1,dftInKind,fun i =>
    (entryY i.1, root (receipt (entryY i.1)),Tape.tab (entryY i.1) i.2)⟩

lemma executeOneY : ∃ (s : Prog false dftInKind dftOutKind) (a : RationY),
    ∀ (n : ℕ),0<n → ∀ x : Vec n,
    (run s (n, root (receipt n), (⟨n,x⟩ : Tape ℂ))).OK
      (⟨n, dft n x⟩ : Tape ℂ) (calorieY a n) ((n+2)^a.p) := by
  let K := towerOneY
  have ht : K.Moves (fun _ => 0) dftInKind K.env := envNow K
  let n (i : SizesY × Line) := entryY i.1
  have hk : K.Nick n := ⟨ht.fst,Small.self _⟩
  have H := hk.landY (fun i => i.1.property) (ht.snd.fst) false (x:=Prod.snd) (cl:=Paint.left)
    (ht.snd.snd)
  obtain ⟨s,a,ha⟩ := H.ration
  refine ⟨s,a,fun n hn x => ?_⟩
  specialize ha ((⟨n,hn⟩:SizesY),extendLine x)
  change (run s (n,root (receipt n),(⟨n,front n (extendLine x)⟩:Tape ℂ))).OK
    (⟨n,front n (freq n (pr false n) (extendLine x))⟩ : Tape ℂ) _ _ at ha
  rw [← dft_front n,front_exact] at ha
  exact ha

def towerBothY : Bench true (SizesY×Line×Line) :=
  ⟨fun i => entryY i.1,convInKind,fun i =>
    (entryY i.1, root (receipt (stretchY (entryY i.1))),Tape.tab (entryY i.1) i.2.1,
      Tape.tab (entryY i.1) i.2.2)⟩

lemma executeBothY : ∃ (s : Prog true convInKind convOutKind) (a : RationY),
    ∀ (n : ℕ),0<n → ∀ x y : Vec n,
    (run s (n, root (receipt (stretchY n)), (⟨n,x⟩ : Tape ℂ),(⟨n,y⟩ : Tape ℂ))).OK
      (⟨stretchY n, conv n x y⟩ : Tape ℂ) (calorieY a (stretchY n)) ((n+2)^a.p) := by
  let K := towerBothY
  have ht : K.Moves (fun _ => 0) convInKind K.env := envNow K
  let n (i : SizesY × Line×Line) := entryY i.1
  have hk : K.Nick n := ⟨ht.fst,Small.self _⟩
  have H := fusingY hk (fun i => i.1.property) (x:=fun i => i.2.1) (y:=fun i => i.2.2)
    ht.snd.snd.fst ht.snd.snd.snd ht.snd.fst
  obtain ⟨s,a,ha⟩ := H.ration
  refine ⟨s,a,fun n hn x y => ?_⟩
  specialize ha ((⟨n,hn⟩:SizesY),extendLine x,extendLine y)
  change (run s (n,root (receipt (stretchY n)),
    (⟨n,front n (extendLine x)⟩:Tape ℂ),(⟨n,front n (extendLine y)⟩:Tape ℂ))).OK
    (⟨2*n-1,front (2*n-1)
      (cyclic (2*n-1) (padline n (extendLine y)) (padline n (extendLine x)))⟩ : Tape ℂ) _ _ at ha
  rw [cyclic_pad_front,front_exact,front_exact] at ha
  exact ha

theorem flagshipOneY : ∃ order solve a b,
    DFTProgram order solve (lunchY a b id) ∧
    ∀ n, 0<n → (run order n).val = receipt n := by
  obtain ⟨o,a,ho⟩ := orders1Y
  obtain ⟨s,b,hs⟩ := executeOneY
  obtain ⟨c,hc⟩ := storehouseY id (fun _ h => h) (Small.self entryY) a b
  refine ⟨o,s,a,b,⟨c,fun n hn => ?_⟩,fun n hn => (ho n hn).result⟩
  obtain ⟨hu,hA,hB,hR⟩ := hc n hn
  have H := ho n hn
  have HH := receipt_bound n hn
  have he := H.result
  refine ⟨hu,H.bound.trans hA,H.valid,he.symm ▸ HH.1,he.symm ▸ ?_,he.symm ▸ hR,fun x => ?_⟩
  · exact HH.2.trans_le (by omega)
  dsimp only
  rw [he]
  have hj := hs n hn x
  exact ⟨hj.valid,hj.bound.trans hB,add_le_add (add_le_add_left H.time 1) hj.time,hj.result⟩

theorem flagshipBothY : ∃ order solve a b,
    ConvProgram order solve (lunchY a b stretchY) ∧
    ∀ n, 0<n → (run order n).val = receipt (stretchY n) := by
  obtain ⟨o,a,ho⟩ := orders2Y
  obtain ⟨s,b,hs⟩ := executeBothY
  obtain ⟨c,hc⟩ := storehouseY stretchY (fun _ h => stretch_posY h)
    (((Small.const _ 2).mul (Small.self entryY)).sub (Q:=fun _ => 1)) a b
  refine ⟨o,s,a,b,⟨c,fun n hn => ?_⟩,fun n hn => (ho n hn).result⟩
  obtain ⟨hu,hA,hB,hR⟩ := hc n hn
  have H := ho n hn
  have HH := receipt_bound _ (stretch_posY hn)
  have he := H.result
  refine ⟨hu,H.bound.trans hA,H.valid,he.symm ▸ HH.1,he.symm ▸ ?_,he.symm ▸ hR,fun x y => ?_⟩
  · exact HH.2.trans_le (by unfold stretchY; omega)
  dsimp only
  rw [he]
  have hj := hs n hn x y
  exact ⟨hj.valid,hj.bound.trans hB,add_le_add (add_le_add_left H.time 1) hj.time,hj.result⟩

