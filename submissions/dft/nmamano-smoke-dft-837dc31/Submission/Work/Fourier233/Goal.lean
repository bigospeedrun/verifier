namespace OAI

namespace PowerSaving
noncomputable section
open RAM RAM.Ty Filter Asymptotics

def decimalExponentY : ℝ := 1 - 7547360/(10^(10:ℕ))

def decimalTimeY (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentY

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsY (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeY ∧ W' =o[atTop] nlogn

def DFTGoalY : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsY W

def ConvGoalY : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsY W

end
end PowerSaving

end OAI
