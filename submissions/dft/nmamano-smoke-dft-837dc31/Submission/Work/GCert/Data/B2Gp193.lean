import Submission.Work.GCert.Chain.End
import Submission.Work.GCert.Data.Glue
import Submission.Work.GCert.Data.P193Cert
import Submission.Work.GCert.Data.InstB2Gp193

/-!
# (key: gx-data) Bridged word B_2 with the gcert/1 circuit `P193` (h = 22, m = 110): final theorems over a scalar half
GENERATED by checks/wht26/gx-data/py/gxrate.py.  No `sorry`.
`GX.wht_of_halves` (gx-chain) on the label half `GXD.P193.valid` (kernel checks of `Work/GCert/Data/Gen/P193*`), its
price `GXD.P193.lab_price`, the unit list `BlockAccounting.blocksB2Gp193` (`W = 14692` live roles) and the rate facts
`fold_B2Gp193` (`1 - 74745/10^8`), `fold_B2Gp193x` (`1 - 7474547/10^10`).
The ONLY hypothesis left is the scalar half: `S : GX.Scal (Fin 1320) (Fin 9412) C` whose gate matrices are the ordered
products of the adds of `raw` (`hMA .. hMBi`), with `22` copies read from the retained registers (`reg`, `hCc`, `hreg`, `hC`);
`wht_B2Gp193_of_ids`, `wht_B2Gp193x_of_ids`: the same from the five identities `hAi hBi hx hy hid` of gx-scalar's matrices
`GS.MA GS.MAi GS.MB GS.MBi GS.Jrm GS.Ccm` of `raw` (the fields of the planned `GS.ScalOK`).
-/

namespace OAI
namespace PowerSaving
namespace WHT
open BlockWHT

variable {C : Type} [Fintype C] [DecidableEq C] (S : GX.Scal (Fin GXD.P193.raw.v) (Fin GXD.P193.raw.R) C)
  {emb : CR.L3 (Fin GXD.P193.raw.v) (Fin GXD.P193.raw.R) → Nat} {un : Nat → CR.L3 (Fin GXD.P193.raw.v) (Fin GXD.P193.raw.R)}
  (cf : GXD.Co → SSC.Coef)

/-- **Walsh-Hadamard transform, whole-block recursion on the bridged word B_2 with the gcert/1 circuit `P193`**,
over any scalar half of `GXD.P193.raw`: the statement `WHTGoal` of `WHTCheck/Challenge.lean` with `1 - 2/10^11`
replaced by `1 - 74745/10^8`. -/
theorem wht_B2Gp193_of_scal (Ro : GLab.Roles GXD.P193.raw.v GXD.P193.raw.R emb un)
    (hMA : S.MA = SSC.matP un (GLab.mic cf (GXD.P193.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMAi : S.MAi = SSC.matPinv un (GLab.mic cf (GXD.P193.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMB : S.MB = SSC.matP un (GLab.mic cf (GXD.P193.raw.gatesB.flatMap GXD.Gate.adds)))
    (hMBi : S.MBi = SSC.matPinv un (GLab.mic cf (GXD.P193.raw.gatesB.flatMap GXD.Gate.adds)))
    (reg : C → Nat) (hCc : ∀ k (q : Fin GXD.P193.raw.R), S.Cc k q ≠ 0 → reg k = 2 * GXD.P193.raw.v + q.val)
    (hreg : ∀ k, reg k ∈ GXD.P193.raw.ret.map Prod.fst) (hC : Fintype.card C = 22) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 74745/(10:ℝ)^8) W :=
  GX.wht_of_halves S (GXD.P193.valid.lab S Ro cf hMA hMAi hMB hMBi reg hCc hreg)
    (by rw [Fintype.card_fin]; decide) 110 14692 (by rw [Fintype.card_fin]; rfl)
    (by rw [Fintype.card_fin, Fintype.card_fin]; rfl) (by norm_num) BlockAccounting.blocksB2Gp193
    (fun φ => by
      rw [GXD.P193.lab_price S Ro cf hMA hMAi hMB hMBi reg hCc hreg hC φ, Fintype.card_fin, Fintype.card_fin]
      exact BridgeRate.B2Gp193.unit_cost φ)
    13 (1 - 74745/(10:ℝ)^8) (by norm_num) (by norm_num) BlockAccounting.fold_B2Gp193

/-- the same from the FIVE scalar identities of gx-scalar's matrices of `GXD.P193.raw` (`Work/GCert/Data/Glue.lean`) -/
theorem wht_B2Gp193_of_ids (hv : 0 < GXD.P193.raw.v)
    (hAi : GS.MAi GXD.P193.raw hv * GS.MA GXD.P193.raw hv = 1) (hBi : GS.MBi GXD.P193.raw hv * GS.MB GXD.P193.raw hv = 1)
    (hx : ∀ (t : Fin GXD.P193.raw.v) (j : GS.Rl GXD.P193.raw), (GS.MB GXD.P193.raw hv * CR.scatM (GS.Jrm GXD.P193.raw * GS.Ccm GXD.P193.raw)
      * GS.MA GXD.P193.raw hv) (CR.lX t) j = if CR.lX t = j then 1 else 0)
    (hy : ∀ (i : GS.Rl GXD.P193.raw) (t : Fin GXD.P193.raw.v), (GS.MB GXD.P193.raw hv * CR.scatM (GS.Jrm GXD.P193.raw * GS.Ccm GXD.P193.raw)
      * GS.MA GXD.P193.raw hv) i (CR.lY t) = if i = CR.lY t then 1 else 0)
    (hid : ∀ S t : Fin GXD.P193.raw.v, (GS.MB GXD.P193.raw hv * CR.scatM (GS.Jrm GXD.P193.raw * GS.Ccm GXD.P193.raw)
      * GS.MA GXD.P193.raw hv) (CR.lY S) (CR.lX t) = if S = t then 1 else 0) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 74745/(10:ℝ)^8) W :=
  wht_B2Gp193_of_scal (GXD.scalOf GXD.P193.raw hv hAi hBi hx hy hid) GS.toCoef (GXD.roles GXD.P193.raw hv)
    (GXD.scalOf_MA _ hv hAi hBi hx hy hid) (GXD.scalOf_MAi _ hv hAi hBi hx hy hid)
    (GXD.scalOf_MB _ hv hAi hBi hx hy hid) (GXD.scalOf_MBi _ hv hAi hBi hx hy hid)
    (GXD.reg GXD.P193.raw) (GXD.reg_slot GXD.P193.raw hv hAi hBi hx hy hid) (GXD.reg_mem GXD.P193.raw)
    (by rw [Fintype.card_fin]; decide)

/-- **Walsh-Hadamard transform, whole-block recursion on the bridged word B_2 with the gcert/1 circuit `P193`**,
over any scalar half of `GXD.P193.raw`: the statement `WHTGoal` of `WHTCheck/Challenge.lean` with `1 - 2/10^11`
replaced by `1 - 7474547/10^10`. -/
theorem wht_B2Gp193x_of_scal (Ro : GLab.Roles GXD.P193.raw.v GXD.P193.raw.R emb un)
    (hMA : S.MA = SSC.matP un (GLab.mic cf (GXD.P193.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMAi : S.MAi = SSC.matPinv un (GLab.mic cf (GXD.P193.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMB : S.MB = SSC.matP un (GLab.mic cf (GXD.P193.raw.gatesB.flatMap GXD.Gate.adds)))
    (hMBi : S.MBi = SSC.matPinv un (GLab.mic cf (GXD.P193.raw.gatesB.flatMap GXD.Gate.adds)))
    (reg : C → Nat) (hCc : ∀ k (q : Fin GXD.P193.raw.R), S.Cc k q ≠ 0 → reg k = 2 * GXD.P193.raw.v + q.val)
    (hreg : ∀ k, reg k ∈ GXD.P193.raw.ret.map Prod.fst) (hC : Fintype.card C = 22) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 7474547/(10:ℝ)^10) W :=
  GX.wht_of_halves S (GXD.P193.valid.lab S Ro cf hMA hMAi hMB hMBi reg hCc hreg)
    (by rw [Fintype.card_fin]; decide) 110 14692 (by rw [Fintype.card_fin]; rfl)
    (by rw [Fintype.card_fin, Fintype.card_fin]; rfl) (by norm_num) BlockAccounting.blocksB2Gp193x
    (fun φ => by
      rw [GXD.P193.lab_price S Ro cf hMA hMAi hMB hMBi reg hCc hreg hC φ, Fintype.card_fin, Fintype.card_fin]
      exact BridgeRate.B2Gp193.unit_cost_x φ)
    40 (1 - 7474547/(10:ℝ)^10) (by norm_num) (by norm_num) BlockAccounting.fold_B2Gp193x

/-- the same from the FIVE scalar identities of gx-scalar's matrices of `GXD.P193.raw` (`Work/GCert/Data/Glue.lean`) -/
theorem wht_B2Gp193x_of_ids (hv : 0 < GXD.P193.raw.v)
    (hAi : GS.MAi GXD.P193.raw hv * GS.MA GXD.P193.raw hv = 1) (hBi : GS.MBi GXD.P193.raw hv * GS.MB GXD.P193.raw hv = 1)
    (hx : ∀ (t : Fin GXD.P193.raw.v) (j : GS.Rl GXD.P193.raw), (GS.MB GXD.P193.raw hv * CR.scatM (GS.Jrm GXD.P193.raw * GS.Ccm GXD.P193.raw)
      * GS.MA GXD.P193.raw hv) (CR.lX t) j = if CR.lX t = j then 1 else 0)
    (hy : ∀ (i : GS.Rl GXD.P193.raw) (t : Fin GXD.P193.raw.v), (GS.MB GXD.P193.raw hv * CR.scatM (GS.Jrm GXD.P193.raw * GS.Ccm GXD.P193.raw)
      * GS.MA GXD.P193.raw hv) i (CR.lY t) = if i = CR.lY t then 1 else 0)
    (hid : ∀ S t : Fin GXD.P193.raw.v, (GS.MB GXD.P193.raw hv * CR.scatM (GS.Jrm GXD.P193.raw * GS.Ccm GXD.P193.raw)
      * GS.MA GXD.P193.raw hv) (CR.lY S) (CR.lX t) = if S = t then 1 else 0) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 7474547/(10:ℝ)^10) W :=
  wht_B2Gp193x_of_scal (GXD.scalOf GXD.P193.raw hv hAi hBi hx hy hid) GS.toCoef (GXD.roles GXD.P193.raw hv)
    (GXD.scalOf_MA _ hv hAi hBi hx hy hid) (GXD.scalOf_MAi _ hv hAi hBi hx hy hid)
