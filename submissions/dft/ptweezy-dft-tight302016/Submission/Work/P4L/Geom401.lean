def gaugeE : ℕ → T → Orth (LC (Fin 8) H l) ≃ Orth (LC (Fin 8) H l)
  | 0 => fun _ => Equiv.refl _
  | 1 => fun t => RrC (base t) l (0 : Fin 8)
  | 2 => fun t => RrC (base t) l (1 : Fin 8)
  | 3 => fun t => RrC (base t) l (2 : Fin 8)
  | 4 => fun t => RrC (base t) l (3 : Fin 8)
  | 5 => fun t => RrC (base t) l (4 : Fin 8)
  | 6 => fun t => RrC (base t) l (5 : Fin 8)
  | 7 => fun t => RrC (base t) l (6 : Fin 8)
  | 8 => fun t => RrC (base t) l (7 : Fin 8)
  | _ => fun _ => Equiv.refl _

lemma stage0_Xin (t : T) (g : Orth (LC (Fin 8) H l)) :
    PhiC g ∅ (tt ((base t).v l)) = frame (BBC (base t) l g) (setX l 0) := by
  exact classT_X0 (base t) l g

lemma stage0_Xout (t : T) (g : Orth (LC (Fin 8) H l)) :
