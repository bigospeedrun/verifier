/-!
# P4-L, part 5: the nine stage windows of the #401 geometry at one port, in ONE basis

Generated by p3-port/py/gen_geom401.py; do not edit.  At port `t` and gauge `g` every frame of the nine stage
windows (`win401N l hH k`, the leader's conjugation windows with gauges `RrC (base t) l (k-1) g`) is a coordinate
frame of the basis `A = BBC (base t) l g`:

    stage k, X in  : frame A (setX k)       X out : frame A (setX (k+1))
    stage k, Y in  : frame A (setY k)       Y out : frame A (setY (k+1))

with `setX (k+1) = setX k ∪ incr k`, `setY (k+1) = setY k ∪ incr k` (disjoint) and `setX k = setY k ∪ {pivot}`.
So the stage transform is ONE function `fr A (incr k)` for both sides of a pair, and the port translation is
`fr A {pivot}` at every stage (the controller's `d k` and `q`).  From the leader's Work/BridgeC/Stage lemmas.
No `sorry`.
-/

set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

namespace OAI
namespace PowerSaving
namespace P4L
open Binary Matrix Finset RAM SS CB RF BC GX GF

noncomputable section

section Sets
variable {H : Type} [Fintype H] [DecidableEq H] (l : H)

/-- the X index set at the start of stage `k` (`k = 9`: after the last stage). -/
def setX : ℕ → Finset (LC (Fin 8) H l)
  | 0 => JC {l} ∅
  | 1 => JC univ ∅
  | 2 => JC univ (qC GX.bs401_1)
  | 3 => JC univ (qC GX.bs401_2)
  | 4 => JC univ (qC GX.bs401_3)
  | 5 => JC univ (qC GX.bs401_4)
  | 6 => JC univ (qC GX.bs401_5)
  | 7 => JC univ (qC GX.bs401_6)
  | 8 => JC univ (qC GX.bs401_7)
  | 9 => JC univ (qC GX.bs401_8)
  | _ => JC univ (qC univ)

/-- the Y index set at the start of stage `k`. -/
def setY : ℕ → Finset (LC (Fin 8) H l)
  | 0 => JC ∅ ∅
  | 1 => JC (univ \ {l}) ∅
  | 2 => JC (univ \ {l}) (qC GX.bs401_1)
  | 3 => JC (univ \ {l}) (qC GX.bs401_2)
  | 4 => JC (univ \ {l}) (qC GX.bs401_3)
  | 5 => JC (univ \ {l}) (qC GX.bs401_4)
  | 6 => JC (univ \ {l}) (qC GX.bs401_5)
  | 7 => JC (univ \ {l}) (qC GX.bs401_6)
  | 8 => JC (univ \ {l}) (qC GX.bs401_7)
  | 9 => JC (univ \ {l}) (qC GX.bs401_8)
  | _ => JC (univ \ {l}) (qC univ)

/-- the lines a stage adds (both sides). -/
def incr : ℕ → Finset (LC (Fin 8) H l)
  | 0 => JC (univ \ {l}) ∅
  | 1 => JC ∅ (qC {(0 : Fin 8)})
  | 2 => JC ∅ (qC {(1 : Fin 8)})
  | 3 => JC ∅ (qC {(2 : Fin 8)})
  | 4 => JC ∅ (qC {(3 : Fin 8)})
  | 5 => JC ∅ (qC {(4 : Fin 8)})
  | 6 => JC ∅ (qC {(5 : Fin 8)})
  | 7 => JC ∅ (qC {(6 : Fin 8)})
  | 8 => JC ∅ (qC {(7 : Fin 8)})
  | _ => ∅

lemma JC_mem_inl (s : Finset H) (q : Finset (Fin 8 × Hp H l)) (h : H) :
    (Sum.inl h : LC (Fin 8) H l) ∈ JC s q ↔ h ∈ s := Finset.inl_mem_disjSum

lemma JC_mem_inr (s : Finset H) (q : Finset (Fin 8 × Hp H l)) (b : Fin 8 × Hp H l) :
    (Sum.inr b : LC (Fin 8) H l) ∈ JC s q ↔ b ∈ q := Finset.inr_mem_disjSum

/-- adding block `c` to the blocks of an index set. -/
lemma JC_qC_insert (s : Finset H) (bs : Finset (Fin 8)) (c : Fin 8) :
    JC s (qC (l := l) (insert c bs)) = JC s (qC bs) ∪ JC ∅ (qC {c}) := by
  ext x
  rcases x with h | ⟨b, j⟩
  · simp only [Finset.mem_union, JC_mem_inl, Finset.notMem_empty, or_false]
  · simp only [Finset.mem_union, JC_mem_inr, mem_qC, Finset.mem_insert, Finset.mem_singleton]
    tauto

lemma JC_qC_disj (s : Finset H) (bs : Finset (Fin 8)) (c : Fin 8) (hc : c ∉ bs) :
    Disjoint (JC s (qC (l := l) bs)) (JC ∅ (qC {c})) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  rcases x with h | ⟨b, j⟩
  · rw [JC_mem_inl] at hy; exact Finset.notMem_empty h hy
  · rw [JC_mem_inr, mem_qC] at hx hy
    rw [Finset.mem_singleton] at hy
    exact hc (hy ▸ hx)

/-- the pivot splits off an X set. -/
lemma JC_pivot (s : Finset H) (hs : l ∈ s) (q : Finset (Fin 8 × Hp H l)) :
    JC s q = JC (s \ {l}) q ∪ {Sum.inl l} := by
  ext x
  rcases x with h | b
  · rw [Finset.mem_union, JC_mem_inl, JC_mem_inl, Finset.mem_sdiff, Finset.mem_singleton,
      Finset.mem_singleton]
    constructor
    · intro hh
      by_cases e : h = l
      · right; rw [e]
      · left; exact ⟨hh, e⟩
    · rintro (⟨hh, -⟩ | e)
      · exact hh
      · cases e; exact hs
  · rw [Finset.mem_union, JC_mem_inr, JC_mem_inr, Finset.mem_singleton]
    constructor
    · intro hb; exact Or.inl hb
    · rintro (hb | e)
      · exact hb
      · cases e

lemma JC_pivot_disj (s : Finset H) (q : Finset (Fin 8 × Hp H l)) :
    Disjoint (JC (s \ {l}) q) {Sum.inl l} := by
  rw [Finset.disjoint_singleton_right, JC_mem_inl, Finset.mem_sdiff, Finset.mem_singleton]
  exact fun h => h.2 rfl

lemma JC_univ_split : JC (univ : Finset H) (∅ : Finset (Fin 8 × Hp H l)) = JC {l} ∅ ∪ JC (univ \ {l}) ∅ := by
  ext x
  rcases x with h | b
  · rw [Finset.mem_union, JC_mem_inl, JC_mem_inl, JC_mem_inl, Finset.mem_singleton, Finset.mem_sdiff,
      Finset.mem_singleton]
    constructor
    · intro _
      by_cases e : h = l
      · exact Or.inl e
      · exact Or.inr ⟨Finset.mem_univ h, e⟩
    · intro _; exact Finset.mem_univ h
  · rw [Finset.mem_union, JC_mem_inr, JC_mem_inr, JC_mem_inr]
    simp

lemma JC_univ_split_disj : Disjoint (JC {l} (∅ : Finset (Fin 8 × Hp H l))) (JC (univ \ {l}) ∅) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  rcases x with h | b
  · rw [JC_mem_inl, Finset.mem_singleton] at hx
    rw [JC_mem_inl, Finset.mem_sdiff, Finset.mem_singleton] at hy
    exact hy.2 hx
  · rw [JC_mem_inr] at hx; exact Finset.notMem_empty b hx

lemma JC_empty_split : JC (∅ : Finset H) (∅ : Finset (Fin 8 × Hp H l)) ∪ JC (univ \ {l}) ∅ = JC (univ \ {l}) ∅ := by
  ext x
  rcases x with h | b
  · rw [Finset.mem_union, JC_mem_inl, JC_mem_inl]
    simp
  · rw [Finset.mem_union, JC_mem_inr, JC_mem_inr]
    simp

lemma JC_empty_disj : Disjoint (JC (∅ : Finset H) (∅ : Finset (Fin 8 × Hp H l))) (JC (univ \ {l}) ∅) := by
  rw [Finset.disjoint_left]
  intro x hx _
  rcases x with h | b
  · rw [JC_mem_inl] at hx; exact Finset.notMem_empty h hx
  · rw [JC_mem_inr] at hx; exact Finset.notMem_empty b hx

/-- **the X sets grow by the increments.** -/
lemma setX_succ (k : ℕ) (hk : k < 9) :
    setX l (k + 1) = setX l k ∪ incr l k ∧ Disjoint (setX l k) (incr l k) := by
  interval_cases k
  · exact ⟨JC_univ_split l, JC_univ_split_disj l⟩
  · refine ⟨?_, ?_⟩
    · have h := JC_qC_insert l (univ) ∅ (0 : Fin 8)
      rw [Finset.insert_empty, qC_empty] at h
      exact h
    · have h := JC_qC_disj l (univ) ∅ (0 : Fin 8) (Finset.notMem_empty _)
      rw [qC_empty] at h
      exact h
  · exact ⟨JC_qC_insert l _ GX.bs401_1 (1 : Fin 8), JC_qC_disj l _ GX.bs401_1 (1 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_2 (2 : Fin 8), JC_qC_disj l _ GX.bs401_2 (2 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_3 (3 : Fin 8), JC_qC_disj l _ GX.bs401_3 (3 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_4 (4 : Fin 8), JC_qC_disj l _ GX.bs401_4 (4 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_5 (5 : Fin 8), JC_qC_disj l _ GX.bs401_5 (5 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_6 (6 : Fin 8), JC_qC_disj l _ GX.bs401_6 (6 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_7 (7 : Fin 8), JC_qC_disj l _ GX.bs401_7 (7 : Fin 8) (by decide)⟩

/-- **the Y sets grow by the increments.** -/
lemma setY_succ (k : ℕ) (hk : k < 9) :
    setY l (k + 1) = setY l k ∪ incr l k ∧ Disjoint (setY l k) (incr l k) := by
  interval_cases k
  · exact ⟨(JC_empty_split l).symm, JC_empty_disj l⟩
  · refine ⟨?_, ?_⟩
    · have h := JC_qC_insert l (univ \ {l}) ∅ (0 : Fin 8)
      rw [Finset.insert_empty, qC_empty] at h
      exact h
    · have h := JC_qC_disj l (univ \ {l}) ∅ (0 : Fin 8) (Finset.notMem_empty _)
      rw [qC_empty] at h
      exact h
  · exact ⟨JC_qC_insert l _ GX.bs401_1 (1 : Fin 8), JC_qC_disj l _ GX.bs401_1 (1 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_2 (2 : Fin 8), JC_qC_disj l _ GX.bs401_2 (2 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_3 (3 : Fin 8), JC_qC_disj l _ GX.bs401_3 (3 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_4 (4 : Fin 8), JC_qC_disj l _ GX.bs401_4 (4 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_5 (5 : Fin 8), JC_qC_disj l _ GX.bs401_5 (5 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_6 (6 : Fin 8), JC_qC_disj l _ GX.bs401_6 (6 : Fin 8) (by decide)⟩
  · exact ⟨JC_qC_insert l _ GX.bs401_7 (7 : Fin 8), JC_qC_disj l _ GX.bs401_7 (7 : Fin 8) (by decide)⟩

/-- **the X set is the Y set and the pivot.** -/
lemma setX_pivot (k : ℕ) (hk : k ≤ 9) :
    setX l k = setY l k ∪ {Sum.inl l} ∧ Disjoint (setY l k) {Sum.inl l} := by
  interval_cases k
  · refine ⟨?_, ?_⟩
    · show JC {l} ∅ = JC ∅ ∅ ∪ {Sum.inl l}
      have h := JC_pivot l {l} (Finset.mem_singleton_self l) ∅
      rw [Finset.sdiff_self] at h
      exact h
    · have h := JC_pivot_disj l {l} ∅
      rw [Finset.sdiff_self] at h
      exact h
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩

end Sets

