def incr : ℕ → Finset (LC (Fin 17) H l)
  | 0 => JC (univ \ {l}) ∅
  | 1 => JC ∅ (qC {(0 : Fin 17)})
  | 2 => JC ∅ (qC {(1 : Fin 17)})
