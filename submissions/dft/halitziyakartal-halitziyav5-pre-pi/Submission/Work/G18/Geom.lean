lemma JC_mem_inl (s : Finset H) (q : Finset (Fin 17 × Hp H l)) (h : H) :
    (Sum.inl h : LC (Fin 17) H l) ∈ JC s q ↔ h ∈ s := Finset.inl_mem_disjSum

lemma JC_mem_inr (s : Finset H) (q : Finset (Fin 17 × Hp H l)) (b : Fin 17 × Hp H l) :
    (Sum.inr b : LC (Fin 17) H l) ∈ JC s q ↔ b ∈ q := Finset.inr_mem_disjSum

/-- adding block `c` to the blocks of an index set. -/
lemma JC_qC_insert (s : Finset H) (bs : Finset (Fin 17)) (c : Fin 17) :
    JC s (qC (l := l) (insert c bs)) = JC s (qC bs) ∪ JC ∅ (qC {c}) := by
  ext x
  rcases x with h | ⟨b, j⟩
  · simp only [Finset.mem_union, JC_mem_inl, Finset.notMem_empty, or_false]
  · simp only [Finset.mem_union, JC_mem_inr, mem_qC, Finset.mem_insert, Finset.mem_singleton]
    tauto

lemma JC_qC_disj (s : Finset H) (bs : Finset (Fin 17)) (c : Fin 17) (hc : c ∉ bs) :
    Disjoint (JC s (qC (l := l) bs)) (JC ∅ (qC {c})) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  rcases x with h | ⟨b, j⟩
  · rw [JC_mem_inl] at hy; exact Finset.notMem_empty h hy
  · rw [JC_mem_inr, mem_qC] at hx hy
    rw [Finset.mem_singleton] at hy
    exact hc (hy ▸ hx)

/-- the pivot splits off an X set. -/
lemma JC_pivot (s : Finset H) (hs : l ∈ s) (q : Finset (Fin 17 × Hp H l)) :
    JC s q = JC (s \ {l}) q ∪ {Sum.inl l} := by
  ext x
  rcases x with h | b
  · rw [Finset.mem_union, JC_mem_inl, JC_mem_inl, Finset.mem_sdiff, Finset.mem_singleton,
      Finset.mem_singleton]
    constructor
    · intro hh
      by_cases e : h = l
      · right; rw [e]
      · left; exact ⟨hh, e⟩
    · rintro (⟨hh, -⟩ | e)
      · exact hh
      · cases e; exact hs
  · rw [Finset.mem_union, JC_mem_inr, JC_mem_inr, Finset.mem_singleton]
    constructor
    · intro hb; exact Or.inl hb
    · rintro (hb | e)
      · exact hb
      · cases e

lemma JC_pivot_disj (s : Finset H) (q : Finset (Fin 17 × Hp H l)) :
    Disjoint (JC (s \ {l}) q) {Sum.inl l} := by
  rw [Finset.disjoint_singleton_right, JC_mem_inl, Finset.mem_sdiff, Finset.mem_singleton]
  exact fun h => h.2 rfl

lemma JC_univ_split : JC (univ : Finset H) (∅ : Finset (Fin 17 × Hp H l)) = JC {l} ∅ ∪ JC (univ \ {l}) ∅ := by
  ext x
  rcases x with h | b
  · rw [Finset.mem_union, JC_mem_inl, JC_mem_inl, JC_mem_inl, Finset.mem_singleton, Finset.mem_sdiff,
      Finset.mem_singleton]
    constructor
    · intro _
      by_cases e : h = l
      · exact Or.inl e
      · exact Or.inr ⟨Finset.mem_univ h, e⟩
    · intro _; exact Finset.mem_univ h
  · rw [Finset.mem_union, JC_mem_inr, JC_mem_inr, JC_mem_inr]
    simp

lemma JC_univ_split_disj : Disjoint (JC {l} (∅ : Finset (Fin 17 × Hp H l))) (JC (univ \ {l}) ∅) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  rcases x with h | b
  · rw [JC_mem_inl, Finset.mem_singleton] at hx
    rw [JC_mem_inl, Finset.mem_sdiff, Finset.mem_singleton] at hy
    exact hy.2 hx
  · rw [JC_mem_inr] at hx; exact Finset.notMem_empty b hx

lemma JC_empty_split : JC (∅ : Finset H) (∅ : Finset (Fin 17 × Hp H l)) ∪ JC (univ \ {l}) ∅ = JC (univ \ {l}) ∅ := by
  ext x
  rcases x with h | b
  · rw [Finset.mem_union, JC_mem_inl, JC_mem_inl]
    simp
  · rw [Finset.mem_union, JC_mem_inr, JC_mem_inr]
    simp

lemma JC_empty_disj : Disjoint (JC (∅ : Finset H) (∅ : Finset (Fin 17 × Hp H l))) (JC (univ \ {l}) ∅) := by
  rw [Finset.disjoint_left]
  intro x hx _
  rcases x with h | b
  · rw [JC_mem_inl] at hx; exact Finset.notMem_empty h hx
  · rw [JC_mem_inr] at hx; exact Finset.notMem_empty b hx

/-- **the X sets grow by the increments.** -/
lemma setX_succ (k : ℕ) (hk : k < 18) :
    setX l (k + 1) = setX l k ∪ incr l k ∧ Disjoint (setX l k) (incr l k) := by
  interval_cases k
  · exact ⟨JC_univ_split l, JC_univ_split_disj l⟩
  · refine ⟨?_, ?_⟩
    · have h := JC_qC_insert l (univ) ∅ (0 : Fin 17)
      rw [Finset.insert_empty, qC_empty] at h
      exact h
    · have h := JC_qC_disj l (univ) ∅ (0 : Fin 17) (Finset.notMem_empty _)
      rw [qC_empty] at h
      exact h
  · exact ⟨JC_qC_insert l _ bs1 (1 : Fin 17), JC_qC_disj l _ bs1 (1 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs2 (2 : Fin 17), JC_qC_disj l _ bs2 (2 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs3 (3 : Fin 17), JC_qC_disj l _ bs3 (3 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs4 (4 : Fin 17), JC_qC_disj l _ bs4 (4 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs5 (5 : Fin 17), JC_qC_disj l _ bs5 (5 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs6 (6 : Fin 17), JC_qC_disj l _ bs6 (6 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs7 (7 : Fin 17), JC_qC_disj l _ bs7 (7 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs8 (8 : Fin 17), JC_qC_disj l _ bs8 (8 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs9 (9 : Fin 17), JC_qC_disj l _ bs9 (9 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs10 (10 : Fin 17), JC_qC_disj l _ bs10 (10 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs11 (11 : Fin 17), JC_qC_disj l _ bs11 (11 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs12 (12 : Fin 17), JC_qC_disj l _ bs12 (12 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs13 (13 : Fin 17), JC_qC_disj l _ bs13 (13 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs14 (14 : Fin 17), JC_qC_disj l _ bs14 (14 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs15 (15 : Fin 17), JC_qC_disj l _ bs15 (15 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs16 (16 : Fin 17), JC_qC_disj l _ bs16 (16 : Fin 17) (by decide)⟩

/-- **the Y sets grow by the increments.** -/
lemma setY_succ (k : ℕ) (hk : k < 18) :
    setY l (k + 1) = setY l k ∪ incr l k ∧ Disjoint (setY l k) (incr l k) := by
  interval_cases k
  · exact ⟨(JC_empty_split l).symm, JC_empty_disj l⟩
  · refine ⟨?_, ?_⟩
    · have h := JC_qC_insert l (univ \ {l}) ∅ (0 : Fin 17)
      rw [Finset.insert_empty, qC_empty] at h
      exact h
    · have h := JC_qC_disj l (univ \ {l}) ∅ (0 : Fin 17) (Finset.notMem_empty _)
      rw [qC_empty] at h
      exact h
  · exact ⟨JC_qC_insert l _ bs1 (1 : Fin 17), JC_qC_disj l _ bs1 (1 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs2 (2 : Fin 17), JC_qC_disj l _ bs2 (2 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs3 (3 : Fin 17), JC_qC_disj l _ bs3 (3 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs4 (4 : Fin 17), JC_qC_disj l _ bs4 (4 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs5 (5 : Fin 17), JC_qC_disj l _ bs5 (5 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs6 (6 : Fin 17), JC_qC_disj l _ bs6 (6 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs7 (7 : Fin 17), JC_qC_disj l _ bs7 (7 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs8 (8 : Fin 17), JC_qC_disj l _ bs8 (8 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs9 (9 : Fin 17), JC_qC_disj l _ bs9 (9 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs10 (10 : Fin 17), JC_qC_disj l _ bs10 (10 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs11 (11 : Fin 17), JC_qC_disj l _ bs11 (11 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs12 (12 : Fin 17), JC_qC_disj l _ bs12 (12 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs13 (13 : Fin 17), JC_qC_disj l _ bs13 (13 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs14 (14 : Fin 17), JC_qC_disj l _ bs14 (14 : Fin 17) (by decide)⟩
  · exact ⟨JC_qC_insert l _ bs15 (15 : Fin 17), JC_qC_disj l _ bs15 (15 : Fin 17) (by decide)⟩
