section Frames
variable {H T : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  (base : T → OBase H) (l : H)

/-- the gauge permutation of the ports at stage `k` (stage 0: none; stage `k`: `RrC (base t) l (k-1)`). -/
def gaugeE : ℕ → T → Orth (LC (Fin 17) H l) ≃ Orth (LC (Fin 17) H l)
  | 0 => fun _ => Equiv.refl _
  | 1 => fun t => RrC (base t) l (0 : Fin 17)
  | 2 => fun t => RrC (base t) l (1 : Fin 17)
  | 3 => fun t => RrC (base t) l (2 : Fin 17)
  | 4 => fun t => RrC (base t) l (3 : Fin 17)
  | 5 => fun t => RrC (base t) l (4 : Fin 17)
  | 6 => fun t => RrC (base t) l (5 : Fin 17)
  | 7 => fun t => RrC (base t) l (6 : Fin 17)
  | 8 => fun t => RrC (base t) l (7 : Fin 17)
  | 9 => fun t => RrC (base t) l (8 : Fin 17)
  | 10 => fun t => RrC (base t) l (9 : Fin 17)
  | 11 => fun t => RrC (base t) l (10 : Fin 17)
  | 12 => fun t => RrC (base t) l (11 : Fin 17)
  | 13 => fun t => RrC (base t) l (12 : Fin 17)
  | 14 => fun t => RrC (base t) l (13 : Fin 17)
  | 15 => fun t => RrC (base t) l (14 : Fin 17)
  | 16 => fun t => RrC (base t) l (15 : Fin 17)
  | 17 => fun t => RrC (base t) l (16 : Fin 17)
  | _ => fun _ => Equiv.refl _

lemma stage0_Xin (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC g ∅ (tt ((base t).v l)) = frame (BBC (base t) l g) (setX l 0) := by
  exact classT_X0 (base t) l g

lemma stage0_Xout (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC g ∅ 1 = frame (BBC (base t) l g) (setX l 1) := by
  have e := PhiC_BBC (base t) l g ∅ univ
  rw [OBase.mat_univ] at e
  exact e

lemma stage0_Yin (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC g ∅ 0 = frame (BBC (base t) l g) (setY l 0) := by
  exact classT_Y0 (base t) l g

lemma stage0_Yout (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC g ∅ (1 + tt ((base t).v l)) = frame (BBC (base t) l g) (setY l 1) := by
  have e := PhiC_BBC (base t) l g ∅ (univ \ {l})
  rw [mat_compl_single] at e
  exact e

lemma stage1_Xin (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC (RrC (base t) l (0 : Fin 17) g) (qC bs1) (tt ((base t).v l)) = frame (BBC (base t) l g) (setX l 1) := by
  have e := bank_inX (base t) l ∅ (0 : Fin 17) (by decide) g
  rw [mat_single, Finset.insert_empty, qC_empty] at e
  exact e

lemma stage1_Xout (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC (RrC (base t) l (0 : Fin 17) g) (qC bs1) 1 = frame (BBC (base t) l g) (setX l 2) := by
  exact classT_X (base t) l bs1 (0 : Fin 17) (by decide) g

lemma stage1_Yin (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC (RrC (base t) l (0 : Fin 17) g) (qC bs1) 0 = frame (BBC (base t) l g) (setY l 1) := by
  have e := bank_inY (base t) l ∅ (0 : Fin 17) (by decide) g
  rw [mat_empty, Finset.insert_empty, qC_empty] at e
  exact e

lemma stage1_Yout (t : T) (g : Orth (LC (Fin 17) H l)) :
    PhiC (RrC (base t) l (0 : Fin 17) g) (qC bs1) (1 + tt ((base t).v l)) = frame (BBC (base t) l g) (setY l 2) := by
  exact classT_Y (base t) l bs1 (0 : Fin 17) (by decide) g

