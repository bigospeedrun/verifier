section Win
variable {H : Type} [Fintype H] [DecidableEq H]

/-- the window of stage `n` of the invocation `d` (the leader's conjugation window `gwinC`). -/
def winN (l : H) (hH : Fintype.card H = 9) (n : ℕ) (d : Orth (LC (Fin 17) H l)) : GWin H (LC (Fin 17) H l) :=
  match n with
  | 0 => gwinC hB (by omega) d ∅
  | 1 => gwinC hB (by omega) d (qC bs1)
  | 2 => gwinC hB (by omega) d (qC bs2)
  | 3 => gwinC hB (by omega) d (qC bs3)
  | 4 => gwinC hB (by omega) d (qC bs4)
  | 5 => gwinC hB (by omega) d (qC bs5)
  | 6 => gwinC hB (by omega) d (qC bs6)
  | 7 => gwinC hB (by omega) d (qC bs7)
  | 8 => gwinC hB (by omega) d (qC bs8)
  | 9 => gwinC hB (by omega) d (qC bs9)
  | 10 => gwinC hB (by omega) d (qC bs10)
  | 11 => gwinC hB (by omega) d (qC bs11)
  | 12 => gwinC hB (by omega) d (qC bs12)
  | 13 => gwinC hB (by omega) d (qC bs13)
  | 14 => gwinC hB (by omega) d (qC bs14)
  | 15 => gwinC hB (by omega) d (qC bs15)
  | 16 => gwinC hB (by omega) d (qC bs16)
  | 17 => gwinC hB (by omega) d (qC bs17)
  | _ => gwinC hB (by omega) d ∅

end Win

