/-- **the X set is the Y set and the pivot.** -/
lemma setX_pivot (k : ℕ) (hk : k ≤ 18) :
    setX l k = setY l k ∪ {Sum.inl l} ∧ Disjoint (setY l k) {Sum.inl l} := by
  interval_cases k
  · refine ⟨?_, ?_⟩
    · show JC {l} ∅ = JC ∅ ∅ ∪ {Sum.inl l}
      have h := JC_pivot l {l} (Finset.mem_singleton_self l) ∅
      rw [Finset.sdiff_self] at h
      exact h
    · have h := JC_pivot_disj l {l} ∅
      rw [Finset.sdiff_self] at h
      exact h
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
  · exact ⟨JC_pivot l univ (Finset.mem_univ l) _, JC_pivot_disj l univ _⟩
