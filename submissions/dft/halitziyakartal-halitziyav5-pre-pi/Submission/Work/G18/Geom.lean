/-- the X index set at the start of stage `k` (`k = 18`: after the last stage). -/
def setX : ℕ → Finset (LC (Fin 17) H l)
  | 0 => JC {l} ∅
  | 1 => JC univ ∅
  | 2 => JC univ (qC bs1)
  | 3 => JC univ (qC bs2)
  | 4 => JC univ (qC bs3)
