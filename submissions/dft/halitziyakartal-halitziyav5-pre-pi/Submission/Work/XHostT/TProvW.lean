/-- **a gauged invocation package with a window condition** (p-warpchk's `KLW.GInvEW`). -/
structure GInvW (H T Sl C : Type) [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
    [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C]
    (Ok : ∀ {α : Type} [Fintype α] [DecidableEq α], GWin H α → Prop) where
  tv : T → Space H
  hunit : ∀ t, dot (tv t) (tv t) = 1
  hgap : ∀ t, ∃ p, tv t p = 0
  cost : (ℕ → ℝ) → ℝ
  ent : Sl → SLbl H
  fwd : ∀ {α : Type} [Fintype α] [DecidableEq α] (W : GWin H α), Ok W → ∀ (N Wn : Sl → CMat α),
    (∀ q, W.X.Φ (ent q) * N q = 1) → (∀ q, W.X.Φ (ent q).top = Wn q * W.X.Φ (ent q)) →
    ∀ (Z : Sl → CMat α) (c0 c1 : C → CMat α),
    GRoute (iin W.Xm tv Z c0) (iout W.Xm tv (fun q => Wn q * Z q) c1) shearF cost
  bwd : ∀ {α : Type} [Fintype α] [DecidableEq α] (W : GWin H α), Ok W → ∀ (N Wn : Sl → CMat α),
    (∀ q, W.X.Φ (ent q) * N q = 1) → (∀ q, W.X.Φ (ent q).top = Wn q * W.X.Φ (ent q)) →
    ∀ (Z : Sl → CMat α) (c0 c1 : C → CMat α),
    GRoute (iin W.Xm tv Z c0) (iout W.Xm tv (fun q => Wn q * Z q) c1) shearB cost

section Prov
variable {H T Sl C : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C]
variable {Ok : ∀ {α : Type} [Fintype α] [DecidableEq α], GWin H α → Prop}

/-- a warp-free provider serves every window. -/
def GInvE.toW' (I : GInvE H T Sl C) (Ok : ∀ {α : Type} [Fintype α] [DecidableEq α], GWin H α → Prop) :
    GInvW H T Sl C Ok where
  tv := I.tv
  hunit := I.hunit
  hgap := I.hgap
  cost := I.cost
  ent := I.ent
  fwd := fun W _ => I.fwd W
  bwd := fun W _ => I.bwd W

/-- the provider with its target vectors replaced by an EQUAL family (definitionally `tv`). -/
def retagTvW (J : GInvW H T Sl C Ok) (tv : T → Space H) (h : J.tv = tv) : GInvW H T Sl C Ok where
  tv := tv
  hunit := by subst h; exact J.hunit
  hgap := by subst h; exact J.hgap
  cost := J.cost
  ent := J.ent
  fwd := by subst h; exact J.fwd
  bwd := by subst h; exact J.bwd

/-- the residual of slot `q` in call `(ρ, l)`: that of the call's own provider word. -/
def resIcW {nR : ℕ} (Ic : Fin nR → Fin 9 → GInvW H T Sl C Ok) (ρ : Fin nR) (l : Fin 9) (q : Sl) : ℕ :=
  Fintype.card H - ((Ic ρ l).ent q).dim

variable {α Γ : Type} [Fintype α] [DecidableEq α] [Fintype Γ] [DecidableEq Γ] (I : GInvW H T Sl C Ok)

/-- Shea's stage of gauged invocations, forward, at windows with `Ok`. -/
theorem gistageW_fwd (εX : T → Γ ≃ Γ) (M : Γ → GWin H α) (hok : ∀ d, Ok (M d)) (N Wn : Γ → Sl → CMat α)
    (hN : ∀ d q, (M d).X.Φ (I.ent q) * N d q = 1)
    (hW : ∀ d q, (M d).X.Φ (I.ent q).top = Wn d q * (M d).X.Φ (I.ent q))
    (Z : Γ → Sl → CMat α) (c0 c1 : Γ → C → CMat α) :
    GRoute (bIn I.tv εX (fun d => (M d).Xm) Z c0)
      (bOut I.tv εX (fun d => (M d).Xm) (fun g q => Wn g q * Z g q) c1)
      GF (fun φ => (Fintype.card Γ : ℝ) * I.cost φ) := by
  refine gsstage εX (Equiv.refl Γ) (h := shearF) (cost := I.cost) (fun d => ?_) (fun d x => ?_)
  · rw [bIn_sem, bOut_sem]
    exact I.fwd (M d) (hok d) (N d) (Wn d) (hN d) (hW d) _ _ _
  · funext b
    rcases b with ((t|t)|(q|k)) <;> rfl

/-- Shea's stage of gauged invocations, backward, at windows with `Ok`. -/
theorem gistageW_bwd (εX : T → Γ ≃ Γ) (M : Γ → GWin H α) (hok : ∀ d, Ok (M d)) (N Wn : Γ → Sl → CMat α)
    (hN : ∀ d q, (M d).X.Φ (I.ent q) * N d q = 1)
    (hW : ∀ d q, (M d).X.Φ (I.ent q).top = Wn d q * (M d).X.Φ (I.ent q))
    (Z : Γ → Sl → CMat α) (c0 c1 : Γ → C → CMat α) :
    GRoute (bIn I.tv εX (fun d => (M d).Xm) Z c0)
      (bOut I.tv εX (fun d => (M d).Xm) (fun g q => Wn g q * Z g q) c1)
      GB (fun φ => (Fintype.card Γ : ℝ) * I.cost φ) := by
  refine gsstage εX (Equiv.refl Γ) (h := shearB) (cost := I.cost) (fun d => ?_) (fun d x => ?_)
  · rw [bIn_sem, bOut_sem]
    exact I.bwd (M d) (hok d) (N d) (Wn d) (hN d) (hW d) _ _ _
  · funext b
    rcases b with ((t|t)|(q|k)) <;> rfl

end Prov

