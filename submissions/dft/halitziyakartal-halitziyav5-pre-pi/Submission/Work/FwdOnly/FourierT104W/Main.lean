/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderT104W : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsT104W W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneT104W
  exact ⟨o,s,lunchT104W a b id,hp,Skies.time_boundT104W (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderT104W : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsT104W W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothT104W
  have h (n : ℕ) : n ≤ stretchT104W n ∧ stretchT104W n ≤ 2*n := by unfold stretchT104W; omega
  exact ⟨o,s,lunchT104W a b stretchT104W,hp,Skies.time_boundT104W h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posT104W hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - statedSavingT104W))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentT104W = 1 - statedSavingT104W`
(Work/FwdOnly/FourierT104W/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_T104W_x`: both
follow from one kernel program, `RAM.hillsT104W_program` (Work/FwdOnly/FourierT104W/Seam.lean). -/
theorem transform_mainT104W : DFTGoalT104W :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderT104W
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainT104W : ConvGoalT104W :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderT104W
  ⟨o,s,W,h,g⟩

