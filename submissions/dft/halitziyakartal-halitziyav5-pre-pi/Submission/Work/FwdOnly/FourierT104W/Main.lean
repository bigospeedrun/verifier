lemma multiplier_rangeT104W : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltT104W : theta < 1 := by
  have h := multiplier_rangeT104W
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaT104W : alphaT104W < theta := by
  let d : ℝ := 3127809973/(10:ℝ)^12
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeT104W.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minT104W
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeT104W : alphaT104W < decimalExponentT104W ∧ decimalExponentT104W < 1 := by
  norm_num [decimalExponentT104W,alphaT104W,statedSavingT104W]

def speedT104W (v : ℝ) (n : ℕ) := (n:ℝ)*(TmT104W n)^v

lemma flight_littleT104W {v : ℝ} (h : alphaT104W < v) :
    flightT104W =o[atTop] speedT104W v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopT104W.eventually_ge_atTop 1,dwarfT104W TtopT104W 2
    (p:=v-alphaT104W) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmT104W n := by linarith
  change ‖(n:ℝ)*TmT104W n^alphaT104W*QmT104W n^2‖ ≤ c*‖(n:ℝ)*TmT104W n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmT104W n^alphaT104W)*(c*TmT104W n^(v-alphaT104W)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmT104W n^alphaT104W*TmT104W n^(v-alphaT104W))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaT104W + (v-alphaT104W)=v by ring] -- a+(v-a)

lemma speed_littleT104W {u v : ℝ} (h : u < v) :
    speedT104W u =o[atTop] speedT104W v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopT104W.eventually_ge_atTop 1,dwarfT104W TtopT104W 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmT104W n := by linarith
  change ‖(n:ℝ)*TmT104W n^u‖ ≤ c*‖(n:ℝ)*TmT104W n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmT104W n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmT104W n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmT104W n^u)*(c*TmT104W n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmT104W n^u*TmT104W n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleT104W : decimalTimeT104W =o[atTop] nlogn := by
  have H := speed_littleT104W decimal_rangeT104W.2
  have h : speedT104W 1 = nlogn := funext fun n => by rw [speedT104W,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperT104W : speedT104W theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopT104W.eventually_ge_atTop 1,QtopT104W.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmT104W n := by linarith
  have he' : 0<QmT104W n := by linarith
  change ‖(n:ℝ)*TmT104W n^theta‖ ≤ 1*‖(n:ℝ)*TmT104W n^theta*QmT104W n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltT104W])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundT104W {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationT104W) :
    TimeBoundsT104W (lunchT104W a b N) := by
  have H := lunch_bigT104W a b h
  have hp := H.trans_isLittleO (flight_littleT104W alpha_thetaT104W)
  have hd := H.trans_isLittleO (flight_littleT104W decimal_rangeT104W.1)
  have ht : (fun n => (lunchT104W a b N n:ℝ)) =O[atTop] decimalTimeT104W := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperT104W,ht,ht.trans_isLittleO decimal_littleT104W⟩

