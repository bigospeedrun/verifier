/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaT104W : ℝ := 1 - 3127809973/(10:ℝ)^12

theorem alphaT104W_pos : 0 < alphaT104W := by norm_num [alphaT104W]
theorem alphaT104W_lt : alphaT104W < 1 := by norm_num [alphaT104W]

lemma envelope_monoT104W (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expT104W {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsT104W (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaT104W)

lemma hillsT104W_eq_envelope : hillsT104W = envelope alphaT104W := rfl

lemma hillsT104W_pos (k : ℕ) : 1≤hillsT104W k := envelope_pos alphaT104W k

lemma hillsT104W_mono {a b : ℕ} (h : a≤b) : hillsT104W a ≤ hillsT104W b := envelope_monoT104W alphaT104W alphaT104W_pos.le h

lemma hillsT104W_le (k : ℕ) : hillsT104W k ≤ k+1 := envelope_le alphaT104W alphaT104W_lt.le k

lemma hillsT104W_real (k : ℕ) : (hillsT104W k:ℝ) ≤ 2*((k:ℝ)+1)^alphaT104W := envelope_real alphaT104W alphaT104W_pos.le k

/-! ## 3. The kernel program at `alphaT104W` -/

namespace SeamT104W
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaT104W = 1 - 3127809973/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_T104W (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaT104W (k i)) :=
  MX.T104W.EngineStmt.lift MX.T104W.engine cl m k v

end SeamT104W

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsT104W`
(exponent `1 - 3127809973/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamT104W.engine_T104W`, for every colour,
both modes and every batch of inputs, in `2^k * hillsT104W k` operations. -/
theorem hillsT104W_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsT104W (k i)) :=
  SeamT104W.engine_T104W cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaT104W`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geT104W (z : ℝ) (hz : alphaT104W ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsT104W_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expT104W hz (k i))

end RAM

/-! ## 5. Number facts for the copy of `Main.lean` -/

