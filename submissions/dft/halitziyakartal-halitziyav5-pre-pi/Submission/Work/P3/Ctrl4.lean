import Mathlib.Tactic
-- changed for the tensor-power extension (30103/10000000); see Submission.lean

/-!
# The algebraic core of the p3 controller certificate (keep43, with boundary adapters)

Generated by p3-port/py/gen_ctrl_lean.py from the event list of py/ctrl_alg.py and the adapters of
py/ctrl_factor.py; do not edit.  One port of the controller acts on the six main roles `x0 y0 x1 y1 x2 y2`
(`X_j`, `Y_j` of pair `j`).  Every operator on the main-data path is Walsh-diagonal (stage transforms `D_s`, the
port translation `Q`, free endpoint monomials), so one port is a 6 x 6 matrix over a commutative ring `R`:
`d s` stands for `D_s`, `q`, `qi` for `Q`, `Q⁻¹` (`q * qi = 1`).  The idle windows 2 (a head, pair 2) and 4 (a
terminal window, pair 0) are omitted; the input adapter `adaptIn` (A) and the output adapter `adaptOut` (B) are
scalar gates with coefficients in `{-1, 0, 1}`.  `ctrl_diag`: after the adapters every adapted role holds ONE
monomial of ITS OWN input, with ranks 1 + 8 |stages| = 25, 25, 57, 25, 25, 57.  No `sorry`.
-/

namespace OAI.PowerSaving.P4Ctrl

/-- the 8 main roles of one port -/
structure S8 (R : Type*) where
  x0 : R
  y0 : R
  x1 : R
  y1 : R
  x2 : R
  y2 : R
  x3 : R
  y3 : R

variable {R : Type*} [CommRing R]

/-- **The p3 controller (keep43)**, event by event (native calls, retained idle windows, bridges, exchanges). -/
def ctrl (d : Fin 9 → R) (q qi : R) (s : S8 R) : S8 R :=
  -- stage 0: native call on pair 0, forward (Y0 += Q^-1 X0)
  let s : S8 R := ⟨s.x0, s.y0 + qi * s.x0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 0: the stage transform D_0 on pair 0
  let s : S8 R := ⟨d 0 * s.x0, d 0 * s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 1: native call on pair 0, backward (X0 -= Q Y0)
  let s : S8 R := ⟨s.x0 - q * s.y0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 1: the stage transform D_1 on pair 0
  let s : S8 R := ⟨d 1 * s.x0, d 1 * s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 0 on pair 1, stages [0, 1] (hosted helpers + paid remnants)
  let s : S8 R := ⟨s.x0, s.y0, (d 0 * d 1) * s.x1, (d 0 * d 1) * s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate x0 += 1 x1
  let s : S8 R := ⟨s.x0 + (1) * s.x1, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y1 += -1 y0
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1 + (-1) * s.y0, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 2: native call on pair 0, forward (Y0 += Q^-1 X0)
  let s : S8 R := ⟨s.x0, s.y0 + qi * s.x0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 2: the stage transform D_2 on pair 0
  let s : S8 R := ⟨d 2 * s.x0, d 2 * s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 1 on pair 1, stages [2] (hosted helpers + paid remnants)
  let s : S8 R := ⟨s.x0, s.y0, (d 2) * s.x1, (d 2) * s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate x0 += -1 x1
  let s : S8 R := ⟨s.x0 + (-1) * s.x1, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y1 += 1 y0
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1 + (1) * s.y0, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 3: native call on pair 1, backward (X1 -= Q Y1)
  let s : S8 R := ⟨s.x0, s.y0, s.x1 - q * s.y1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 3: the stage transform D_3 on pair 1
  let s : S8 R := ⟨s.x0, s.y0, d 3 * s.x1, d 3 * s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 2 on pair 2, stages [0, 1, 2, 3] (hosted helpers + paid remnants)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, (d 0 * d 1 * d 2 * d 3) * s.x2, (d 0 * d 1 * d 2 * d 3) * s.y2, s.x3, s.y3⟩
  -- bridge gate x1 += 1 x2
  let s : S8 R := ⟨s.x0, s.y0, s.x1 + (1) * s.x2, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y2 += -1 y1
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 + (-1) * s.y1, s.x3, s.y3⟩
  -- stage 4: native call on pair 1, forward (Y1 += Q^-1 X1)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1 + qi * s.x1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 4: the stage transform D_4 on pair 1
  let s : S8 R := ⟨s.x0, s.y0, d 4 * s.x1, d 4 * s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 3 on pair 2, stages [4] (hosted helpers + paid remnants)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, (d 4) * s.x2, (d 4) * s.y2, s.x3, s.y3⟩
  -- bridge gate x1 += -1 x2
  let s : S8 R := ⟨s.x0, s.y0, s.x1 + (-1) * s.x2, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y2 += 1 y1
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 + (1) * s.y1, s.x3, s.y3⟩
  -- stage 5: native call on pair 2, backward (X2 -= Q Y2)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 - q * s.y2, s.y2, s.x3, s.y3⟩
  -- stage 5: the stage transform D_5 on pair 2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, d 5 * s.x2, d 5 * s.y2, s.x3, s.y3⟩
  -- bridge gate x2 += 1 x3
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 + (1) * s.x3, s.y2, s.x3, s.y3⟩
  -- bridge gate y3 += -1 y2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3 + (-1) * s.y2⟩
  -- stage 6: native call on pair 2, forward (Y2 += Q^-1 X2)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 + qi * s.x2, s.x3, s.y3⟩
  -- stage 6: the stage transform D_6 on pair 2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, d 6 * s.x2, d 6 * s.y2, s.x3, s.y3⟩
  -- idle window 5 on pair 3, stages [6] (hosted helpers + paid remnants)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, (d 6) * s.x3, (d 6) * s.y3⟩
  -- bridge gate x2 += -1 x3
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 + (-1) * s.x3, s.y2, s.x3, s.y3⟩
  -- bridge gate y3 += 1 y2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3 + (1) * s.y2⟩
  -- stage 7: native call on pair 3, backward (X3 -= Q Y3)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3 - q * s.y3, s.y3⟩
  -- stage 7: the stage transform D_7 on pair 3
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, d 7 * s.x3, d 7 * s.y3⟩
  -- stage 8: native call on pair 3, forward (Y3 += Q^-1 X3)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3 + qi * s.x3⟩
  -- stage 8: the stage transform D_8 on pair 3
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, d 8 * s.x3, d 8 * s.y3⟩
  -- idle window 8 on pair 2, stages [7, 8] (hosted helpers + paid remnants)
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, (d 7 * d 8) * s.x2, (d 7 * d 8) * s.y2, s.x3, s.y3⟩
  -- bridge gate x3 += 1 x2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3 + (1) * s.x2, s.y3⟩
  -- bridge gate y2 += -1 y3
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 + (-1) * s.y3, s.x3, s.y3⟩
  -- bridge gate x2 += 1 x1
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 + (1) * s.x1, s.y2, s.x3, s.y3⟩
  -- bridge gate y1 += -1 y2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1 + (-1) * s.y2, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate x1 += 1 x0
  let s : S8 R := ⟨s.x0, s.y0, s.x1 + (1) * s.x0, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y0 += -1 y1
  let s : S8 R := ⟨s.x0, s.y0 + (-1) * s.y1, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- signed exchange of pair 0
  let s : S8 R := ⟨s.y0, -s.x0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- signed exchange of pair 1
  let s : S8 R := ⟨s.x0, s.y0, s.y1, -s.x1, s.x2, s.y2, s.x3, s.y3⟩
  -- signed exchange of pair 2
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.y2, -s.x2, s.x3, s.y3⟩
  -- signed exchange of pair 3
  let s : S8 R := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.y3, -s.x3⟩
  s

/-- the input adapter `A`: physical role `i` := `∑ j, A i j * (input of adapted role j)` -/
def adaptIn (u : S8 R) : S8 R := ⟨(1) * u.y0 + (-1) * u.x1 + (1) * u.y1, (1) * u.y2, (1) * u.x1 + (-1) * u.y1, (1) * u.y2 + (-1) * u.x3, (1) * u.y1, (-1) * u.x3 + (1) * u.y3, (1) * u.x0, (1) * u.x2⟩

/-- the output adapter `B`: adapted role `i` := `∑ r, B i r * (physical role r)` -/
def adaptOut (s : S8 R) : S8 R := ⟨(1) * s.x3, (1) * s.x0 + (1) * s.x1, (1) * s.x1 + (1) * s.x2, (1) * s.x2, (1) * s.y3, (1) * s.y0, (1) * s.y0 + (-1) * s.y1, (1) * s.y0 + (-1) * s.y1 + (1) * s.y2⟩

/-- **The boundary factorisation of keep43**: one monomial of its own input on every adapted role. -/
theorem ctrl_diag (d : Fin 9 → R) (q qi : R) (hq : q * qi = 1) (u : S8 R) :
    adaptOut (ctrl d q qi (adaptIn u)) =
      ⟨(qi * d 6 * d 7 * d 8) * u.x0, (qi * d 0 * d 1 * d 2) * u.y0, (qi * d 0 * d 1 * d 2 * d 3 * d 4) * u.x1, (qi * d 0 * d 1 * d 2 * d 3 * d 4 * d 5 * d 6 * d 7 * d 8) * u.y1, (q * d 6 * d 7 * d 8) * u.x2, (q * d 0 * d 1 * d 2) * u.y2, (q * d 0 * d 1 * d 2 * d 3 * d 4) * u.x3, (q * d 0 * d 1 * d 2 * d 3 * d 4 * d 5 * d 6 * d 7 * d 8) * u.y3⟩ := by
  simp only [ctrl, adaptIn, adaptOut, S8.mk.injEq]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4*u.y1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3*u.y2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^3*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.y2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.x3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi^2*u.x1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.x3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.y3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*qi*u.y1 - (d 6)*(d 7)*(d 8)*qi*u.x0 - (d 6)*(d 7)*(d 8)*u.x2) * hq
  · linear_combination (-(d 0)*(d 1)*(d 2)*qi*u.y0 + (d 0)*(d 1)*(d 2)*qi*u.x1 - (d 0)*(d 1)*(d 2)*qi*u.y1 - (d 0)*(d 1)*(d 2)*u.y2) * hq
  · linear_combination ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi^2*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi^2*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi^2*u.y1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi*u.y2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*qi*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*u.y2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*u.x3) * hq
  · linear_combination (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4*u.y0 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4*u.x1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4*u.y1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3*u.y2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^3*u.x1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^3*u.y1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.x3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi^2*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi^2*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.y2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.y3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*qi*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*qi*u.y1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*u.x3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*u.y3 + (d 6)*(d 7)*(d 8)*qi*u.x0 + (d 6)*(d 7)*(d 8)*u.x2) * hq
  · linear_combination (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3*u.y0 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3*u.x1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3*u.y1 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^2*u.y2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.y0 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi*u.y2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi*u.x3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*u.x3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*u.y3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*u.y1 + (d 6)*(d 7)*(d 8)*u.x0) * hq
  · linear_combination ((d 0)*(d 1)*(d 2)*u.y0 - (d 0)*(d 1)*(d 2)*u.x1 + (d 0)*(d 1)*(d 2)*u.y1) * hq
  · linear_combination ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi*u.y1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*u.y2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*u.y1) * hq
  · linear_combination ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.y0 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2*u.y1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi*u.y2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.x1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi*u.y1 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*u.x3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*u.y1) * hq

section Module
variable {V : Type*} [AddCommGroup V] [Module R V]

/-- **The controller on DATA** (`V` an `R`-module: `R` the commutative ring of the stage operators acting on
the role contents): the same events, scalars acting by `•`. -/
def ctrlV (d : Fin 9 → R) (q qi : R) (s : S8 V) : S8 V :=
  -- stage 0: native call on pair 0, forward
  let s : S8 V := ⟨s.x0, s.y0 + qi • s.x0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 0: D_0 on pair 0
  let s : S8 V := ⟨d 0 • s.x0, d 0 • s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 1: native call on pair 0, backward
  let s : S8 V := ⟨s.x0 - q • s.y0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 1: D_1 on pair 0
  let s : S8 V := ⟨d 1 • s.x0, d 1 • s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 0 on pair 1
  let s : S8 V := ⟨s.x0, s.y0, (d 0 * d 1) • s.x1, (d 0 * d 1) • s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate x0 += 1 x1
  let s : S8 V := ⟨s.x0 + s.x1, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y1 += -1 y0
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1 - s.y0, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 2: native call on pair 0, forward
  let s : S8 V := ⟨s.x0, s.y0 + qi • s.x0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 2: D_2 on pair 0
  let s : S8 V := ⟨d 2 • s.x0, d 2 • s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 1 on pair 1
  let s : S8 V := ⟨s.x0, s.y0, (d 2) • s.x1, (d 2) • s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate x0 += -1 x1
  let s : S8 V := ⟨s.x0 - s.x1, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y1 += 1 y0
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1 + s.y0, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 3: native call on pair 1, backward
  let s : S8 V := ⟨s.x0, s.y0, s.x1 - q • s.y1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 3: D_3 on pair 1
  let s : S8 V := ⟨s.x0, s.y0, d 3 • s.x1, d 3 • s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 2 on pair 2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, (d 0 * d 1 * d 2 * d 3) • s.x2, (d 0 * d 1 * d 2 * d 3) • s.y2, s.x3, s.y3⟩
  -- bridge gate x1 += 1 x2
  let s : S8 V := ⟨s.x0, s.y0, s.x1 + s.x2, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y2 += -1 y1
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 - s.y1, s.x3, s.y3⟩
  -- stage 4: native call on pair 1, forward
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1 + qi • s.x1, s.x2, s.y2, s.x3, s.y3⟩
  -- stage 4: D_4 on pair 1
  let s : S8 V := ⟨s.x0, s.y0, d 4 • s.x1, d 4 • s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- idle window 3 on pair 2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, (d 4) • s.x2, (d 4) • s.y2, s.x3, s.y3⟩
  -- bridge gate x1 += -1 x2
  let s : S8 V := ⟨s.x0, s.y0, s.x1 - s.x2, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y2 += 1 y1
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 + s.y1, s.x3, s.y3⟩
  -- stage 5: native call on pair 2, backward
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 - q • s.y2, s.y2, s.x3, s.y3⟩
  -- stage 5: D_5 on pair 2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, d 5 • s.x2, d 5 • s.y2, s.x3, s.y3⟩
  -- bridge gate x2 += 1 x3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 + s.x3, s.y2, s.x3, s.y3⟩
  -- bridge gate y3 += -1 y2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3 - s.y2⟩
  -- stage 6: native call on pair 2, forward
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 + qi • s.x2, s.x3, s.y3⟩
  -- stage 6: D_6 on pair 2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, d 6 • s.x2, d 6 • s.y2, s.x3, s.y3⟩
  -- idle window 5 on pair 3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, (d 6) • s.x3, (d 6) • s.y3⟩
  -- bridge gate x2 += -1 x3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 - s.x3, s.y2, s.x3, s.y3⟩
  -- bridge gate y3 += 1 y2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3 + s.y2⟩
  -- stage 7: native call on pair 3, backward
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3 - q • s.y3, s.y3⟩
  -- stage 7: D_7 on pair 3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, d 7 • s.x3, d 7 • s.y3⟩
  -- stage 8: native call on pair 3, forward
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3 + qi • s.x3⟩
  -- stage 8: D_8 on pair 3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, d 8 • s.x3, d 8 • s.y3⟩
  -- idle window 8 on pair 2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, (d 7 * d 8) • s.x2, (d 7 * d 8) • s.y2, s.x3, s.y3⟩
  -- bridge gate x3 += 1 x2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.x3 + s.x2, s.y3⟩
  -- bridge gate y2 += -1 y3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2 - s.y3, s.x3, s.y3⟩
  -- bridge gate x2 += 1 x1
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2 + s.x1, s.y2, s.x3, s.y3⟩
  -- bridge gate y1 += -1 y2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1 - s.y2, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate x1 += 1 x0
  let s : S8 V := ⟨s.x0, s.y0, s.x1 + s.x0, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- bridge gate y0 += -1 y1
  let s : S8 V := ⟨s.x0, s.y0 - s.y1, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- signed exchange of pair 0
  let s : S8 V := ⟨s.y0, -s.x0, s.x1, s.y1, s.x2, s.y2, s.x3, s.y3⟩
  -- signed exchange of pair 1
  let s : S8 V := ⟨s.x0, s.y0, s.y1, -s.x1, s.x2, s.y2, s.x3, s.y3⟩
  -- signed exchange of pair 2
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.y2, -s.x2, s.x3, s.y3⟩
  -- signed exchange of pair 3
  let s : S8 V := ⟨s.x0, s.y0, s.x1, s.y1, s.x2, s.y2, s.y3, -s.x3⟩
  s

def adaptInV (u : S8 V) : S8 V := ⟨u.y0 - u.x1 + u.y1, u.y2, u.x1 - u.y1, u.y2 - u.x3, u.y1, -u.x3 + u.y3, u.x0, u.x2⟩
def adaptOutV (s : S8 V) : S8 V := ⟨s.x3, s.x0 + s.x1, s.x1 + s.x2, s.x2, s.y3, s.y0, s.y0 - s.y1, s.y0 - s.y1 + s.y2⟩

/-- **The boundary factorisation on data**: every adapted role holds one monomial operator of ITS OWN input. -/
theorem ctrlV_diag (d : Fin 9 → R) (q qi : R) (hq : q * qi = 1) (u : S8 V) :
    adaptOutV (ctrlV d q qi (adaptInV u)) =
      ⟨(qi * d 6 * d 7 * d 8) • u.x0, (qi * d 0 * d 1 * d 2) • u.y0, (qi * d 0 * d 1 * d 2 * d 3 * d 4) • u.x1, (qi * d 0 * d 1 * d 2 * d 3 * d 4 * d 5 * d 6 * d 7 * d 8) • u.y1, (q * d 6 * d 7 * d 8) • u.x2, (q * d 0 * d 1 * d 2) • u.y2, (q * d 0 * d 1 * d 2 * d 3 * d 4) • u.x3, (q * d 0 * d 1 * d 2 * d 3 * d 4 * d 5 * d 6 * d 7 * d 8) • u.y3⟩ := by
  simp only [ctrlV, adaptInV, adaptOutV, S8.mk.injEq]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination (norm := module) hq • ((-(d 6)*(d 7)*(d 8)*qi) • u.x0 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^3) • u.y0 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi^2) • u.x1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*qi) • u.y1 + (-(d 6)*(d 7)*(d 8)) • u.x2 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2) • u.y2 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi) • u.x3 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi) • u.y3)
  · linear_combination (norm := module) hq • ((-(d 0)*(d 1)*(d 2)*qi) • u.y0 + ((d 0)*(d 1)*(d 2)*qi) • u.x1 + (-(d 0)*(d 1)*(d 2)*qi) • u.y1 + (-(d 0)*(d 1)*(d 2)) • u.y2)
  · linear_combination (norm := module) hq • (((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi^2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*qi) • u.y0 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi^2) • u.x1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi^2) • u.y1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)) • u.y2 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)) • u.x3)
  · linear_combination (norm := module) hq • (((d 6)*(d 7)*(d 8)*qi) • u.x0 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi^2) • u.y0 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi^2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*qi) • u.x1 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^4 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*qi) • u.y1 + ((d 6)*(d 7)*(d 8)) • u.x2 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi) • u.y2 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)) • u.x3 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)) • u.y3)
  · linear_combination (norm := module) hq • (((d 6)*(d 7)*(d 8)) • u.x0 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2) • u.y0 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi) • u.x1 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^3 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)) • u.y1 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^3*qi^2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi) • u.y2 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q) • u.x3 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q) • u.y3)
  · linear_combination (norm := module) hq • (((d 0)*(d 1)*(d 2)) • u.y0 + (-(d 0)*(d 1)*(d 2)) • u.x1 + ((d 0)*(d 1)*(d 2)) • u.y1)
  · linear_combination (norm := module) hq • (((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi) • u.y0 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)) • u.x1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q*qi + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)) • u.y1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*q) • u.y2)
  · linear_combination (norm := module) hq • (((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2) • u.y0 + (-(d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2 - (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi) • u.x1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi^2 + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q*qi + (d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)) • u.y1 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q^2*qi) • u.y2 + ((d 0)*(d 1)*(d 2)*(d 3)*(d 4)*(d 5)*(d 6)*(d 7)*(d 8)*q) • u.x3)

end Module

