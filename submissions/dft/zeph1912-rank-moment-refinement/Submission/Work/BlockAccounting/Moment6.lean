import Submission.Work.BlockAccounting.Sharp

/-!
Numerical refinement, 2026-10-30. Derived from Jacob Sussman's Moment4
and Sharp lemmas retained in research/templates, under Apache-2.0.
The upper polynomial has degree six; the lower polynomial degree five.
This changes the numerical enclosure, not the underlying circuit or engine.
Generated by research/refine.py. All inequalities are checked by Lean.
-/

namespace OAI.PowerSaving.BlockAccounting
open Finset

/-- Sixth-order upper bound of `exp` on `[0,1]`. -/
lemma exp_le_sextic (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 1) :
    Real.exp x ≤ 1 + x + x^2/2 + x^3/6 + x^4/24 + x^5/120 + x^6*(7/4320) := by
  have h := Real.exp_bound' h0 h1 (n := 6) (by norm_num)
  norm_num [Finset.sum_range_succ, Nat.factorial] at h
  linarith

/-- `(r/m)^(1-ε) ≤ (r/m) (1 + x + x²/2 + x³/6 + x⁴/24 + x⁵/120 + (7/4320) x⁶)` with `x = ε L`, when `log (m/r) ≤ L`. -/
lemma rpow_ratio_le6 (r m L ε : ℝ) (hr : 0 < r) (hm : 0 < m) (hε : 0 ≤ ε) (hL0 : 0 ≤ L)
    (hL : Real.log (m/r) ≤ L) (hx : ε * L ≤ 1) :
    (r/m)^(1-ε) ≤ r/m * (1 + ε*L + (ε*L)^2/2 + (ε*L)^3/6 + (ε*L)^4/24 + (ε*L)^5/120 + (ε*L)^6*(7/4320)) := by
  have hx0 : (0:ℝ) < r/m := div_pos hr hm
  have hlog : Real.log (r/m) = - Real.log (m/r) := by
    rw [← Real.log_inv, inv_div]
  have h1 : (r/m)^(1-ε) = r/m * Real.exp (ε * Real.log (m/r)) := by
    rw [Real.rpow_def_of_pos hx0, hlog,
      show -Real.log (m/r) * (1-ε) = -Real.log (m/r) + ε * Real.log (m/r) by ring,
      Real.exp_add, ← hlog, Real.exp_log hx0]
  rw [h1]
  apply mul_le_mul_of_nonneg_left _ hx0.le
  have h2 : Real.exp (ε * Real.log (m/r)) ≤ Real.exp (ε * L) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hL hε)
  exact h2.trans (exp_le_sextic (ε*L) (mul_nonneg hε hL0) hx)

/-- Upper bound for one term of the moment at `z = 1 - ε` (sixth order; drop-in for `term_le`). -/
lemma term_le6 (m r n : ℕ) (ε L q : ℝ) (hr : 0 < r) (hm : 0 < m) (hε : 0 ≤ ε) (hL0 : 0 ≤ L)
    (hL : Real.log ((m:ℝ)/(r:ℝ)) ≤ L) (hx : ε * L ≤ 1)
    (hq : (n:ℝ) * ((r:ℝ)/(m:ℝ) * (1 + ε*L + (ε*L)^2/2 + (ε*L)^3/6 + (ε*L)^4/24 + (ε*L)^5/120 + (ε*L)^6*(7/4320))) ≤ q) :
    T m (1-ε) r n ≤ q := by
  have hr' : (0:ℝ) < (r:ℝ) := by exact_mod_cast hr
  have hm' : (0:ℝ) < (m:ℝ) := by exact_mod_cast hm
  have h := rpow_ratio_le6 (r:ℝ) (m:ℝ) L ε hr' hm' hε hL0 hL hx
  have h' : T m (1-ε) r n
      ≤ (n:ℝ) * ((r:ℝ)/(m:ℝ) * (1 + ε*L + (ε*L)^2/2 + (ε*L)^3/6 + (ε*L)^4/24 + (ε*L)^5/120 + (ε*L)^6*(7/4320))) :=
    mul_le_mul_of_nonneg_left h (by positivity)
  exact h'.trans hq

/-- Fifth-order lower bound of `exp` on `[0, ∞)`. -/
lemma quintic_le_exp (x : ℝ) (h0 : 0 ≤ x) : 1 + x + x^2/2 + x^3/6 + x^4/24 + x^5/120 ≤ Real.exp x := by
  have h := Real.sum_le_exp_of_nonneg h0 6
  norm_num [Finset.sum_range_succ, Nat.factorial] at h
  linarith

/-- `(r/m) (1 + x + x²/2 + x³/6 + x⁴/24 + x⁵/120) ≤ (r/m)^(1-ε)` with `x = ε L`, when `L ≤ log (m/r)`. -/
lemma rpow_ratio_ge5 (r m L ε : ℝ) (hr : 0 < r) (hm : 0 < m) (hε : 0 ≤ ε) (hL0 : 0 ≤ L)
    (hL : L ≤ Real.log (m/r)) :
    r/m * (1 + ε*L + (ε*L)^2/2 + (ε*L)^3/6 + (ε*L)^4/24 + (ε*L)^5/120) ≤ (r/m)^(1-ε) := by
  have hx0 : (0:ℝ) < r/m := div_pos hr hm
  have hlog : Real.log (r/m) = - Real.log (m/r) := by
    rw [← Real.log_inv, inv_div]
  have h1 : (r/m)^(1-ε) = r/m * Real.exp (ε * Real.log (m/r)) := by
    rw [Real.rpow_def_of_pos hx0, hlog,
      show -Real.log (m/r) * (1-ε) = -Real.log (m/r) + ε * Real.log (m/r) by ring,
      Real.exp_add, ← hlog, Real.exp_log hx0]
  rw [h1]
  apply mul_le_mul_of_nonneg_left _ hx0.le
  have h2 : Real.exp (ε * L) ≤ Real.exp (ε * Real.log (m/r)) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hL hε)
  exact (quintic_le_exp (ε*L) (mul_nonneg hε hL0)).trans h2

/-- Lower bound for one term of the moment at `z = 1 - ε`. -/
lemma term_ge5 (m r n : ℕ) (ε L q : ℝ) (hr : 0 < r) (hm : 0 < m) (hε : 0 ≤ ε) (hL0 : 0 ≤ L)
    (hL : L ≤ Real.log ((m:ℝ)/(r:ℝ)))
    (hq : q ≤ (n:ℝ) * ((r:ℝ)/(m:ℝ) * (1 + ε*L + (ε*L)^2/2 + (ε*L)^3/6 + (ε*L)^4/24 + (ε*L)^5/120))) :
    q ≤ T m (1-ε) r n := by
  have hr' : (0:ℝ) < (r:ℝ) := by exact_mod_cast hr
  have hm' : (0:ℝ) < (m:ℝ) := by exact_mod_cast hm
  have h := rpow_ratio_ge5 (r:ℝ) (m:ℝ) L ε hr' hm' hε hL0 hL
  have h' : (n:ℝ) * ((r:ℝ)/(m:ℝ) * (1 + ε*L + (ε*L)^2/2 + (ε*L)^3/6 + (ε*L)^4/24 + (ε*L)^5/120))
      ≤ T m (1-ε) r n :=
    mul_le_mul_of_nonneg_left h (by positivity)
  exact hq.trans h'


end OAI.PowerSaving.BlockAccounting
