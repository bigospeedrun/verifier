+/-- Big O Speedrun patch (task b1457f08): the export steps of a segmented check. The same builds and
+exports as `compareIt`, one module per call, written to a file; no comparison and no kernel here. The
+verifier runs the challenge step in its own unit before any submission build file is on the machine,
+and moves the file out of reach before the solution step. `--bos-check` then compares the two files
+and replays the solution file, so the bytes that it compares are the bytes that it checks. -/
+def exportTargets : M (Array Lean.Name) := do
+  return (← builtinTargets) ++ (← getTheoremNames) ++ (← getLegalAxioms)
+    ++ (← primitiveTargets) ++ (← getDefinitionNames)
+
+def exportChallenge (out : System.FilePath) : M Unit := do
+  let challengeModule ← getChallengeModule
+  safeLakeBuild challengeModule
+  let challengeExport ← safeExport challengeModule (← exportTargets)
+  IO.FS.writeFile out challengeExport
+  IO.println s!"BOS export: wrote challenge {challengeExport.utf8ByteSize} bytes"
+
+def exportSolution (out : System.FilePath) : M Unit := do
+  let solutionModule ← getSolutionModule
+  safeLakeBuild solutionModule
+  let solutionExport ← safeExport solutionModule (← exportTargets)
+  IO.FS.writeFile out solutionExport
+  IO.println s!"BOS export: wrote solution {solutionExport.utf8ByteSize} bytes"
+
+/-- The statement and axiom checks of `verifyMatch`, on export files. Returns the parsed solution. -/
+def compareFiles (challengePath solutionPath : System.FilePath) : M Export.ExportedEnv := do
+  let challenge ← Comparator.SegmentCheck.parseExportFile challengePath
+  let solution ← Comparator.SegmentCheck.parseExportFile solutionPath
+  let theoremNames ← getTheoremNames
+  let definitionNames ← getDefinitionNames
+  let targets := (← getTheoremNames) ++ (← getLegalAxioms)
+  IO.ofExcept <| Comparator.compareAt challenge solution targets definitionNames (← primitiveTargets)
+  IO.ofExcept <| Comparator.checkAxioms solution theoremNames definitionNames (← getLegalAxioms)
+  return solution
+
